-- RANDOM PART LOOP (R6 / R15 DİNAMİK SEÇİMİ)
-- =========================
local currentRandomPartName = "HumanoidRootPart"
task.spawn(function()
        while true do
                if getgenv().randomPart then
                        local activeTargetChar = nil
                        if lockedTarget and lockedTarget.Parent then
                                activeTargetChar = lockedTarget.Parent
                        else
                                -- Rastgele ekrandaki oyunculardan birinin parçalarını topla
                                local validChars = {}
                                for _, p in pairs(Players:GetPlayers()) do
                                        if p ~= LP and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                                                table.insert(validChars, p.Character)
                                        end
                                end
                                if #validChars > 0 then
                                        activeTargetChar = validChars[math.random(1, #validChars)]
                                end
                        end

                        if activeTargetChar then
                                local parts = {}
                                for _, part in pairs(activeTargetChar:GetChildren()) do
                                        if part:IsA("BasePart") then
                                                table.insert(parts, part.Name)
                                        end
                                end
                                if #parts > 0 then
                                        currentRandomPartName = parts[math.random(1, #parts)]
                                end
                        end
                end
                task.wait(0.5)
        end
end)


-- =========================
-- AIMBOT & TARGET LOGIC
-- =========================
local lockedTarget = nil

local function wallCheck(pos, ignore)
        if not getgenv().wc then return true end
        local rp = RaycastParams.new()
        rp.FilterDescendantsInstances = {LP.Character, ignore}
        rp.FilterType = Enum.RaycastFilterType.Blacklist
        return workspace:Raycast(Camera.CFrame.Position, pos - Camera.CFrame.Position, rp) == nil
end

local function getTargetHitPartName()
        if getgenv().randomPart then
                return currentRandomPartName
        else
                return getgenv().hitpart
        end
end

local function getTarget()
        local best, closest = nil, math.huge
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local targetPartName = getTargetHitPartName()

        for _, p in pairs(Players:GetPlayers()) do
                if p ~= LP and p.Character and p.Character:FindFirstChild(targetPartName) then
                        local skip = false
                        if getgenv().teamCheck then
                                if p.Team and getgenv().ignoredTeams[p.Team.Name] then
                                        skip = true
                                end
                        end

                        if not skip then
                                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                                if hum and hum.Health > 0 then
                                        local part = p.Character[targetPartName]
                                        local worldDist = (part.Position - Camera.CFrame.Position).Magnitude
                                        if worldDist <= getgenv().maxDistance then
                                                local screenPos, onscreen = Camera:WorldToViewportPoint(part.Position)
                                                if onscreen then
                                                        local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                                                        if not getgenv().fovEnabled or distFromCenter <= getgenv().fovSize then
                                                                if wallCheck(part.Position, p.Character) then
                                                                        if distFromCenter < closest then
                                                                                closest = distFromCenter
                                                                                best = part
                                                                        end
                                                                end
                                                        end
                                                end
                                        end
                                end
                        end
                end
        end
        return best
end

-- Tuş & Fare Dinleme (RightClick ve Manuel Mod)
local isLockKeyPressed = false

UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end

        if typeof(getgenv().lockKey) == "EnumItem" then
                if getgenv().lockKey.EnumType == Enum.UserInputType and input.UserInputType == getgenv().lockKey then
                        isLockKeyPressed = true
                elseif getgenv().lockKey.EnumType == Enum.KeyCode and input.KeyCode == getgenv().lockKey then
                        isLockKeyPressed = true
                end
        end

        if input.KeyCode == Enum.KeyCode.X then
                getgenv().noclip = not getgenv().noclip
        end

        if input.KeyCode == Enum.KeyCode.Z then
                getgenv().floatEnabled = not getgenv().floatEnabled
        end

        if getgenv().clickTpEnabled and input.KeyCode == Enum.KeyCode.T then
                local char = LP.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                        local hrp = char.HumanoidRootPart
                        local targetPos = Mouse.Hit.Position + Vector3.new(0, 3, 0)
                        if (targetPos - hrp.Position).Magnitude <= 300 then
                                hrp.CFrame = CFrame.new(targetPos)
                        end
                end
        end
end)

UserInputService.InputEnded:Connect(function(input)
        if typeof(getgenv().lockKey) == "EnumItem" then
                if getgenv().lockKey.EnumType == Enum.UserInputType and input.UserInputType == getgenv().lockKey then
                        isLockKeyPressed = false
                elseif getgenv().lockKey.EnumType == Enum.KeyCode and input.KeyCode == getgenv().lockKey then
                        isLockKeyPressed = false
                end
        end
end)


-- =========================
-- OPTIMIZED MAIN LOOP
-- =========================
local floatPart = nil
local frameCounter = 0

RunService.RenderStepped:Connect(function()
        -- FOV Güncelleme
        circle.Visible = getgenv().fovEnabled
        if getgenv().fovEnabled then
                circle.Radius = getgenv().fovSize
                circle.Color = getgenv().fovColor
                circle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        end

        -- ESP ve Highlight Güncelleme Throttle (CPU Optimizasyonu)
        frameCounter = frameCounter + 1
        if frameCounter >= 3 then
                frameCounter = 0
                for player, data in pairs(espCache) do
                        local charValid = data.character and data.character.Parent and data.character:FindFirstChild("Head")

                        if data.billboard then
                                local shouldShowESP = getgenv().espEnabled and charValid
                                if data.billboard.Enabled ~= shouldShowESP then
                                        data.billboard.Enabled = shouldShowESP
                                end
                                if shouldShowESP then
                                        if getgenv().useTeamColor and player.Team then
                                                data.textLabel.TextColor3 = player.TeamColor.Color
                                        else
                                                data.textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                                        end
                                end
                        end

                        if data.highlight then
                                local shouldShowHighlight = getgenv().highlightEnabled and charValid
                                if data.highlight.Enabled ~= shouldShowHighlight then
                                        data.highlight.Enabled = shouldShowHighlight
                                end
                                if shouldShowHighlight then
                                        if getgenv().useTeamColor and player.Team then
                                                data.highlight.FillColor = player.TeamColor.Color
                                                data.highlight.OutlineColor = player.TeamColor.Color
                                        else
                                                data.highlight.FillColor = Color3.fromRGB(255, 255, 255)
                                                data.highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                                        end
                                end
                        end
                end
        end

        -- Noclip Uygulaması
        if getgenv().noclip and LP.Character then
                for _, part in pairs(LP.Character:GetDescendants()) do
                        if part:IsA("BasePart") then
                                part.CanCollide = false
                        end
                end
        end

        -- Float Platform Uygulaması
        if getgenv().floatEnabled and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = LP.Character.HumanoidRootPart
                if not floatPart or not floatPart.Parent then
                        floatPart = Instance.new("Part")
                        floatPart.Name = "FloatPlatform"
                        floatPart.Size = Vector3.new(3, 0.6, 3)
                        floatPart.Transparency = 1
                        floatPart.Anchored = true
                        floatPart.CanCollide = true
                        floatPart.Parent = workspace
                end
                floatPart.CFrame = hrp.CFrame - Vector3.new(0, 3.5, 0)
        else
                if floatPart then
                        floatPart:Destroy()
                        floatPart = nil
                end
        end

        -- Aimbot Mantığı
        if not getgenv().aimbot then return end

        local t = nil
        if getgenv().aimbotType == "OtoLock" then
                t = getTarget()
        elseif getgenv().aimbotType == "Manuel" then
                if isLockKeyPressed then
                        if not lockedTarget or not lockedTarget.Parent or lockedTarget.Parent.Humanoid.Health <= 0 then
                                lockedTarget = getTarget()
                        end
                        t = lockedTarget
                else
                        lockedTarget = nil
                end
        end

        if t then
                local vel = t.AssemblyLinearVelocity or Vector3.zero
                local aimPos = t.Position + (vel * getgenv().pred)
                local targetCFrame = CFrame.new(Camera.CFrame.Position, aimPos)

                if getgenv().smoothingEnabled then
                        Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, math.clamp(getgenv().smoothness, 0.01, 1))
                else
                        Camera.CFrame = targetCFrame
                end
        end
end)
