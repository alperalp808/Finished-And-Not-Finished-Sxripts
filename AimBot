-- Draggable Logic for Mobile Button
local dragging, dragInput, dragStart, startPos
explosiveMobBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = explosiveMobBtn.Position
                input.Changed:Connect(function()
                        if input.UserInputState == Enum.UserInputState.End then
                                dragging = false
                        end
                end)
        end
end)

explosiveMobBtn.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
        end
end)

UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
                local delta = input.Position - dragStart
                explosiveMobBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
end)

explosiveMobBtn.MouseButton1Click:Connect(function()
        getgenv().explosiveMode = not getgenv().explosiveMode
        exStroke.Color = getgenv().explosiveMode and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(255, 50, 50)
        explosiveMobBtn.TextColor3 = getgenv().explosiveMode and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(255, 70, 70)
end)


