-- ESP & HIGHLIGHT MANAGER (DÜZELTİLDİ)
-- =========================
local espCache = {}

local function applyESPToCharacter(player, char)
        if espCache[player] then
                if espCache[player].billboard then espCache[player].billboard:Destroy() end
                if espCache[player].highlight then espCache[player].highlight:Destroy() end
                espCache[player] = nil
        end

        local head = char:WaitForChild("Head", 5)
        if not head then return end

        local bb = Instance.new("BillboardGui")
        bb.Name = "MobileNameESP"
        bb.Size = UDim2.new(0, 100, 0, 40)
        bb.StudsOffset = Vector3.new(0, 2.5, 0)
        bb.AlwaysOnTop = true
        bb.Adornee = head
        bb.Parent = char

        local txt = Instance.new("TextLabel")
        txt.Size = UDim2.new(1, 0, 1, 0)
        txt.BackgroundTransparency = 1
        txt.Text = player.Name
        txt.TextColor3 = Color3.new(1, 1, 1)
        txt.TextSize = 15
        txt.Font = Enum.Font.GothamBold
        txt.TextStrokeTransparency = 0.3
        txt.Parent = bb

        local hl = Instance.new("Highlight")
        hl.Name = "MobileHighlight"
        hl.Adornee = char
        hl.Enabled = false
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        hl.Parent = char

        espCache[player] = {billboard = bb, textLabel = txt, highlight = hl, character = char}
end

local function setupESP(player)
        if player == LP then return end

        player.CharacterRemoving:Connect(function()
                if espCache[player] then
                        if espCache[player].billboard then espCache[player].billboard:Destroy() end
                        if espCache[player].highlight then espCache[player].highlight:Destroy() end
                        espCache[player] = nil
                end
        end)

        player.CharacterAdded:Connect(function(char)
                applyESPToCharacter(player, char)
        end)

        if player.Character then
                applyESPToCharacter(player, player.Character)
        end
end

for _, p in pairs(Players:GetPlayers()) do
        setupESP(p)
end
Players.PlayerAdded:Connect(setupESP)
Players.PlayerRemoving:Connect(function(p)
        if espCache[p] then
                if espCache[p].billboard then espCache[p].billboard:Destroy() end
                if espCache[p].highlight then espCache[p].highlight:Destroy() end
                espCache[p] = nil
        end
end)


-- =========================
-- AIMBOT & TARGET LOGIC
-- =========================
local lockedTarget = nil

local function wallCheck(pos, ignore)
        if not getgenv().wc then return true end
        local rp = RaycastParams.new()
        rp.FilterDescendantsInstances = {LP.Character, ignore}
        rp.FilterType = Enum.RaycastFilterType.Blacklist
        return workspace:Raycast(Camera.CFrame.Position, pos - Camera.CFrame.Position, rp) == nil
end

local function getTarget()
        local best, closest = nil, math.huge
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

        for _, p in pairs(Players:GetPlayers()) do
                if p ~= LP and p.Character and p.Character:FindFirstChild(getgenv().hitpart) then
                        local skip = false
                        if getgenv().teamCheck then
                                if p.Team and getgenv().ignoredTeams[p.Team.Name] then
                                        skip = true
                                end
                        end

                        if not skip then
                                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                                if hum and hum.Health > 0 then
                                        local part = p.Character[getgenv().hitpart]
                                        local worldDist = (part.Position - Camera.CFrame.Position).Magnitude
                                        if worldDist <= getgenv().maxDistance then
                                                local screenPos, onscreen = Camera:WorldToViewportPoint(part.Position)
                                                if onscreen then
                                                        local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                                                        if not getgenv().fovEnabled or distFromCenter <= getgenv().fovSize then
                                                                if wallCheck(part.Position, p.Character) then
                                                                        if distFromCenter < closest then
                                                                                closest = distFromCenter
                                                                                best = part
                                                                        end
                                                                end
                                                        end
                                                end
                                        end
                                end
                        end
                end
        end
        return best
end

-- Tuş Dinleme (Manuel Mod Kilit Açma/Kapama & Diğer Tuşlar)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end

        if getgenv().aimbotType == "Manuel" and input.KeyCode == getgenv().lockKey then
                if not lockedTarget then
                        lockedTarget = getTarget()
                else
                        lockedTarget = nil
                end
        end

        if input.KeyCode == Enum.KeyCode.X then
                getgenv().noclip = not getgenv().noclip
        end

        if input.KeyCode == Enum.KeyCode.Z then
                getgenv().floatEnabled = not getgenv().floatEnabled
        end

        if getgenv().clickTpEnabled and input.KeyCode == Enum.KeyCode.T then
                local char = LP.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                        local hrp = char.HumanoidRootPart
                        local targetPos = Mouse.Hit.Position + Vector3.new(0, 3, 0)
                        if (targetPos - hrp.Position).Magnitude <= 300 then
                                hrp.CFrame = CFrame.new(targetPos)
                        end
                end
        end
end)


