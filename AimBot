local function createToggle(parent, text, y, callback)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, 0, 0, 36)
        b.Position = UDim2.new(0, 0, 0, y)
        b.Text = "  "..text
        b.BackgroundColor3 = Color3.fromRGB(26, 26, 36)
        b.TextColor3 = Color3.fromRGB(200, 200, 210)
        b.Font = Enum.Font.GothamMedium
        b.TextSize = 13
        b.TextXAlignment = Enum.TextXAlignment.Left
        b.ZIndex = 6
        b.Parent = parent
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)

        local indicator = Instance.new("Frame")
        indicator.Size = UDim2.new(0, 12, 0, 12)
        indicator.Position = UDim2.new(1, -26, 0.5, -6)
        indicator.BackgroundColor3 = Color3.fromRGB(70, 70, 85)
        indicator.ZIndex = 7
        indicator.Parent = b
        Instance.new("UICorner", indicator).CornerRadius = UDim.new(1, 0)

        local s = false
        b.MouseButton1Click:Connect(function()
                s = not s
                local targetColor = s and Color3.fromRGB(65, 220, 95) or Color3.fromRGB(70, 70, 85)
                local btnBg = s and Color3.fromRGB(32, 45, 35) or Color3.fromRGB(26, 26, 36)
                
                TweenService:Create(indicator, TweenInfo.new(0.2), {BackgroundColor3 = targetColor}):Play()
                TweenService:Create(b, TweenInfo.new(0.2), {BackgroundColor3 = btnBg}):Play()
                callback(s)
        end)
end

local function createTextbox(parent, y, default, callback)
        local t = Instance.new("TextBox")
        t.Size = UDim2.new(1, 0, 0, 36)
        t.Position = UDim2.new(0, 0, 0, y)
        t.Text = tostring(default)
        t.BackgroundColor3 = Color3.fromRGB(26, 26, 36)
        t.TextColor3 = Color3.fromRGB(255, 255, 255)
        t.Font = Enum.Font.GothamMedium
        t.TextSize = 13
        t.ClearTextOnFocus = false
        t.ZIndex = 6
        t.Parent = parent
        Instance.new("UICorner", t).CornerRadius = UDim.new(0, 8)

        t.FocusLost:Connect(function()
                callback(t.Text)
        end)
end

local function createListDropdown(parent, titleText, y, options, callback)
        createLabel(parent, titleText, y)

        local mainBtn = Instance.new("TextButton")
        mainBtn.Size = UDim2.new(1, 0, 0, 36)
        mainBtn.Position = UDim2.new(0, 0, 0, y + 24)
        mainBtn.BackgroundColor3 = Color3.fromRGB(26, 26, 36)
        mainBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
        mainBtn.Font = Enum.Font.GothamMedium
        mainBtn.TextSize = 13
        mainBtn.TextXAlignment = Enum.TextXAlignment.Left
        mainBtn.Text = "  Select... ▾"
        mainBtn.ZIndex = 6
        mainBtn.Parent = parent
        Instance.new("UICorner", mainBtn).CornerRadius = UDim.new(0, 8)

        local listFrame = Instance.new("ScrollingFrame")
        listFrame.Size = UDim2.new(1, 0, 0, 0)
        listFrame.Position = UDim2.new(0, 0, 0, y + 64)
        listFrame.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
        listFrame.BorderSizePixel = 0
        listFrame.Visible = false
        listFrame.ZIndex = 10
        listFrame.CanvasSize = UDim2.new(0, 0, 0, #options * 32)
        listFrame.ScrollBarThickness = 3
        listFrame.Parent = parent
        Instance.new("UICorner", listFrame).CornerRadius = UDim.new(0, 8)

        local isOpen = false

        mainBtn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                listFrame.Visible = isOpen
                listFrame.Size = isOpen and UDim2.new(1, 0, 0, math.min(#options * 32, 130)) or UDim2.new(1, 0, 0, 0)
        end)

        for i, opt in ipairs(options) do
                local optBtn = Instance.new("TextButton")
                optBtn.Size = UDim2.new(1, -6, 0, 30)
                optBtn.Position = UDim2.new(0, 3, 0, (i - 1) * 32 + 2)
                optBtn.BackgroundColor3 = Color3.fromRGB(32, 32, 42)
                optBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
                optBtn.Font = Enum.Font.Gotham
                optBtn.TextSize = 12
                optBtn.Text = "  "..tostring(opt)
                optBtn.TextXAlignment = Enum.TextXAlignment.Left
                optBtn.ZIndex = 11
                optBtn.Parent = listFrame
                Instance.new("UICorner", optBtn).CornerRadius = UDim.new(0, 6)

                optBtn.MouseButton1Click:Connect(function()
                        mainBtn.Text = "  "..tostring(opt).." ▾"
                        isOpen = false
                        listFrame.Visible = false
                        callback(opt)
                end)
        end

        return y + 68
end


