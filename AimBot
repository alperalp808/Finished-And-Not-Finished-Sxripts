local function createLabel(parent, text, y)
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1, 0, 0, 22)
        l.Position = UDim2.new(0, 0, 0, y)
        l.Text = text
        l.TextColor3 = Color3.fromRGB(180, 180, 190)
        l.BackgroundTransparency = 1
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.Font = Enum.Font.GothamMedium
        l.TextSize = 12
        l.Parent = parent
end

local function createToggle(parent, text, y, callback)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, 0, 0, 34)
        b.Position = UDim2.new(0, 0, 0, y)
        b.Text = "  "..text.." : OFF"
        b.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
        b.TextColor3 = Color3.fromRGB(220, 220, 220)
        b.Font = Enum.Font.Gotham
        b.TextSize = 13
        b.TextXAlignment = Enum.TextXAlignment.Left
        b.Parent = parent
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)

        local s = false
        b.MouseButton1Click:Connect(function()
                s = not s
                b.Text = "  "..text.." : "..(s and "ON" or "OFF")
                b.BackgroundColor3 = s and Color3.fromRGB(45, 75, 45) or Color3.fromRGB(30, 30, 40)
                callback(s)
        end)
end

local function createTextbox(parent, y, default, callback)
        local t = Instance.new("TextBox")
        t.Size = UDim2.new(1, 0, 0, 34)
        t.Position = UDim2.new(0, 0, 0, y)
        t.Text = tostring(default)
        t.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
        t.TextColor3 = Color3.fromRGB(255, 255, 255)
        t.Font = Enum.Font.Gotham
        t.TextSize = 13
        t.ClearTextOnFocus = false
        t.Parent = parent
        Instance.new("UICorner", t).CornerRadius = UDim.new(0, 6)

        t.FocusLost:Connect(function()
                callback(t.Text)
        end)
end

local function createListDropdown(parent, titleText, y, options, callback)
        createLabel(parent, titleText, y)

        local mainBtn = Instance.new("TextButton")
        mainBtn.Size = UDim2.new(1, 0, 0, 34)
        mainBtn.Position = UDim2.new(0, 0, 0, y + 26)
        mainBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
        mainBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
        mainBtn.Font = Enum.Font.Gotham
        mainBtn.TextSize = 13
        mainBtn.TextXAlignment = Enum.TextXAlignment.Left
        mainBtn.Text = "  Seçiniz... ▾"
        mainBtn.Parent = parent
        Instance.new("UICorner", mainBtn).CornerRadius = UDim.new(0, 6)

        local listFrame = Instance.new("ScrollingFrame")
        listFrame.Size = UDim2.new(1, 0, 0, 0)
        listFrame.Position = UDim2.new(0, 0, 0, y + 62)
        listFrame.BackgroundColor3 = Color3.fromRGB(24, 24, 32)
        listFrame.BorderSizePixel = 0
        listFrame.Visible = false
        listFrame.ZIndex = 5
        listFrame.CanvasSize = UDim2.new(0, 0, 0, #options * 30)
        listFrame.ScrollBarThickness = 3
        listFrame.Parent = parent
        Instance.new("UICorner", listFrame).CornerRadius = UDim.new(0, 6)

        local isOpen = false

        mainBtn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                listFrame.Visible = isOpen
                listFrame.Size = isOpen and UDim2.new(1, 0, 0, math.min(#options * 30, 120)) or UDim2.new(1, 0, 0, 0)
        end)

        for i, opt in ipairs(options) do
                local optBtn = Instance.new("TextButton")
                optBtn.Size = UDim2.new(1, -4, 0, 28)
                optBtn.Position = UDim2.new(0, 2, 0, (i - 1) * 30 + 2)
                optBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
                optBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
                optBtn.Font = Enum.Font.Gotham
                optBtn.TextSize = 12
                optBtn.Text = "  "..tostring(opt)
                optBtn.TextXAlignment = Enum.TextXAlignment.Left
                optBtn.ZIndex = 6
                optBtn.Parent = listFrame
                Instance.new("UICorner", optBtn).CornerRadius = UDim.new(0, 4)

                optBtn.MouseButton1Click:Connect(function()
                        mainBtn.Text = "  "..tostring(opt).." ▾"
                        isOpen = false
                        listFrame.Visible = false
                        callback(opt)
                end)
        end

        return y + 66
end


