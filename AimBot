local currentRandomPartName = "HumanoidRootPart"

local function isPartVisible(part, character)
        local rp = RaycastParams.new()
        rp.FilterDescendantsInstances = {LP.Character, character}
        rp.FilterType = Enum.RaycastFilterType.Blacklist
        local result = workspace:Raycast(Camera.CFrame.Position, part.Position - Camera.CFrame.Position, rp)
        return result == nil
end

task.spawn(function()
        while true do
                if getgenv().randomPart then
                        local activeTargetChar = nil
                        if lockedTarget and lockedTarget.Parent then
                                activeTargetChar = lockedTarget.Parent
                        else
                                local validChars = {}
                                for _, p in pairs(Players:GetPlayers()) do
                                        if p ~= LP and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                                                table.insert(validChars, p.Character)
                                        end
                                end
                                if #validChars > 0 then activeTargetChar = validChars[math.random(1, #validChars)] end
                        end

                        if activeTargetChar then
                                local parts = {}
                                for _, part in pairs(activeTargetChar:GetChildren()) do
                                        if part:IsA("BasePart") then
                                                if getgenv().visiblePartCheck then
                                                        if isPartVisible(part, activeTargetChar) then
                                                                table.insert(parts, part.Name)
                                                        end
                                                else
                                                        table.insert(parts, part.Name)
                                                end
                                        end
                                end
                                if #parts > 0 then
                                        currentRandomPartName = parts[math.random(1, #parts)]
                                else
                                        currentRandomPartName = "HumanoidRootPart"
                                end
                        end
                end
                task.wait(0.5)
        end
end)


-- =========================
-- AIMBOT & TARGET LOGIC
-- =========================
local lockedTarget = nil

local function wallCheck(pos, ignore)
        if not getgenv().wc then return true end
        local rp = RaycastParams.new()
        rp.FilterDescendantsInstances = {LP.Character, ignore}
        rp.FilterType = Enum.RaycastFilterType.Blacklist
        return workspace:Raycast(Camera.CFrame.Position, pos - Camera.CFrame.Position, rp) == nil
end

local function getTargetHitPartName()
        if getgenv().explosiveMode then return "HumanoidRootPart"
        elseif getgenv().randomPart then return currentRandomPartName
        else return getgenv().hitpart end
end

local function isValidTarget(part)
        if not part or not part.Parent then return false end
        local model = part.Parent
        local hum = model:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        return true
end

local function getTarget()
        if getgenv().antiVehicle and LP.Character then
                local lpHum = LP.Character:FindFirstChildOfClass("Humanoid")
                if lpHum and lpHum.Sit then
                        return nil
                end
        end

        local best, closest = nil, math.huge
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local targetPartName = getTargetHitPartName()

        for _, p in pairs(Players:GetPlayers()) do
                if p ~= LP and p.Character and p.Character:FindFirstChild(targetPartName) then
                        local hum = p.Character:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health > 0 then
                                local skipTeam = getgenv().teamCheck and p.Team and getgenv().ignoredTeams[p.Team.Name]
                                if not skipTeam then
                                        local part = p.Character[targetPartName]
                                        if (part.Position - Camera.CFrame.Position).Magnitude <= getgenv().maxDistance then
                                                local screenPos, onscreen = Camera:WorldToViewportPoint(part.Position)
                                                if onscreen then
                                                        local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                                                        if not getgenv().fovEnabled or distFromCenter <= getgenv().fovSize then
                                                                if wallCheck(part.Position, p.Character) and distFromCenter < closest then
                                                                        closest = distFromCenter
                                                                        best = part
                                                                end
                                                        end
                                                end
                                        end
                                end
                        end
                end
        end

        if getgenv().lockNpc then
                for _, model in pairs(workspace:GetChildren()) do
                        if model:IsA("Model") and model ~= LP.Character and not Players:GetPlayerFromCharacter(model) then
                                local hum = model:FindFirstChildOfClass("Humanoid")
                                local part = model:FindFirstChild(targetPartName)
                                if hum and hum.Health > 0 and part then
                                        if (part.Position - Camera.CFrame.Position).Magnitude <= getgenv().maxDistance then
                                                local screenPos, onscreen = Camera:WorldToViewportPoint(part.Position)
                                                if onscreen then
                                                        local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                                                        if not getgenv().fovEnabled or distFromCenter <= getgenv().fovSize then
                                                                if wallCheck(part.Position, model) and distFromCenter < closest then
                                                                        closest = distFromCenter
                                                                        best = part
                                                                end
                                                        end
                                                end
                                        end
                                end
                        end
                end
        end
        return best
end

local isLockKeyPressed = false
UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if typeof(getgenv().lockKey) == "EnumItem" then
                if (getgenv().lockKey.EnumType == Enum.UserInputType and input.UserInputType == getgenv().lockKey) or
                   (getgenv().lockKey.EnumType == Enum.KeyCode and input.KeyCode == getgenv().lockKey) then
                        isLockKeyPressed = true
                        if getgenv().aimbotType == "Manuel" and getgenv().manualModeType == "Toggle" then
                                if lockedTarget then
                                        lockedTarget = nil
                                else
                                        lockedTarget = getTarget()
                                end
                        end
                end
        end
        if input.KeyCode == getgenv().explosiveKey then
                getgenv().explosiveMode = not getgenv().explosiveMode
                exStroke.Color = getgenv().explosiveMode and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(255, 50, 50)
                explosiveMobBtn.TextColor3 = getgenv().explosiveMode and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(255, 70, 70)
        end
        if input.KeyCode == Enum.KeyCode.X then getgenv().noclip = not getgenv().noclip end
        if input.KeyCode == Enum.KeyCode.Z then getgenv().floatEnabled = not getgenv().floatEnabled end
        if getgenv().clickTpEnabled and input.KeyCode == Enum.KeyCode.T then
                local char = LP.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                        local targetPos = Mouse.Hit.Position + Vector3.new(0, 3, 0)
                        if (targetPos - char.HumanoidRootPart.Position).Magnitude <= 300 then
                                char.HumanoidRootPart.CFrame = CFrame.new(targetPos)
                        end
                end
        end
end)

UserInputService.InputEnded:Connect(function(input)
        if typeof(getgenv().lockKey) == "EnumItem" then
                if (getgenv().lockKey.EnumType == Enum.UserInputType and input.UserInputType == getgenv().lockKey) or
                   (getgenv().lockKey.EnumType == Enum.KeyCode and input.KeyCode == getgenv().lockKey) then
                        isLockKeyPressed = false
                end
        end
end)


-- =========================
-- MAIN LOOP
-- =========================
local floatPart = nil
local frameCounter = 0

RunService.RenderStepped:Connect(function()
        circle.Visible = getgenv().fovEnabled
        if getgenv().fovEnabled then
                circle.Radius = getgenv().fovSize
                circle.Color = getgenv().fovColor
                circle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        end

        frameCounter = frameCounter + 1
        if frameCounter >= 3 then
                frameCounter = 0
                for player, data in pairs(espCache) do
                        local charValid = data.character and data.character.Parent and data.character:FindFirstChild("Head")
                        if data.billboard then
                                local show = getgenv().espEnabled and charValid
                                if data.billboard.Enabled ~= show then data.billboard.Enabled = show end
                                if show then
                                        data.textLabel.TextColor3 = (getgenv().useTeamColor and player.Team) and player.TeamColor.Color or Color3.fromRGB(255, 255, 255)
                                end
                        end
                        if data.highlight then
                                local show = getgenv().highlightEnabled and charValid
                                if data.highlight.Enabled ~= show then data.highlight.Enabled = show end
                                if show and getgenv().useTeamColor and player.Team then
                                        data.highlight.FillColor = player.TeamColor.Color
                                        data.highlight.OutlineColor = player.TeamColor.Color
                                end
                        end
                end
        end

        if getgenv().noclip and LP.Character then
                for _, part in pairs(LP.Character:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                end
        end

        if getgenv().floatEnabled and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                if not floatPart or not floatPart.Parent then
                        floatPart = Instance.new("Part")
                        floatPart.Name = "FloatPlatform"
                        floatPart.Size = Vector3.new(3, 0.6, 3)
                        floatPart.Transparency = 1
                        floatPart.Anchored = true
                        floatPart.CanCollide = true
                        floatPart.Parent = workspace
                end
                floatPart.CFrame = LP.Character.HumanoidRootPart.CFrame - Vector3.new(0, 3.5, 0)
        else
                if floatPart then floatPart:Destroy(); floatPart = nil end
        end

        if not getgenv().aimbot then return end

        local t = nil
        if getgenv().aimbotType == "OtoLock" then
                t = getTarget()
        elseif getgenv().aimbotType == "Manuel" then
                if getgenv().manualModeType == "Hold" then
                        if isLockKeyPressed then
                                if not lockedTarget or not isValidTarget(lockedTarget) then
                                        lockedTarget = getTarget()
                                end
                                t = lockedTarget
                        else
                                lockedTarget = nil
                        end
                else -- Toggle Mode
                        if lockedTarget and not isValidTarget(lockedTarget) then
                                lockedTarget = nil
                        end
                        t = lockedTarget
                end
        end

        if t then
                local targetPos = t.Position
                local currentPred = getgenv().pred
                if getgenv().explosiveMode then
                        targetPos = targetPos - Vector3.new(0, getgenv().explosiveStuds, 0)
                        currentPred = getgenv().explosivePred
                end

                local vel = t.AssemblyLinearVelocity or Vector3.zero
                local aimPos = targetPos + (vel * currentPred)
                local targetCFrame = CFrame.new(Camera.CFrame.Position, aimPos)

                if getgenv().smoothingEnabled then
                        Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, math.clamp(getgenv().smoothness, 0.01, 1))
                else
                        Camera.CFrame = targetCFrame
                end
        else
                if getgenv().aimbotType == "Manuel" and getgenv().manualModeType == "Hold" and not isLockKeyPressed then
                        lockedTarget = nil
                end
        end
end)
