-- Seçilen Animasyon Kimlikleri
local CURRENT_ANIMS = {
    idle1 = "Seçilmedi",
    idle2 = "Seçilmedi",
    walk  = "Seçilmedi",
    run   = "Seçilmedi",
    jump  = "Seçilmedi",
    fall  = "Seçilmedi",
    climb = "Seçilmedi"
}

-- Her Bir Animasyon Kategorisi İçin Bağımsız Aç/Kapat Durumu (True = Özel, False = Orijinal)
local TOGGLE_STATES = {
    idle1 = true,
    idle2 = true,
    walk  = true,
    run   = true,
    jump  = true,
    fall  = true,
    climb = true
}

-- Orijinal Animasyonları Saklama
local function saveOriginalAnimations(character)
    local animateScript = character:WaitForChild("Animate", 5)
    if animateScript and not isOriginalSaved then
        ORIGINAL_ANIMS = {
            idle1 = (animateScript:FindFirstChild("idle") and animateScript.idle:FindFirstChild("Animation1")) and animateScript.idle.Animation1.AnimationId or "",
            idle2 = (animateScript:FindFirstChild("idle") and animateScript.idle:FindFirstChild("Animation2")) and animateScript.idle.Animation2.AnimationId or "",
            walk  = (animateScript:FindFirstChild("walk") and animateScript.walk:FindFirstChild("WalkAnim")) and animateScript.walk.WalkAnim.AnimationId or "",
            run   = (animateScript:FindFirstChild("run") and animateScript.run:FindFirstChild("RunAnim")) and animateScript.run.RunAnim.AnimationId or "",
            jump  = (animateScript:FindFirstChild("jump") and animateScript.jump:FindFirstChild("JumpAnim")) and animateScript.jump.JumpAnim.AnimationId or "",
            fall  = (animateScript:FindFirstChild("fall") and animateScript.fall:FindFirstChild("FallAnim")) and animateScript.fall.FallAnim.AnimationId or "",
            climb = (animateScript:FindFirstChild("climb") and animateScript.climb:FindFirstChild("ClimbAnim")) and animateScript.climb.ClimbAnim.AnimationId or ""
        }
        isOriginalSaved = true
    end
end

-- [[ ANIMASYON UYGULAMA VE SIFIRLAMA MOTORU ]] --
local function stopPlayingAnimations(humanoid)
    if humanoid then
        for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
            track:Stop()
        end
    end
end

local function applyAnimations(animTable)
    local character = LocalPlayer.Character
    if not character then return end
    local animateScript = character:WaitForChild("Animate", 5)
    local humanoid = character:WaitForChild("Humanoid", 5)
    
    if animateScript and humanoid then
        animateScript.Disabled = true
        stopPlayingAnimations(humanoid)
        
        -- Her kategori için kendi Toggle butonu açık (true) ise seçileni, kapalı (false) ise orijinali yükler
        local function getTargetAnim(key)
            if not TOGGLE_STATES[key] then
                return ORIGINAL_ANIMS[key] or ""
            end
            return (animTable[key] == "Seçilmedi") and ORIGINAL_ANIMS[key] or animTable[key]
        end

        local target_idle1 = getTargetAnim("idle1")
        local target_idle2 = getTargetAnim("idle2")
        local target_walk  = getTargetAnim("walk")
        local target_run   = getTargetAnim("run")
        local target_jump  = getTargetAnim("jump")
        local target_fall  = getTargetAnim("fall")
        local target_climb = getTargetAnim("climb")

        if animateScript:FindFirstChild("idle") then
            if animateScript.idle:FindFirstChild("Animation1") then animateScript.idle.Animation1.AnimationId = target_idle1 end
            if animateScript.idle:FindFirstChild("Animation2") then animateScript.idle.Animation2.AnimationId = target_idle2 end
        end
        if animateScript:FindFirstChild("walk") and animateScript.walk:FindFirstChild("WalkAnim") then 
            animateScript.walk.WalkAnim.AnimationId = target_walk 
        end
        if animateScript:FindFirstChild("run") and animateScript.run:FindFirstChild("RunAnim") then 
            animateScript.run.RunAnim.AnimationId = target_run 
        end
        if animateScript:FindFirstChild("jump") and animateScript.jump:FindFirstChild("JumpAnim") then 
            animateScript.jump.JumpAnim.AnimationId = target_jump 
        end
        if animateScript:FindFirstChild("fall") and animateScript.fall:FindFirstChild("FallAnim") then 
            animateScript.fall.FallAnim.AnimationId = target_fall 
        end
        if animateScript:FindFirstChild("climb") and animateScript.climb:FindFirstChild("ClimbAnim") then 
            animateScript.climb.ClimbAnim.AnimationId = target_climb
        end
        
        animateScript.Disabled = false
    end
end

LocalPlayer.CharacterAdded:Connect(function(char)
    isOriginalSaved = false
    task.wait(0.5)
    saveOriginalAnimations(char)
    if getgenv().ChangeAnim then
        applyAnimations(CURRENT_ANIMS)
    end
end)

if LocalPlayer.Character then
    task.spawn(function()
        saveOriginalAnimations(LocalPlayer.Character)
    end)
end

