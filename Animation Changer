-- [[ HER ANİMASYON İÇİN BİREYSEL TOGGLE VE DROPDOWN OLUŞTURUCU ]] --
local openDropdown = nil
local function createDropdown(labelName, animTypeKey)
    local WrapperFrame = Instance.new("Frame")
    WrapperFrame.Size = UDim2.new(1, 0, 0, 40)
    WrapperFrame.BackgroundTransparency = 1
    WrapperFrame.Parent = Container

    -- Dropdown Menüsü (Sol tarafta yer alır)
    local DropdownFrame = Instance.new("Frame")
    DropdownFrame.Size = UDim2.new(1, -55, 0, 40)
    DropdownFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    DropdownFrame.BackgroundTransparency = 0.3
    DropdownFrame.ClipsDescendants = true
    DropdownFrame.Parent = WrapperFrame
    Instance.new("UICorner", DropdownFrame).CornerRadius = UDim.new(0, 6)

    local HeaderBtn = Instance.new("TextButton")
    HeaderBtn.Size = UDim2.new(1, 0, 0, 40)
    HeaderBtn.BackgroundTransparency = 1
    HeaderBtn.Text = "  " .. labelName .. " : Seçilmedi"
    HeaderBtn.TextColor3 = Color3.fromRGB(235, 235, 235)
    HeaderBtn.Font = Enum.Font.Gotham
    HeaderBtn.TextSize = 12
    HeaderBtn.TextXAlignment = Enum.TextXAlignment.Left
    HeaderBtn.Parent = DropdownFrame

    -- Her Animasyona Özel Ayrı Aç/Kapa (Toggle) Butonu (Sağ tarafta yer alır)
    local SubToggle = Instance.new("TextButton")
    SubToggle.Size = UDim2.new(0, 48, 0, 24)
    SubToggle.Position = UDim2.new(1, -48, 0, 8)
    SubToggle.BackgroundColor3 = Color3.fromRGB(46, 204, 113) -- Başlangıçta AÇIK
    SubToggle.Text = "ON"
    SubToggle.TextColor3 = Color3.fromRGB(255, 255, 255)
    SubToggle.Font = Enum.Font.GothamBold
    SubToggle.TextSize = 10
    SubToggle.Parent = WrapperFrame
    Instance.new("UICorner", SubToggle).CornerRadius = UDim.new(0, 6)

    SubToggle.MouseButton1Click:Connect(function()
        TOGGLE_STATES[animTypeKey] = not TOGGLE_STATES[animTypeKey]
        local isAnimOn = TOGGLE_STATES[animTypeKey]
        
        if isAnimOn then
            SubToggle.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
            SubToggle.Text = "ON"
        else
            SubToggle.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
            SubToggle.Text = "OFF"
        end
        
        if getgenv().ChangeAnim then
            applyAnimations(CURRENT_ANIMS)
        end
    end)

    -- Dropdown İçi Arama Çubuğu
    local SearchBox = Instance.new("TextBox")
    SearchBox.Size = UDim2.new(1, -16, 0, 28)
    SearchBox.Position = UDim2.new(0, 8, 0, 45)
    SearchBox.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
    SearchBox.PlaceholderText = "Ara..."
    SearchBox.Text = ""
    SearchBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    SearchBox.PlaceholderColor3 = Color3.fromRGB(140, 140, 140)
    SearchBox.Font = Enum.Font.Gotham
    SearchBox.TextSize = 12
    SearchBox.Visible = false
    SearchBox.Parent = DropdownFrame
    Instance.new("UICorner", SearchBox).CornerRadius = UDim.new(0, 4)

    -- Liste Konteyneri
    local ListContainer = Instance.new("ScrollingFrame")
    ListContainer.Size = UDim2.new(1, 0, 0, 0)
    ListContainer.Position = UDim2.new(0, 0, 0, 80)
    ListContainer.BackgroundTransparency = 1
    ListContainer.BorderSizePixel = 0
    ListContainer.ScrollBarThickness = 4
    ListContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
    ListContainer.Parent = DropdownFrame

    local ListLayout = Instance.new("UIListLayout")
    ListLayout.SortOrder = Enum.SortOrder.Name
    ListLayout.Parent = ListContainer

    ListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        ListContainer.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y)
    end)

    local itemButtons = {}

    for packName, anims in pairs(ANIMATION_DATA) do
        local targetAssetId = anims[animTypeKey]
        if not targetAssetId and animTypeKey == "idle2" then
            targetAssetId = anims["idle1"]
        end

        if targetAssetId then
            local ItemBtn = Instance.new("TextButton")
            ItemBtn.Size = UDim2.new(1, 0, 0, 30)
            ItemBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
            ItemBtn.BackgroundTransparency = 0.4
            ItemBtn.Text = "   " .. packName
            ItemBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
            ItemBtn.Font = Enum.Font.Gotham
            ItemBtn.TextSize = 12
            ItemBtn.TextXAlignment = Enum.TextXAlignment.Left
            ItemBtn.Parent = ListContainer

            table.insert(itemButtons, {btn = ItemBtn, name = packName:lower()})

            ItemBtn.MouseButton1Click:Connect(function()
                if string.find(targetAssetId, "http") then
                    CURRENT_ANIMS[animTypeKey] = targetAssetId
                else
                    CURRENT_ANIMS[animTypeKey] = "rbxassetid://" .. targetAssetId
                end
                
                HeaderBtn.Text = "  " .. labelName .. " : " .. packName
                
                TweenService:Create(DropdownFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quart), {Size = UDim2.new(1, -55, 0, 40)}):Play()
                TweenService:Create(WrapperFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quart), {Size = UDim2.new(1, 0, 0, 40)}):Play()
                TweenService:Create(ListContainer, TweenInfo.new(0.25, Enum.EasingStyle.Quart), {Size = UDim2.new(1, 0, 0, 0)}):Play()
                SearchBox.Visible = false
                openDropdown = nil
                
                if getgenv().ChangeAnim then applyAnimations(CURRENT_ANIMS) end
            end)
        end
    end

    -- Arama İşlevi
    SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local query = SearchBox.Text:lower()
        local visibleCount = 0
        for _, data in ipairs(itemButtons) do
            if query == "" or string.find(data.name, query) then
                data.btn.Visible = true
                visibleCount = visibleCount + 1
            else
                data.btn.Visible = false
            end
        end
        
        local calculatedHeight = math.clamp(visibleCount * 30, 0, 140)
        ListContainer.Size = UDim2.new(1, 0, 0, calculatedHeight)
        DropdownFrame.Size = UDim2.new(1, -55, 0, 85 + calculatedHeight)
        WrapperFrame.Size = UDim2.new(1, 0, 0, 85 + calculatedHeight)
    end)

    HeaderBtn.MouseButton1Click:Connect(function()
        local isClosed = (DropdownFrame.Size.Y.Offset == 40)
        
        if openDropdown and openDropdown ~= DropdownFrame then
            local otherWrapper = openDropdown.Parent
            local otherList = openDropdown:FindFirstChildWhichIsA("ScrollingFrame", true)
            local otherSearch = openDropdown:FindFirstChildWhichIsA("TextBox", true)
            
            TweenService:Create(openDropdown, TweenInfo.new(0.25, Enum.EasingStyle.Quart), {Size = UDim2.new(1, -55, 0, 40)}):Play()
            if otherWrapper then TweenService:Create(otherWrapper, TweenInfo.new(0.25, Enum.EasingStyle.Quart), {Size = UDim2.new(1, 0, 0, 40)}):Play() end
            if otherList then TweenService:Create(otherList, TweenInfo.new(0.25, Enum.EasingStyle.Quart), {Size = UDim2.new(1, 0, 0, 0)}):Play() end
            if otherSearch then otherSearch.Visible = false end
        end
        
        if isClosed then
            SearchBox.Text = ""
            SearchBox.Visible = true
            for _, data in ipairs(itemButtons) do data.btn.Visible = true end
            
            local contentHeight = math.clamp(ListLayout.AbsoluteContentSize.Y, 0, 140)
            local targetHeight = 85 + contentHeight
            
            TweenService:Create(DropdownFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(1, -55, 0, targetHeight)}):Play()
            TweenService:Create(WrapperFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, targetHeight)}):Play()
            TweenService:Create(ListContainer, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, contentHeight)}):Play()
            openDropdown = DropdownFrame
        else
            TweenService:Create(DropdownFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quart), {Size = UDim2.new(1, -55, 0, 40)}):Play()
            TweenService:Create(WrapperFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quart), {Size = UDim2.new(1, 0, 0, 40)}):Play()
            TweenService:Create(ListContainer, TweenInfo.new(0.25, Enum.EasingStyle.Quart), {Size = UDim2.new(1, 0, 0, 0)}):Play()
            SearchBox.Visible = false
            openDropdown = nil
        end
    end)
end

