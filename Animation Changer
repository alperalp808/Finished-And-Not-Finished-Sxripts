OpenCloseBtn.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        btnDragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == btnDragInput and btnDragging then
        local delta = input.Position - btnMousePos
        local newXPos = btnFramePos.X + delta.X
        -- Y Pozisyonu kesinlikle sabittir (Değiştirilmez)
        OpenCloseBtn.Position = UDim2.new(0, newXPos, OpenCloseBtn.Position.Y.Scale, OpenCloseBtn.Position.Y.Offset)
    end
end)

