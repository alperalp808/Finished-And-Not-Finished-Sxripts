	SetupCharacter(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(function(Character)
	LastTouchedPart = nil
	FallTimer = nil
	SetupCharacter(Character)
end)

RunService.Heartbeat:Connect(function()
	if not getgenv().AntiVoid then
		FallTimer = nil
		return
	end

	local RootPart = GetRootPart()
	if not RootPart then return end

	-- Düşme hızı kontrolü (Y ekseninde -50'den daha hızlı düşüyorsa tetiklenir)
	if RootPart.AssemblyLinearVelocity.Y >= -50 then
		FallTimer = nil
	elseif FallTimer then
		if tick() - FallTimer >= 0.5 then
			FallTimer = nil
			if LastTouchedPart and LastTouchedPart.Parent and LastTouchedPart:IsA("BasePart") then
				local Position = LastTouchedPart.Position + Vector3.new(0, (LastTouchedPart.Size.Y / 2) + (RootPart.Size.Y / 2), 0)
				RootPart.CFrame = CFrame.new(Position)
				RootPart.AssemblyLinearVelocity = Vector3.zero
			end
		end
	else
		FallTimer = tick()
	end
end)


