local function triggerPrompt(prompt)
	pcall(function()
		if fireproximityprompt then
			fireproximityprompt(prompt)
		elseif prompt and prompt:IsA("ProximityPrompt") then
			prompt:InputHoldBegin()
			task.wait(prompt.HoldDuration)
			prompt:InputHoldEnd()
		end
	end)
end

