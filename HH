Sec14:AddButton({
    Name = "Quick To Target",
    Notifications = false,
    Callback = function()
        local myCharacter = LocalPlayer.Character
        local myHRP = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
        if not myHRP then
            warn("Kendi karakterinizin HumanoidRootPart'ı bulunamadı!")
            return
        end
        if not selectedPlayerName or selectedPlayerName == "" then
            warn("Lütfen önce bir oyuncu seçin!")
            return
        end
        local targetPlayer = Players:FindFirstChild(selectedPlayerName)
        local targetCharacter = targetPlayer and targetPlayer.Character
        local targetHRP = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
        if targetHRP then
            local originalCFrame = myHRP.CFrame
            myHRP.CFrame = targetHRP.CFrame
            task.wait(0.1)
            myHRP.CFrame = originalCFrame
        else
            warn("Hedef oyuncu veya karakteri bulunamadı!")
        end
    end
})

Sec14:AddButton({
   Name = "Teleport Player (Dont Spam)",
   Notifications = false,
   Callback = function()
      local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
      if not hrp then return end
      local targetHrp, maxDist = nil, -1
      for _, v in ipairs(Players:GetPlayers()) do
          if v ~= LocalPlayer and v.Team and v.Team.Name == "Playing" and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
              local dist = (hrp.Position - v.Character.HumanoidRootPart.Position).Magnitude
              if dist > maxDist then
                  maxDist = dist
                  targetHrp = v.Character.HumanoidRootPart
              end
          end
      end
      if targetHrp then
          local savedCFrame = hrp.CFrame
          hrp.CFrame = targetHrp.CFrame
          task.wait(0.1)
          hrp.CFrame = savedCFrame
      end
   end
})


