local function GetPlayerList()
    local playerNames = {}
    for _, player in ipairs(Players:GetPlayers()) do
        -- Kendimizi listeye eklemeyelim
        if player ~= LocalPlayer then
            table.insert(playerNames, player.Name)
        end
    end
    return playerNames
end

