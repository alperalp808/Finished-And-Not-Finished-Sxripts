-- 3. ANA SUİKAST FONKSİYONU
function executeAssasinAutoKill()
    if IsExecuting or not CurrentTarget then return end
    IsExecuting = true

    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")
    local hum = char:WaitForChild("Humanoid")
    
    -- Başlangıç konumunu kaydet
    local savedCFrame = root.CFrame
    
    -- AssasinsBlade'i kuşan
    local backpackBlade = LocalPlayer.Backpack:FindFirstChild("AssasinsBlade")
    if backpackBlade then
        hum:EquipTool(backpackBlade)
    end
    
    local charBlade = char:WaitForChild("AssasinsBlade", 3)
    if not charBlade then 
        IsExecuting = false 
        return 
    end

    local lastAttackTick = 0
    local ATTACK_RATE = 0.07 -- Lag önleyici vuruş hızı (Saniyede ~14 istek)

    -- Loop Teleport & Remote Attack
    local connection
    connection = RunService.Heartbeat:Connect(function()
        -- Güvenlik Kontrolleri
        local countdown = char:FindFirstChild("Assasin Countdown")
        if not getgenv().AssKillTarget or not CurrentTarget or not CurrentTarget.Character or not countdown then
            connection:Disconnect()
            IsExecuting = false
            return
        end

        local targetChar = CurrentTarget.Character
        local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
        local targetHead = targetChar:FindFirstChild("Head")
        local targetHum = targetChar:FindFirstChild("Humanoid")

        if not targetRoot or not targetHead or (targetHum and targetHum.Health <= 0) then
            connection:Disconnect()
            IsExecuting = false
            return
        end

        -- ÇİZİME UYGUN POZİSYON HESABI:
        -- Hedefin hareket yönüne göre tahmin (Prediction)
        local prediction = targetHum.MoveDirection * (targetHum.WalkSpeed * getgenv().Pred)
        local targetCFrame = targetRoot.CFrame + prediction
        
        -- Hedefin 5 stud altına yerleştir, sırtüstü yatır ve yüzünü YUKARI bakacak şekilde ayarla
        root.CFrame = targetCFrame * CFrame.new(0, -5, 0) * CFrame.Angles(math.rad(90), 0, 0)

        -- Bıçak Elindeyken Animasyon ve Remote'lar
        if tick() - lastAttackTick > ATTACK_RATE then
            if getgenv().UseAnim and charBlade then
                charBlade:Activate()
            end
            
            pcall(function()
                local equippedBlade = Workspace[LocalPlayer.Name]:FindFirstChild("AssasinsBlade")
                if equippedBlade then
                    equippedBlade.doAttack:FireServer()
                    equippedBlade.doHit:FireServer(targetHead, "character")
                end
            end)
            
            lastAttackTick = tick()
        end
    end)

    -- Hedef ölene kadar döngüyü koru
    repeat task.wait(0.2) until not connection.Connected

    -- İşlem bittiğinde kaydedilen konuma geri dön
    if root and savedCFrame then
        task.wait(0.1)
        root.CFrame = savedCFrame
    end

    CurrentTarget = nil
    IsExecuting = false
end



local function isGauntletEquipped(char)
    if not char then return false end
    local tool = char:FindFirstChildOfClass("Tool")
    return tool and (tool.Name == "King's Gauntlet" or tool.Name == "Kings Gauntlet")
end

local function getTarget()
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return nil end

    local selectedChar = nil
    local minMetric = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local targetHrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")

            if targetHrp and hum and hum.Health > 0 then
                local horizontalDist = (Vector3.new(myHrp.Position.X, 0, myHrp.Position.Z) - Vector3.new(targetHrp.Position.X, 0, targetHrp.Position.Z)).Magnitude
                local heightDist = math.abs(myHrp.Position.Y - targetHrp.Position.Y)

                if horizontalDist <= 17 and heightDist <= 10 then
                    local mode = getgenv().EnmyType
                    if mode == "Nearest" then
                        local dist = (myHrp.Position - targetHrp.Position).Magnitude
                        if dist < minMetric then
                            minMetric = dist
                            selectedChar = char
                        end
                    elseif mode == "LowestHealth" then
                        if hum.Health < minMetric then
                            minMetric = hum.Health
                            selectedChar = char
                        end
                    end
                end
            end
        end
    end

    return selectedChar
end

