	isMinimized = not isMinimized
	local targetSize = isMinimized and UDim2.new(0, 230, 0, 35) or UDim2.new(0, 230, 0, 360)
	
	TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = targetSize
	}):Play()
	
	contentFrame.Visible = not isMinimized
end)

-- Close Button Animation
closeBtn.MouseButton1Click:Connect(function()
	local tween = TweenService:Create(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Size = UDim2.new(0, 230, 0, 0),
		BackgroundTransparency = 1
	})
	tween:Play()
	tween.Completed:Connect(function()
		updateHighlight(nil)
		screenGui:Destroy()
	end)
end)
