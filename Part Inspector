-- Function: Create Data Field with setclipboard Support
local function createDataField(labelTitle, dataValue)
	local container = Instance.new("Frame")
	container.Size = UDim2.new(1, 0, 0, 44)
	container.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	container.BackgroundTransparency = 0.5
	container.Parent = scrollFrame

	local fieldCorner = Instance.new("UICorner")
	fieldCorner.CornerRadius = UDim.new(0, 4)
	fieldCorner.Parent = container

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -65, 0, 14)
	title.Position = UDim2.new(0, 6, 0, 2)
	title.BackgroundTransparency = 1
	title.Text = labelTitle
	title.TextColor3 = PRIMARY_COLOR
	title.TextSize = 10
	title.Font = Enum.Font.SourceSansBold
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = container

	local textBox = Instance.new("TextBox")
	textBox.Size = UDim2.new(1, -65, 0, 22)
	textBox.Position = UDim2.new(0, 6, 0, 18)
	textBox.BackgroundTransparency = 1
	textBox.Text = tostring(dataValue)
	textBox.TextColor3 = TEXT_COLOR
	textBox.TextSize = 11
	textBox.Font = Enum.Font.SourceSans
	textBox.TextXAlignment = Enum.TextXAlignment.Left
	textBox.ClearTextOnFocus = false
	textBox.TextEditable = false
	textBox.TextTruncate = Enum.TextTruncate.AtEnd
	textBox.Parent = container

	-- Kopyala Butonu
	local copyBtn = Instance.new("TextButton")
	copyBtn.Size = UDim2.new(0, 54, 0, 24)
	copyBtn.Position = UDim2.new(1, -58, 0.5, -12)
	copyBtn.BackgroundColor3 = PRIMARY_COLOR
	copyBtn.BackgroundTransparency = 0.3
	copyBtn.Text = "Kopyala"
	copyBtn.TextColor3 = TEXT_COLOR
	copyBtn.Font = Enum.Font.SourceSansBold
	copyBtn.TextSize = 10
	copyBtn.Parent = container

	local copyCorner = Instance.new("UICorner")
	copyCorner.CornerRadius = UDim.new(0, 4)
	copyCorner.Parent = copyBtn

	copyBtn.MouseButton1Click:Connect(function()
		local textToCopy = tostring(dataValue)
		local copied = false

		if setclipboard then
			pcall(function()
				setclipboard(textToCopy)
				copied = true
			end)
		elseif toclipboard then
			pcall(function()
				toclipboard(textToCopy)
				copied = true
			end)
		end

		if not copied then
			textBox:CaptureFocus()
			textBox:SelectionStart(1)
			textBox:CursorPosition(#textBox.Text + 1)
		end

		copyBtn.Text = copied and "Kopyalandı!" or "Seçildi!"
		task.delay(1, function()
			if copyBtn and copyBtn.Parent then
				copyBtn.Text = "Kopyala"
			end
		end)
	end)
end

-- Highlight Management
local function updateHighlight(targetPart)
	if highlight then
		highlight:Destroy()
		highlight = nil
	end

	if targetPart then
		highlight = Instance.new("Highlight")
		highlight.Adornee = targetPart
		highlight.FillColor = PRIMARY_COLOR
		highlight.FillTransparency = 0.5
		highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		highlight.OutlineTransparency = 0
		highlight.Parent = targetPart
	end
end

-- Display Part Properties and Children
local function displayPartProperties(part)
	for _, child in ipairs(scrollFrame:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	if not part then return end

	-- Temel Özellikler
	createDataField("İsim (Name)", part.Name)
	createDataField("Ebeveyn (Parent)", part.Parent:GetFullName())
	createDataField("Tam Yol (FullName)", part:GetFullName())
	createDataField("Sınıf (ClassName)", part.ClassName)
	createDataField("Renk (Color)", string.format("R: %d, G: %d, B: %d", part.Color.R * 255, part.Color.G * 255, part.Color.B * 255))
	createDataField("Pozisyon (Position)", string.format("%.2f, %.2f, %.2f", part.Position.X, part.Position.Y, part.Position.Z))
	createDataField("Boyut (Size)", string.format("%.2f, %.2f, %.2f", part.Size.X, part.Size.Y, part.Size.Z))
	createDataField("Materyal (Material)", part.Material.Name)
	createDataField("Saydamlık (Transparency)", part.Transparency)
	createDataField("Anchored", tostring(part.Anchored))
	createDataField("CanCollide", tostring(part.CanCollide))

	-- İçindekiler (Children / Alt Ögeler)
	local children = part:GetChildren()
	if #children > 0 then
		for index, child in ipairs(children) do
			createDataField(string.format("İçerik %d (%s)", index, child.ClassName), child.Name)
		end
	else
		createDataField("İçindekiler (Children)", "Boş (Alt öge yok)")
	end
end

-- Raycast Selection Logic
local function handleSelection(screenPosition)
	if not isInspectorActive then return end

	local unitRay = Camera:ViewportPointToRay(screenPosition.X, screenPosition.Y)
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	
	if LocalPlayer.Character then
		raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
	end

	local result = workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000, raycastParams)

	if result and result.Instance then
		selectedPart = result.Instance
		updateHighlight(selectedPart)
		displayPartProperties(selectedPart)
	end
end

-- Input Listeners (Drag vs Click Filter)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed or not isInspectorActive then return end

	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		handleSelection(input.Position)
	elseif input.UserInputType == Enum.UserInputType.Touch then
		touchStartPos = input.Position
		touchStartTime = tick()
	end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
	if gameProcessed or not isInspectorActive then return end

	if input.UserInputType == Enum.UserInputType.Touch and touchStartPos then
		local moveDistance = (input.Position - touchStartPos).Magnitude
		local duration = tick() - touchStartTime
		
		-- Ekran kaydırmayı engellemek için mesafe ve süre filtresi
		if moveDistance < 12 and duration < 0.4 then
			handleSelection(input.Position)
		end
		touchStartPos = nil
	end
end)

