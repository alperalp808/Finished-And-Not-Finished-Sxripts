		NumberRange.new(20, 28),
		NumberRange.new(0.3, 0.5),
		50
	)
	local jetDown = NewJet(
		Enum.NormalId.Bottom,
		NumberRange.new(12, 16),
		NumberRange.new(0.2, 0.3),
		30
	)

	local emitters = {infall, jetUp, jetDown}
	local trails = {}

	for _, config in ipairs(BLACKHOLE_SPIN_LAYERS) do
		CreateSpinLayer(model, core, originCF, config, trails)
