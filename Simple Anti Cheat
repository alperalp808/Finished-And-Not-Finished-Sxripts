--//==================================================
--// FPS
--//==================================================

local Frames = 0
local LastFPSUpdate = os.clock()

RunService.RenderStepped:Connect(function()

	Frames += 1

	local now = os.clock()

	if now - LastFPSUpdate >= 1 then

		local fps =
			Frames
			/
			(now - LastFPSUpdate)

		Frames = 0
		LastFPSUpdate = now

		FPSLabel.Text =
			string.format(
				"%d FPS",
				math.floor(fps + 0.5)
			)
	end
end)

--//==================================================
--// PING
--//==================================================

task.spawn(function()

	while Gui.Parent do

		task.wait(1)

		local ping

		pcall(function()

			local network =
				Stats:FindFirstChild("Network")

			if network then

				local serverStats =
					network:FindFirstChild(
						"ServerStatsItem"
					)

				if serverStats then

					local dataPing =
						serverStats:FindFirstChild(
							"Data Ping"
						)

					if dataPing then

						ping =
							math.floor(
								dataPing:GetValue()
							)
					end
				end
			end
		end)


		if ping and ping > 0 then

			PingLabel.Text =
				tostring(ping) .. " ms"

		else

			PingLabel.Text = "-- ms"

		end
	end
end)

