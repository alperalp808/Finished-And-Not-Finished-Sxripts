--// YARDIMCI FONKSİYONLAR //--

-- R15 karakterin Avatar Joint Upgrade (yeni sistem) mi yoksa klasik Motor6D mi kullandığını tespit eder.
-- Resmi API referansına göre doğru arama yöntemi budur (sadece R15'te anlamlı).
local function usesAvatarJointUpgrade(character)
	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant:IsA("AnimationConstraint") then
			return true
		end
	end
	return false
end

-- R15 - YENİ SİSTEM (AJU): Zaten var olan AnimationConstraint'leri devre dışı bırakıp
-- BallSocketConstraint'lerin fizik kontrolünü almasını sağlar.
local function ragdollR15ViaAJU(character)
	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant:IsA("AnimationConstraint") then
			descendant.Enabled = false
		elseif descendant:IsA("BallSocketConstraint") then
			descendant.Enabled = true
		elseif descendant:IsA("Motor6D") then
			descendant.Enabled = false
		end
	end
end

-- R15 - ESKİ SİSTEM (klasik): Motor6D'leri yok edip yerine BallSocketConstraint kurar.
-- R15'te Attachment'lar zaten karakterde hazır geldiği için yeniden oluşturmaya gerek yok.
local function ragdollR15ViaMotor6D(character)
	for _, jointInfo in ipairs(R15_JOINTS) do
		local part0Name, part1Name, att0Name, att1Name = jointInfo[1], jointInfo[2], jointInfo[3], jointInfo[4]

		local part0 = character:FindFirstChild(part0Name)
		local part1 = character:FindFirstChild(part1Name)
		if not (part0 and part1) then
			continue
		end

		local motor = part1:FindFirstChildOfClass("Motor6D")
		if motor and (motor.Part0 == part0 or motor.Part1 == part0) then
			motor:Destroy()
		end

		local att0 = part0:FindFirstChild(att0Name)
		local att1 = part1:FindFirstChild(att1Name)
		if not (att0 and att1) then
			continue
		end

		local socket = Instance.new("BallSocketConstraint")
		socket.Name = "RagdollSocket_" .. part0Name .. "_" .. part1Name
		socket.Attachment0 = att0
		socket.Attachment1 = att1
		socket.LimitsEnabled = true
		socket.TwistLimitsEnabled = true
		socket.Restitution = 0
		socket.Parent = part0
	end
end

-- R6: Attachment'lar karakterde hazır gelmediği için, her Motor6D'nin C0/C1 CFrame'lerinden
-- kendimiz Attachment oluşturup BallSocketConstraint kuruyoruz. Motor6D yok edilmiyor,
-- sadece devre dışı bırakılıyor (geri dönüş / hata ayıklama için daha güvenli).
local function ragdollR6(character)
	for _, jointInfo in ipairs(R6_JOINTS) do
		local part0 = character:FindFirstChild(jointInfo.part0)
		local part1 = character:FindFirstChild(jointInfo.part1)
		if not (part0 and part1) then
			continue
		end

		local motor = part1:FindFirstChild(jointInfo.motorName)
			or part0:FindFirstChild(jointInfo.motorName)

		if motor and motor:IsA("Motor6D") then
			motor.Enabled = false
		end

		local att0 = Instance.new("Attachment")
		att0.Name = "RagdollAttachment_" .. jointInfo.motorName .. "_0"
		att0.CFrame = jointInfo.c0
		att0.Parent = part0

		local att1 = Instance.new("Attachment")
		att1.Name = "RagdollAttachment_" .. jointInfo.motorName .. "_1"
		att1.CFrame = jointInfo.c1
		att1.Parent = part1

		local socket = Instance.new("BallSocketConstraint")
		socket.Name = "RagdollSocket_" .. jointInfo.motorName
		socket.Attachment0 = att0
		socket.Attachment1 = att1
		socket.LimitsEnabled = true
		socket.TwistLimitsEnabled = true
		socket.Restitution = 0
		socket.Parent = part0
	end
end

-- Karakteri ragdoll durumuna geçirir: RigType'a bakıp doğru yolu seçer.
-- İki rig tipini de kapsar; sadece R15'e özel hiçbir varsayım R6 yoluna sızmaz.
local function ragdollCharacter(character, humanoid)
	humanoid.BreakJointsOnDeath = false -- Roblox'un varsayılan "parçala" davranışını engelle, her iki rig için de geçerli
	humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	humanoid.PlatformStand = true
	humanoid.RequiresNeck = false -- R6'da baş kopup gitmesin

	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		ragdollR6(character)
	else
		-- R15
		if usesAvatarJointUpgrade(character) then
			ragdollR15ViaAJU(character)
		else
			ragdollR15ViaMotor6D(character)
		end
	end

	-- Her iki rig tipinde de tüm parçaların çarpışabilir olduğundan emin ol,
	-- yoksa ragdoll yere düşmeden havada asılı kalabilir.
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = true
		end
	end
end

-- Karakterin fiziksel olarak "durduğunu" (yere yığılıp sakinleştiğini) tespit eder.
-- Rig tipinden bağımsız çalışır çünkü sadece BasePart hızlarına bakıyor.
local function waitUntilSettled(character, timeoutSeconds)
	local startTime = os.clock()

	while os.clock() - startTime < timeoutSeconds do
		local maxSpeed = 0

		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				local speed = part.AssemblyLinearVelocity.Magnitude
				if speed > maxSpeed then
					maxSpeed = speed
				end
			end
		end

		if maxSpeed < SETTLE_VELOCITY_THRESHOLD then
			return true
		end

		task.wait(SETTLE_CHECK_INTERVAL)
	end

	return false
end

-- Ragdoll halindeki karakteri klonlar, Dead klasörüne koyar, sabitler ve zamanlayıcıya bağlar.
-- Rig tipinden bağımsız: klonlama her zaman aynı, çünkü sadece var olan parça/constraint'leri temizliyor.
local function cloneToDeadFolder(character, player)
	if not deadFolder then
		return
	end

	local clone = character:Clone()
	clone.Name = (player and player.Name or character.Name) .. "_Dead"

	for _, part in ipairs(clone:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
		elseif part:IsA("Constraint") or part:IsA("Motor6D") or part:IsA("Attachment") then
			part:Destroy() -- klon statik bir görsel, fizik kısıtlamalarına ihtiyacı yok (R6 için oluşturulan Attachment'lar dahil)
		end
	end

	local cloneHumanoid = clone:FindFirstChildOfClass("Humanoid")
	if cloneHumanoid then
		cloneHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		cloneHumanoid.Health = 0
		cloneHumanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	end

	clone.Parent = deadFolder
	Debris:AddItem(clone, DEAD_BODY_LIFETIME)

	return clone
end

--// ÖLÜM İŞLEME AKIŞI //--

local function onCharacterDied(player, character, humanoid)
	if character:GetAttribute("DeathHandled") then
		return
	end
	character:SetAttribute("DeathHandled", true)

	ragdollCharacter(character, humanoid)

	task.spawn(function()
		waitUntilSettled(character, SETTLE_TIMEOUT)

		if not character.Parent then
			return
		end

		cloneToDeadFolder(character, player)
		character:Destroy()

		if player and player.Parent then
			player:LoadCharacter()
		end
	end)
end

local function setupHumanoidTracking(player, character)
	local humanoid = character:WaitForChild("Humanoid", 5)
	if not humanoid then
		return
	end

	character:SetAttribute("DeathHandled", false)

	humanoid.Died:Connect(function()
		onCharacterDied(player, character, humanoid)
	end)
end

--// TÜM OYUNCULARA UYGULAMA (herkes için geçerli, rig tipi ve admin ayrımı yok) //--

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(character)
		setupHumanoidTracking(player, character)
	end)

	if player.Character then
		setupHumanoidTracking(player, player.Character)
	end
end)

for _, player in ipairs(Players:GetPlayers()) do
	if player.Character then
		setupHumanoidTracking(player, player.Character)
	end
	player.CharacterAdded:Connect(function(character)
		setupHumanoidTracking(player, character)
	end)
end