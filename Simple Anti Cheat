local function PositionSettingsButton()

	local chat =
		FindChatButton()

	if chat then

		local pos =
			chat.AbsolutePosition

		local size =
			chat.AbsoluteSize

		local x =
			pos.X
			+
			size.X
			+
			7

		local y =
			pos.Y

		SettingsButton.Position =
			UDim2.fromOffset(
				x,
				y
			)

	else

		-- Fallback

		SettingsButton.Position =
			UDim2.fromOffset(
				145,
				6
			)

	end
end

--========================================================
-- RESPONSIVE WINDOW
--========================================================

local function UpdateWindowPosition()

	local camera =
		workspace.CurrentCamera

	if not camera then
		return
	end

	local viewport =
		camera.ViewportSize

	-- Android / küçük ekran

	if viewport.X <= 600 then

		local width =
			math.min(
				viewport.X - 20,
				390
			)

		local height =
			math.min(
				viewport.Y - 90,
				500
			)

		Window.Size =
			UDim2.fromOffset(
				width,
				height
			)

		Window.Position =
			UDim2.new(
				0.5,
				-width / 2,
				0,
				58
			)

	else

		local buttonPos =
			SettingsButton.AbsolutePosition

		local buttonSize =
			SettingsButton.AbsoluteSize

		Window.Size =
			UDim2.fromOffset(
				350,
				450
			)

		Window.Position =
			UDim2.fromOffset(
				buttonPos.X,
				buttonPos.Y
					+
					buttonSize.Y
					+
					8
			)

	end
end

--========================================================
-- OPEN / CLOSE
--========================================================

local IsOpen = false
local Animating = false

local function OpenMenu()

	if Animating or IsOpen then
		return
	end

	Animating = true
	IsOpen = true

	Window.Visible = true

	UpdateWindowPosition()

	local finalSize =
		Window.Size

	local finalPosition =
		Window.Position

	-- Başlangıç

	Window.Size =
		UDim2.new(
			finalSize.X.Scale,
			finalSize.X.Offset,
			0,
			0
		)

	Window.Position =
		UDim2.new(
			finalPosition.X.Scale,
			finalPosition.X.Offset,
			finalPosition.Y.Scale,
			finalPosition.Y.Offset - 8
		)

	TweenService:Create(

		Window,

		TweenInfo.new(
			0.22,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),

		{
			Size = finalSize,
			Position = finalPosition
		}

	):Play()

	TweenService:Create(

		SettingsButton,

		TweenInfo.new(
			0.16,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),

		{
			BackgroundColor3 =
				ACCENT
		}

	):Play()

	task.delay(
		0.23,
		function()

			Animating = false

		end
	)
end

local function CloseMenu()

	if Animating or not IsOpen then
		return
	end

	Animating = true
	IsOpen = false

	local currentSize =
		Window.Size

	TweenService:Create(

		Window,

		TweenInfo.new(
			0.17,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.In
		),

		{
			Size =
				UDim2.new(
					currentSize.X.Scale,
					currentSize.X.Offset,
					0,
					0
				)
		}

	):Play()

	TweenService:Create(

		SettingsButton,

		TweenInfo.new(
			0.16,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),

		{
			BackgroundColor3 =
				CARD
		}

	):Play()

	task.delay(
		0.18,
		function()

			if not IsOpen then
				Window.Visible = false
			end

			Animating = false

		end
	)
end

SettingsButton.Activated:Connect(function()

	if IsOpen then

		CloseMenu()

	else

		OpenMenu()

	end
end)

