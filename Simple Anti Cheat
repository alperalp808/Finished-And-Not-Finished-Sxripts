-- 3. GHOST
EffectHandlers["Ghost"] = function(victimCharacter, killerPlayer)
	if not victimCharacter or victimCharacter:GetAttribute("IsGhostTransformed") then return end
	victimCharacter:SetAttribute("IsGhostTransformed", true)

	local hrp = victimCharacter:FindFirstChild("HumanoidRootPart")
	local humanoid = victimCharacter:FindFirstChildOfClass("Humanoid")

	local soundPart = hrp or victimCharacter:FindFirstChild("Torso") or victimCharacter:FindFirstChildOfClass("BasePart")
	if soundPart then
		PlayServerSound(GHOST_SOUND_ID, soundPart)
	end

	if not hrp then
		Debris:AddItem(victimCharacter, 2)
		return
	end

	if humanoid then
		humanoid.BreakJointsOnDeath = false
		humanoid.PlatformStand = true
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end

	EnsureRootAttached(victimCharacter)
	ReattachAccessories(victimCharacter)

	if not BuildR6Ragdoll(victimCharacter) then
		WeldPartsToRoot(victimCharacter, hrp)
	end

	for _, part in ipairs(victimCharacter:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = false

			local gravityAttachment = Instance.new("Attachment")
			gravityAttachment.Name = "GhostGravityAttachment"
			gravityAttachment.Parent = part

			local antiGravity = Instance.new("VectorForce")
			antiGravity.Name = "GhostAntiGravity"
			antiGravity.Attachment0 = gravityAttachment
			antiGravity.RelativeTo = Enum.ActuatorRelativeTo.World
			antiGravity.ApplyAtCenterOfMass = true
			antiGravity.Force = Vector3.new(
				0,
				part:GetMass() * workspace.Gravity * GHOST_ANTIGRAVITY,
				0
			)
			antiGravity.Parent = part
		end
	end

	TakeServerPhysicsOwnership(victimCharacter)

	victimCharacter:SetAttribute("KilledByDivineAxe", true)

	local fadeTargets = {}
	for _, obj in ipairs(victimCharacter:GetDescendants()) do
		if (obj:IsA("BasePart") and obj ~= hrp) or obj:IsA("Decal") then
			if obj.Transparency < 1 then
				table.insert(fadeTargets, {
					instance = obj,
					base = obj.Transparency
				})
			end
		end
	end

	local glow = Instance.new("PointLight")
	glow.Name = "GhostGlow"
	glow.Color = GHOST_COLOR
	glow.Range = 10
	glow.Brightness = 1.5
	glow.Shadows = false
	glow.Parent = hrp

	local wisps = Instance.new("ParticleEmitter")
	wisps.Name = "GhostWisps"
	wisps.Texture = "rbxassetid://258122325"
	wisps.Color = ColorSequence.new(GHOST_COLOR)
	wisps.LightEmission = 0.6
	wisps.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.7),
		NumberSequenceKeypoint.new(1, 0),
	})
	wisps.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.4),
		NumberSequenceKeypoint.new(1, 1),
	})
	wisps.Lifetime = NumberRange.new(0.8, 1.6)
	wisps.Speed = NumberRange.new(0.5, 2)
	wisps.Acceleration = Vector3.new(0, 3, 0)
	wisps.SpreadAngle = Vector2.new(180, 180)
	wisps.Rate = 25
	wisps.Parent = hrp

	local holdAttachment = Instance.new("Attachment")
	holdAttachment.Name = "GhostHoldAttachment"
	holdAttachment.Parent = hrp

	local startPosition = hrp.Position
	local look = hrp.CFrame.LookVector
	local baseYaw = math.atan2(-look.X, -look.Z)
	local tilt = math.rad(GHOST_TILT_DEGREES)
	local phase = math.random() * math.pi * 2

	local alignPosition = Instance.new("AlignPosition")
	alignPosition.Name = "GhostHoldPosition"
	alignPosition.Mode = Enum.PositionAlignmentMode.OneAttachment
	alignPosition.Attachment0 = holdAttachment
	alignPosition.Position = startPosition
	alignPosition.ApplyAtCenterOfMass = true
	alignPosition.RigidityEnabled = false
	alignPosition.MaxForce = 200000
	alignPosition.MaxVelocity = 14
	alignPosition.Responsiveness = 20
	alignPosition.Parent = hrp

	local alignOrientation = Instance.new("AlignOrientation")
	alignOrientation.Name = "GhostHoldOrientation"
	alignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	alignOrientation.Attachment0 = holdAttachment
	alignOrientation.CFrame = hrp.CFrame.Rotation
	alignOrientation.RigidityEnabled = false
	alignOrientation.MaxTorque = 100000
	alignOrientation.MaxAngularVelocity = 3
	alignOrientation.Responsiveness = 12
	alignOrientation.Parent = hrp

	Debris:AddItem(victimCharacter, GHOST_DURATION + 3)

	task.spawn(function()
		local startTime = os.clock()

		while true do
			if not victimCharacter.Parent or not hrp.Parent then return end

			local elapsed = os.clock() - startTime
			local alpha = math.clamp(elapsed / GHOST_DURATION, 0, 1)

			local rise = GHOST_RISE_HEIGHT * math.sin(alpha * math.pi / 2)
			local sway = GHOST_SWAY_AMPLITUDE * math.min(1, elapsed)

			alignPosition.Position = startPosition + Vector3.new(
				math.sin(elapsed * 1.6 + phase) * sway,
				rise + math.sin(elapsed * 2.8 + phase) * 0.25,
				math.cos(elapsed * 1.2 + phase) * sway * 0.7
			)

			local settle = math.min(1, elapsed / 0.8)
			alignOrientation.CFrame = CFrame.Angles(
				0,
				baseYaw + elapsed * 0.35,
				0
			) * CFrame.Angles(
				tilt * settle + math.sin(elapsed * 1.3 + phase) * 0.08,
				0,
				math.sin(elapsed * 1.7 + phase) * 0.1
			)

			local fadeAlpha = math.clamp(
				(alpha - GHOST_FADE_START) / (1 - GHOST_FADE_START),
				0,
				1
			)
			fadeAlpha = fadeAlpha * fadeAlpha * (3 - 2 * fadeAlpha)

			for _, entry in ipairs(fadeTargets) do
				local inst = entry.instance
				if inst.Parent then
					inst.Transparency = entry.base + (1 - entry.base) * fadeAlpha
				end
			end

			glow.Brightness = 1.5 * (1 - fadeAlpha)
			wisps.Rate = 25 * (1 - fadeAlpha)

			if alpha >= 1 then break end
			RunService.Heartbeat:Wait()
		end

		task.wait(0.15)
		if victimCharacter.Parent then
			victimCharacter:Destroy()
		end
	end)
end

