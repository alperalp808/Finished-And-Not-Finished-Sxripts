	local Stroke = Instance.new("UIStroke")
	Stroke.Color = BORDER_DARK
	Stroke.Thickness = 1
	Stroke.Parent = Holder

	local Title = Instance.new("TextLabel")
	Title.Position = UDim2.fromOffset(13, 10)
	Title.Size = UDim2.new(0.6, 0, 0, 20)
	Title.BackgroundTransparency = 1
	Title.Text = title
	Title.TextColor3 = TEXT_PRIMARY
	Title.TextSize = 12
	Title.Font = Enum.Font.GothamMedium
	Title.TextXAlignment = Enum.TextXAlignment.Left
	Title.Parent = Holder

	local Value = Instance.new("TextLabel")
	Value.Position = UDim2.new(1, -73, 0, 10)
	Value.Size = UDim2.fromOffset(60, 20)
	Value.BackgroundTransparency = 1
	Value.TextColor3 = TEXT_PRIMARY
	Value.TextSize = 12
	Value.Font = Enum.Font.GothamBold
	Value.TextXAlignment = Enum.TextXAlignment.Right
	Value.Parent = Holder

	local TouchArea = Instance.new("TextButton")
	TouchArea.Position = UDim2.fromOffset(13, 42)
	TouchArea.Size = UDim2.new(1, -26, 0, 24)
	TouchArea.BackgroundTransparency = 1
	TouchArea.Text = ""
	TouchArea.AutoButtonColor = false
	TouchArea.ZIndex = 10
	TouchArea.Parent = Holder

	local Track = Instance.new("Frame")
	Track.Position = UDim2.new(0, 0, 0.5, -3)
	Track.Size = UDim2.new(1, 0, 0, 6)
	Track.BackgroundColor3 = TRACK_DARK
	Track.BorderSizePixel = 0
	Track.Parent = TouchArea

	local TrackCorner = Instance.new("UICorner")
	TrackCorner.CornerRadius = UDim.new(1, 0)
	TrackCorner.Parent = Track

	local Fill = Instance.new("Frame")
	Fill.Size = UDim2.new(0, 0, 1, 0)
	Fill.BackgroundColor3 = ACCENT_PRIMARY
	Fill.BorderSizePixel = 0
	Fill.Parent = Track

	local FillCorner = Instance.new("UICorner")
	FillCorner.CornerRadius = UDim.new(1, 0)
	FillCorner.Parent = Fill

	local Knob = Instance.new("Frame")
	Knob.Size = UDim2.fromOffset(16, 16)
	Knob.AnchorPoint = Vector2.new(0.5, 0.5)
	Knob.Position = UDim2.new(0, 0, 0.5, 0)
	Knob.BackgroundColor3 = ACCENT_PRIMARY
	Knob.BorderSizePixel = 0
	Knob.ZIndex = 12
	Knob.Parent = Track

	local KnobCorner = Instance.new("UICorner")
	KnobCorner.CornerRadius = UDim.new(1, 0)
	KnobCorner.Parent = Knob

	local Dragging = false

	local function SetValue(number)
		number = math.clamp(number, minimum, maximum)
		number = math.floor(number + 0.5)

		local percentage = (number - minimum) / (maximum - minimum)
		percentage = math.clamp(percentage, 0, 1)

		Fill.Size = UDim2.new(percentage, 0, 1, 0)
		Knob.Position = UDim2.new(percentage, 0, 0.5, 0)
		Value.Text = tostring(number)

		callback(number)
	end

	local function UpdateFromX(x)
		local start = TouchArea.AbsolutePosition.X
		local width = TouchArea.AbsoluteSize.X
		if width <= 0 then return end

		local percentage = (x - start) / width
		percentage = math.clamp(percentage, 0, 1)

		local number = minimum + (maximum - minimum) * percentage
		SetValue(number)
	end

	TouchArea.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			Dragging = true
			UpdateFromX(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not Dragging then return end
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
			UpdateFromX(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			Dragging = false
		end
	end)

	SetValue(default)
	return Holder
end

--========================================================
-- RIG CONVERTER (GERÇEK R6 / R15 RESPAWN DÖNÜŞÜMÜ)
--========================================================

local RigInfo

local function ChangeRigType(targetRigType)
	if not Character or not Humanoid then return end

	local currentEnum = (targetRigType == "R6") and Enum.HumanoidRigType.R6 or Enum.HumanoidRigType.R15
	if Humanoid.RigType == currentEnum then return end

	local oldCFrame = nil
	local hrp = Character:FindFirstChild("HumanoidRootPart")
	if hrp then
		oldCFrame = hrp.CFrame
	end

	-- Avatar aksesuarları ve kıyafet tanımını çek
	local desc = nil
	pcall(function()
		desc = Players:GetHumanoidDescriptionFromUserId(LocalPlayer.UserId)
	end)

	if not desc then
		pcall(function()
			desc = Humanoid:GetAppliedDescription()
		end)
	end

	-- İstemci tarafında yeni Rig modelini oluştur
	local newModel
	if desc then
		pcall(function()
			newModel = Players:CreateHumanoidModelFromDescription(desc, currentEnum)
		end)
	end

	if not newModel then
		newModel = Instance.new("Model")
		local newHum = Instance.new("Humanoid")
		newHum.RigType = currentEnum
		newHum.Parent = newModel
	end

	newModel.Name = LocalPlayer.Name

	-- Eski karakteri kaldır ve yeni karakteri tanımla
	if oldCFrame and newModel:FindFirstChild("HumanoidRootPart") then
		newModel:SetPrimaryPartCFrame(oldCFrame)
	end

	Character:Destroy()
	newModel.Parent = workspace
	LocalPlayer.Character = newModel

	local camera = workspace.CurrentCamera
	if camera then
		local newHum = newModel:FindFirstChildOfClass("Humanoid")
		if newHum then
			camera.CameraSubject = newHum
		end
	end

	Character = newModel
	Humanoid = newModel:WaitForChild("Humanoid")

	if RigInfo then
		RigInfo.Text = (targetRigType == "R6") and "R6" or "R15"
	end
end

