-- ServerScriptService > Script (isim: AdminServer)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

--// AYARLAR //--
local ADMIN_USERNAMES = {
	["Syn_x8"] = true,
}

-- UserId ile de kontrol edebilmek için (username değişse bile çalışır).
-- Syn_x8'in UserId'sini biliyorsan buraya ekle, bilmiyorsan boş bırakabilirsin.
local ADMIN_USERIDS = {
	-- [123456789] = true,
}

local DEFAULT_WALKSPEED = 16
local DEFAULT_JUMPPOWER = 50
local MAX_WALKSPEED = 500
local MAX_JUMPPOWER = 500

--// REMOTE KURULUMU //--
local remotesFolder = ReplicatedStorage:FindFirstChild("AdminRemotes")
if not remotesFolder then
	remotesFolder = Instance.new("Folder")
	remotesFolder.Name = "AdminRemotes"
	remotesFolder.Parent = ReplicatedStorage
end

local function getOrCreateRemote(name)
	local r = remotesFolder:FindFirstChild(name)
	if not r then
		r = Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = remotesFolder
	end
	return r
end

local CommandRemote = getOrCreateRemote("AdminCommand") -- Client -> Server (komut)
local StateRemote = getOrCreateRemote("AdminState")     -- Server -> Client (yetki/durum bilgisi)

--// DURUM TAKİBİ //--
-- Her admin oyuncu için ayrı state (godmode açık mı, hız/jump ne, freeze edilenler vs.)
local adminStates = {} -- [player] = { godmode = bool, speed = num, jump = num }
local frozenPlayers = {} -- [player] = true  (freeze edilen KURBAN, admin değil)
local frozenWalkspeedCache = {} -- freeze öncesi hızını geri yüklemek için

--// YARDIMCI FONKSİYONLAR //--

local function isAdmin(player)
	if not player then return false end
	if ADMIN_USERNAMES[player.Name] then return true end
	if ADMIN_USERIDS[player.UserId] then return true end
	return false
end

local function safeGetHumanoid(player)
	local char = player.Character
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	return hum
end

local function safeGetRoot(player)
	local char = player.Character
	if not char then return nil end
	return char:FindFirstChild("HumanoidRootPart")
end

local function ensureAdminState(player)
	if not adminStates[player] then
		adminStates[player] = {
			godmode = false,
			speed = DEFAULT_WALKSPEED,
			jump = DEFAULT_JUMPPOWER,
		}
	end
	return adminStates[player]
end

local function applyGodmode(player, enabled)
	local hum = safeGetHumanoid(player)
	if not hum then return end

	local state = ensureAdminState(player)
	state.godmode = enabled

	if enabled then
		hum.MaxHealth = math.huge
		hum.Health = math.huge
		-- Zaten yaşıyorsa can barını da senkron tut
		hum.HealthChanged:Connect(function()
			if state.godmode and hum.Health < hum.MaxHealth then
				hum.Health = hum.MaxHealth
			end
		end)
	else
		hum.MaxHealth = 100
		hum.Health = 100
	end
end

local function applySpeed(player, speed)
	speed = math.clamp(tonumber(speed) or DEFAULT_WALKSPEED, 0, MAX_WALKSPEED)
	local hum = safeGetHumanoid(player)
	local state = ensureAdminState(player)
	state.speed = speed
	if hum then
		hum.WalkSpeed = speed
	end
end

local function applyJump(player, jump)
	jump = math.clamp(tonumber(jump) or DEFAULT_JUMPPOWER, 0, MAX_JUMPPOWER)
	local hum = safeGetHumanoid(player)
	local state = ensureAdminState(player)
	state.jump = jump
	if hum then
		hum.UseJumpPower = true
		hum.JumpPower = jump
	end
end

-- Karakter her yeniden spawn olduğunda admin ayarlarını tekrar uygula
local function onCharacterAdded(player, char)
	if not isAdmin(player) then return end
	local state = ensureAdminState(player)

	local hum = char:WaitForChild("Humanoid", 5)
	if not hum then return end

	task.defer(function()
		if state.godmode then
			applyGodmode(player, true)
		end
		applySpeed(player, state.speed)
		applyJump(player, state.jump)
	end)
end

local function findTargetPlayer(nameQuery)
	if not nameQuery or nameQuery == "" then return nil end
	nameQuery = string.lower(nameQuery)

	-- Önce tam eşleşme
	for _, p in ipairs(Players:GetPlayers()) do
		if string.lower(p.Name) == nameQuery then
			return p
		end
	end
	-- Sonra kısmi eşleşme (ör: "syn" yazınca Syn_x8'i bulsun)
	for _, p in ipairs(Players:GetPlayers()) do
		if string.find(string.lower(p.Name), nameQuery, 1, true) then
			return p
		end
	end
	return nil
end

--// HEDEF ÜZERİNDE KOMUTLAR //--

local function doKick(admin, target)
	if not target then return end
	target:Kick("Sunucu yöneticisi tarafından atıldın.")
end

local function doKill(admin, target)
	local hum = safeGetHumanoid(target)
	if hum then
		hum.Health = 0
	end
end

local function doBring(admin, target)
	local adminRoot = safeGetRoot(admin)
	local targetRoot = safeGetRoot(target)
	if not adminRoot or not targetRoot then return end
	targetRoot.CFrame = adminRoot.CFrame * CFrame.new(0, 0, -4)
end

local function doGoto(admin, target)
	local adminRoot = safeGetRoot(admin)
	local targetRoot = safeGetRoot(target)
	if not adminRoot or not targetRoot then return end
	adminRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 4)
end

local function doFreeze(admin, target, shouldFreeze)
	local hum = safeGetHumanoid(target)
	local root = safeGetRoot(target)
	if not hum or not root then return end

	if shouldFreeze then
		frozenPlayers[target] = true
		frozenWalkspeedCache[target] = hum.WalkSpeed
		hum.WalkSpeed = 0
		hum.JumpPower = 0
		hum.UseJumpPower = true
		-- Root'u da sabitleyelim ki uçan/knockback exploitlerle kayamasın
		root.Anchored = true
	else
		frozenPlayers[target] = nil
		root.Anchored = false
		hum.WalkSpeed = frozenWalkspeedCache[target] or DEFAULT_WALKSPEED
		hum.UseJumpPower = true
		hum.JumpPower = DEFAULT_JUMPPOWER
		frozenWalkspeedCache[target] = nil
	end
end

local function doView(admin, target)
	-- Admin'in kamerasını hedefin karakterine kilitler (sadece o admin için).
	StateRemote:FireClient(admin, "SetView", target and target.Name or nil)
end

--// GELEN KOMUTLARI İŞLEME (TEK GÜVENLİ KAPI) //--

CommandRemote.OnServerEvent:Connect(function(player, action, payload)
	-- 1) Her komutta admin kontrolü sunucuda tekrar yapılır. İstemciye asla güvenilmez.
	if not isAdmin(player) then
		warn(("[AdminServer] Yetkisiz komut denemesi: %s -> %s"):format(player.Name, tostring(action)))
		return
	end

	if type(action) ~= "string" then return end
	payload = type(payload) == "table" and payload or {}

	if action == "SetGodmode" then
		applyGodmode(player, payload.enabled == true)

	elseif action == "SetSpeed" then
		applySpeed(player, payload.value)

	elseif action == "SetJump" then
		applyJump(player, payload.value)

	elseif action == "TargetAction" then
		local target = findTargetPlayer(payload.targetName)
		local cmd = payload.command

		if not target then
			StateRemote:FireClient(player, "Notify", "Hedef bulunamadı: " .. tostring(payload.targetName))
			return
		end

		-- Adminler birbirine zarar veremesin (istersen bu bloğu kaldırabilirsin)
		if isAdmin(target) and target ~= player and cmd ~= "view" and cmd ~= "goto" then
			StateRemote:FireClient(player, "Notify", target.Name .. " bir admin, bu komut uygulanamaz.")
			return
		end

		if cmd == "kick" then
			doKick(player, target)
		elseif cmd == "kill" then
			doKill(player, target)
		elseif cmd == "bring" then
			doBring(player, target)
		elseif cmd == "goto" then
			doGoto(player, target)
		elseif cmd == "freeze" then
			doFreeze(player, target, true)
		elseif cmd == "unfreeze" then
			doFreeze(player, target, false)
		elseif cmd == "view" then
			doView(player, target)
		elseif cmd == "unview" then
			StateRemote:FireClient(player, "SetView", nil)
		end

		StateRemote:FireClient(player, "Notify", ("%s -> %s uygulandı."):format(cmd, target.Name))
	end
end)

--// OYUNCU BAĞLANTILARI //--

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(char)
		onCharacterAdded(player, char)
	end)

	-- Admin ise, istemci tarafına "sen adminsin, panel açılsın" bilgisini yolla
	if isAdmin(player) then
		ensureAdminState(player)
		task.wait(1) -- LocalScript'in remote'ları dinlemeye başlaması için kısa bekleme
		StateRemote:FireClient(player, "GrantAccess", true)
	end
end)

Players.PlayerRemoving:Connect(function(player)
	adminStates[player] = nil
	frozenPlayers[player] = nil
	frozenWalkspeedCache[player] = nil
end)

-- Zaten sunucuda olan oyuncular için de çalışsın (script sonradan eklenirse)
for _, player in ipairs(Players:GetPlayers()) do
	if isAdmin(player) then
		ensureAdminState(player)
		task.spawn(function()
			task.wait(1)
			StateRemote:FireClient(player, "GrantAccess", true)
		end)
	end
	if player.Character then
		onCharacterAdded(player, player.Character)
	end
	player.CharacterAdded:Connect(function(char)
		onCharacterAdded(player, char)
	end)
end