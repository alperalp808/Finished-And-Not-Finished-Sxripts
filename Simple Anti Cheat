	local targetRoot = victimCharacter:FindFirstChild("HumanoidRootPart") or victimCharacter:FindFirstChild("Torso") or victimCharacter:FindFirstChild("UpperTorso") or victimCharacter:FindFirstChildOfClass("BasePart")
	if not targetRoot then return end

	local attackDirection = Vector3.new(0, 0, -1)
	if killerPlayer and killerPlayer.Character then
		local killerRoot = killerPlayer.Character:FindFirstChild("HumanoidRootPart") or killerPlayer.Character:FindFirstChild("Torso")
		if killerRoot then
			attackDirection = killerRoot.CFrame.LookVector
		end
	end

	PlayServerSound(GOLD_TRANSFORM_SOUND_ID, targetRoot, 4)
	SpawnGoldenBurstOnTarget(targetRoot)

	for _, item in ipairs(victimCharacter:GetChildren()) do
		if item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") then
			item:Destroy()
		end
	end

	local basePart = targetRoot

	for _, desc in ipairs(victimCharacter:GetDescendants()) do
		if desc:IsA("BasePart") then
			desc.Color = GOLD_COLOR
			desc.Material = GOLD_MATERIAL
			desc.Reflectance = GOLD_REFLECTANCE

			if desc:IsA("MeshPart") then
				desc.TextureID = ""
			end

			for _, child in ipairs(desc:GetChildren()) do
				if child:IsA("Decal") or child:IsA("Texture") then
					child:Destroy()
				elseif child:IsA("SpecialMesh") then
					child.TextureId = ""
				end
			end

			if desc ~= basePart then
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = basePart
				weld.Part1 = desc
				weld.Parent = basePart
			end

		elseif desc:IsA("Accessory") then
			for _, accDesc in ipairs(desc:GetDescendants()) do
				if accDesc:IsA("BasePart") then
					accDesc.Color = GOLD_COLOR
					accDesc.Material = GOLD_MATERIAL
					accDesc.Reflectance = GOLD_REFLECTANCE

					if accDesc:IsA("MeshPart") then
						accDesc.TextureID = ""
					end
				elseif accDesc:IsA("SpecialMesh") then
					accDesc.TextureId = ""
				elseif accDesc:IsA("Decal") or accDesc:IsA("Texture") then
					accDesc:Destroy()
				end
			end
		end
	end

	basePart.AssemblyLinearVelocity = (attackDirection * 65) + Vector3.new(0, 20, 0)
	basePart.AssemblyAngularVelocity = Vector3.new(
		math.random(-5, 5),
		math.random(-5, 5),
		math.random(-5, 5)
	)

	Debris:AddItem(victimCharacter, 8)
end

-- 7. HELLFIRE
EffectHandlers["HellFire"] = function(victimCharacter, killerPlayer)
	if not victimCharacter or victimCharacter:GetAttribute("DivineDeathActive") then return end
	victimCharacter:SetAttribute("DivineDeathActive", true)

	local hrp = victimCharacter:FindFirstChild("HumanoidRootPart")
	local targetRoot = hrp or victimCharacter:FindFirstChild("Torso")
	local targetHum = victimCharacter:FindFirstChildOfClass("Humanoid")

	local attackerChar = killerPlayer and killerPlayer.Character
	local attackerRoot = attackerChar and (
		attackerChar:FindFirstChild("HumanoidRootPart") or attackerChar:FindFirstChild("Torso")
	)

	if targetHum then
		targetHum.BreakJointsOnDeath = false
		targetHum.PlatformStand = true
	end

	if targetRoot then
		PlayServerSound(HELLFIRE_KILL_SOUND_ID, targetRoot, 1.5)
	end

	for _, child in ipairs(victimCharacter:GetChildren()) do
		if child:IsA("Accessory") or child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic") or child:IsA("BodyColors") then
			child:Destroy()
		end
	end

	local head = victimCharacter:FindFirstChild("Head")
	if head then
		for _, item in ipairs(head:GetChildren()) do
			if item:IsA("Decal") then
				item:Destroy()
			end
		end
	end

	EnsureRootAttached(victimCharacter)

	if not BuildR6Ragdoll(victimCharacter) and hrp then
		WeldPartsToRoot(victimCharacter, hrp)
	end

	if hrp then
		hrp.CanCollide = false
	end

	TakeServerPhysicsOwnership(victimCharacter)

	if targetRoot then
		local pushDirection = Vector3.new(0, 1, 0)
		if attackerRoot then
			local delta = targetRoot.Position - attackerRoot.Position
			if delta.Magnitude > 0.001 then
				pushDirection = delta.Unit
			else
				pushDirection = attackerRoot.CFrame.LookVector
			end
		end

		local throwVelocity = (pushDirection * 40) + Vector3.new(0, 30, 0)
		for _, child in ipairs(victimCharacter:GetDescendants()) do
			if child:IsA("BasePart") then
				child.AssemblyLinearVelocity = throwVelocity
				child.AssemblyAngularVelocity = Vector3.new(
					math.random(-8, 8),
					math.random(-8, 8),
					math.random(-8, 8)
				)
			end
		end
	end

	if targetRoot then
		local fire = Instance.new("Fire")
		fire.Name = "DivineDeathFire"
		fire.Color = Color3.fromRGB(255, 0, 0)
		fire.SecondaryColor = Color3.fromRGB(255, 100, 0)
		fire.Size = 14
		fire.Heat = 25
		fire.Parent = targetRoot
	end

	local partsToFade = {}
	for _, child in ipairs(victimCharacter:GetDescendants()) do
		if child:IsA("BasePart") and child ~= hrp then
			child.CanCollide = true
			child.Color = Color3.fromRGB(255, 40, 40)
			child.Material = Enum.Material.Neon
			child.Transparency = 0.4
			table.insert(partsToFade, child)
		end
	end

	task.delay(HELLFIRE_LIFT_DELAY, function()
		if not targetRoot or not targetRoot.Parent then return end

		local liftAttachment = Instance.new("Attachment")
		liftAttachment.Name = "DivineLiftAttachment"
		liftAttachment.Parent = targetRoot

		local lift = Instance.new("LinearVelocity")
		lift.Name = "DivineLiftPower"
		lift.Attachment0 = liftAttachment
		lift.RelativeTo = Enum.ActuatorRelativeTo.World
		lift.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
		lift.ForceLimitMode = Enum.ForceLimitMode.Magnitude
		lift.MaxForce = 30000
		lift.VectorVelocity = targetRoot.AssemblyLinearVelocity
		lift.Parent = targetRoot

		TweenService:Create(
			lift,
			TweenInfo.new(
				0.6,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.Out
			),
			{
				VectorVelocity = Vector3.new(
					0,
					HELLFIRE_LIFT_SPEED,
					0
				)
			}
		):Play()

		local fadeDuration, steps = 3.8, 38
		for i = 1, steps do
			task.wait(fadeDuration / steps)
			local alpha = i / steps
			for _, part in ipairs(partsToFade) do
				if part and part.Parent then
					part.Transparency = math.clamp(
						0.4 + (alpha * 0.6),
						0.4,
						1
					)
				end
			end
		end
	end)

	Debris:AddItem(victimCharacter, HELLFIRE_LIFETIME)
end

-- 8. BLACK HOLE
EffectHandlers["BlackHole"] = function(victimCharacter, killerPlayer)
	if not victimCharacter or victimCharacter:GetAttribute("IsBlackHoleTransformed") then return end
	victimCharacter:SetAttribute("IsBlackHoleTransformed", true)

	local hrp = victimCharacter:FindFirstChild("HumanoidRootPart")
	local head = victimCharacter:FindFirstChild("Head")
	local humanoid = victimCharacter:FindFirstChildOfClass("Humanoid")

	if not hrp then
		victimCharacter:SetAttribute("KilledByDivineAxe", true)
		Debris:AddItem(victimCharacter, 2)
		return
	end

	local headPosition = (head and head:IsA("BasePart")) and head.Position or (hrp.Position + Vector3.new(0, 1.5, 0))
	local holePosition = headPosition + Vector3.new(0, BLACKHOLE_HEIGHT_ABOVE_HEAD, 0)

	if humanoid then
		humanoid.BreakJointsOnDeath = false
		humanoid.PlatformStand = true
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	end

	EnsureRootAttached(victimCharacter)
	ReattachAccessories(victimCharacter)

	local ragdollBuilt = BuildR6Ragdoll(victimCharacter)
	if not ragdollBuilt then
		WeldPartsToRoot(victimCharacter, hrp)
	end

	for _, part in ipairs(victimCharacter:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = false
		end
	end

	victimCharacter:SetAttribute("KilledByDivineAxe", true)

	local holdAttachment = Instance.new("Attachment")
	holdAttachment.Name = "BlackHoleHoldAttachment"
	holdAttachment.Parent = hrp

	local startPosition = hrp.Position
	local endPosition = holePosition + Vector3.new(0, BLACKHOLE_SWALLOW_DEPTH, 0)

	local startRotation = hrp.CFrame.Rotation
	local look = hrp.CFrame.LookVector
	local baseYaw = math.atan2(-look.X, -look.Z)
	local phase = math.random() * math.pi * 2

	local alignPosition = Instance.new("AlignPosition")
	alignPosition.Name = "BlackHoleHoldPosition"
	alignPosition.Mode = Enum.PositionAlignmentMode.OneAttachment
	alignPosition.Attachment0 = holdAttachment
	alignPosition.Position = startPosition
	alignPosition.ApplyAtCenterOfMass = true
	alignPosition.RigidityEnabled = false
	alignPosition.MaxForce = 400000
	alignPosition.MaxVelocity = 40
	alignPosition.Responsiveness = 18
	alignPosition.Parent = hrp

	local alignOrientation = Instance.new("AlignOrientation")
	alignOrientation.Name = "BlackHoleHoldOrientation"
	alignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	alignOrientation.Attachment0 = holdAttachment
	alignOrientation.CFrame = startRotation
	alignOrientation.RigidityEnabled = false
	alignOrientation.MaxTorque = 100000
	alignOrientation.MaxAngularVelocity = 8
	alignOrientation.Responsiveness = 15
	alignOrientation.Parent = hrp

	local limbForces = {}
	if ragdollBuilt then
		for _, info in ipairs(RAGDOLL_JOINTS) do
			local limb = victimCharacter:FindFirstChild(info.limb)
			if limb and limb:IsA("BasePart") then
				local attachment = Instance.new("Attachment")
				attachment.Name = "BlackHolePullAttachment"
				attachment.Parent = limb

				local force = Instance.new("VectorForce")
				force.Name = "BlackHolePull"
				force.Attachment0 = attachment
				force.RelativeTo = Enum.ActuatorRelativeTo.World
				force.ApplyAtCenterOfMass = true
				force.Force = Vector3.zero
				force.Parent = limb

				table.insert(limbForces, {
					part = limb,
					force = force,
					mass = limb.AssemblyMass
				})
			end
		end
	end

	TakeServerPhysicsOwnership(victimCharacter)

	local swallowDistance = BLACKHOLE_HORIZON_RADIUS * 1.15
	local fadeStartDistance = BLACKHOLE_HORIZON_RADIUS * 3.4

	local fadeEntries = {}
	for _, obj in ipairs(victimCharacter:GetDescendants()) do
		if obj:IsA("BasePart") and obj ~= hrp then
			if obj.Transparency < 1 then
				table.insert(fadeEntries, {
					inst = obj,
					part = obj,
					base = obj.Transparency,
					swallowed = false
				})
			end
		elseif obj:IsA("Decal") and obj.Transparency < 1 then
			local ownerPart = obj.Parent
			if ownerPart and ownerPart:IsA("BasePart") then
				table.insert(fadeEntries, {
					inst = obj,
					part = ownerPart,
					base = obj.Transparency,
					swallowed = false
				})
			end
		end
	end

	local strip = Instance.new("ParticleEmitter")
	strip.Name = "BlackHoleMatterStrip"
	strip.Texture = "rbxassetid://258122325"
	strip.Color = ColorSequence.new(
		Color3.fromRGB(255, 150, 60),
		Color3.fromRGB(150, 60, 255)
	)
	strip.LightEmission = 0.8
	strip.LightInfluence = 0
	strip.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.55),
		NumberSequenceKeypoint.new(1, 0),
	})
	strip.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(1, 1),
	})
	strip.Lifetime = NumberRange.new(0.5, 0.9)
	strip.Speed = NumberRange.new(1, 3)
	strip.Acceleration = Vector3.new(0, 35, 0)
	strip.SpreadAngle = Vector2.new(60, 60)
	strip.Rate = 0
	strip.Parent = hrp

	local hole = CreateBlackHole(holePosition)
	PlayServerSound(
		BLACKHOLE_SPAWN_SOUND_ID,
		hole.Core,
		2
	)
	hole.Grow(BLACKHOLE_GROW_TIME)

	Debris:AddItem(
		victimCharacter,
		BLACKHOLE_PULL_DELAY + BLACKHOLE_PULL_DURATION + 4
	)

	task.spawn(function()
		task.wait(BLACKHOLE_PULL_DELAY)
		hole.Intensify(BLACKHOLE_PULL_DURATION)

		local startTime = os.clock()

		while true do
			if not victimCharacter.Parent or not hrp.Parent then break end

			local elapsed = os.clock() - startTime
			local progress = math.clamp(
				elapsed / BLACKHOLE_PULL_DURATION,
				0,
				1
			)
			local ease = 0.25 * progress + 0.75 * progress * progress

			local swirlAngle = phase + elapsed * (1.2 + 3.5 * ease)
			local swirlRadius = BLACKHOLE_SPIRAL_RADIUS * (1 - ease) * math.min(1, elapsed / 0.6)

			alignPosition.Position = startPosition:Lerp(
				endPosition,
				ease
			) + Vector3.new(
				math.cos(swirlAngle),
				0,
				math.sin(swirlAngle)
			) * swirlRadius

			local settle = math.min(1, elapsed / 0.8)
			local spin = elapsed * 0.9 + 4.5 * ease * ease

			local targetRotation = CFrame.Angles(
				0,
				baseYaw + spin,
				0
			) * CFrame.Angles(
				math.sin(elapsed * 1.7 + phase) * 0.1,
				0,
				math.sin(elapsed * 1.3 + phase) * 0.1
			)

			alignOrientation.CFrame = startRotation:Lerp(
				targetRotation,
				settle
			)

			local pullFactor = 0.25 + 1.4 * ease
			for _, entry in ipairs(limbForces) do
				if entry.part.Parent and entry.force.Parent then
					local toHole = holePosition - entry.part.Position
					if toHole.Magnitude > 0.05 then
						entry.force.Force = toHole.Unit * entry.mass * workspace.Gravity * pullFactor
					end
				end
			end

			for _, entry in ipairs(fadeEntries) do
				if not entry.swallowed and entry.inst.Parent and entry.part.Parent then
					local distance = (
						entry.part.Position - holePosition
					).Magnitude

					if distance <= swallowDistance then
						entry.swallowed = true
						entry.inst.Transparency = 1
					elseif distance < fadeStartDistance then
						local t = 1 - (
							distance - swallowDistance
						) / (
							fadeStartDistance - swallowDistance
						)
						t = t * t * (3 - 2 * t)
						entry.inst.Transparency = entry.base + (1 - entry.base) * t
					end
				end
			end

			strip.Rate = 8 + 55 * ease

			if progress >= 1 then break end
			RunService.Heartbeat:Wait()
		end

		strip.Enabled = false

		for _, entry in ipairs(fadeEntries) do
			if entry.inst.Parent then
				entry.inst.Transparency = 1
			end
		end

		hole.Pulse()
		task.wait(0.15)

		if victimCharacter.Parent then
			victimCharacter:Destroy()
		end

		task.wait(0.25)
		hole.Collapse(BLACKHOLE_COLLAPSE_TIME)
	end)
end

