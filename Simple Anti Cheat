local function makeStatRow(parent, label, order, defaultValue, min, max, onChange)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, 34)
	row.BackgroundTransparency = 1
	row.LayoutOrder = order
	row.Parent = parent

	local lbl = Instance.new("TextLabel")
	lbl.BackgroundTransparency = 1
	lbl.Size = UDim2.new(0.42, 0, 1, 0)
	lbl.Font = Enum.Font.Gotham
	lbl.TextSize = 14
	lbl.TextColor3 = COLOR_TEXT
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Text = label
	lbl.Parent = row

	local minusBtn = Instance.new("TextButton")
	minusBtn.Size = UDim2.fromOffset(24, 24)
	minusBtn.Position = UDim2.new(0.42, 0, 0.5, -12)
	minusBtn.BackgroundColor3 = COLOR_BG
	minusBtn.Font = Enum.Font.GothamBold
	minusBtn.TextSize = 16
	minusBtn.TextColor3 = COLOR_TEXT
	minusBtn.Text = "-"
	minusBtn.AutoButtonColor = true
	minusBtn.Parent = row
	corner(minusBtn, 6)

	local box = Instance.new("TextBox")
	box.Size = UDim2.fromOffset(52, 24)
	box.Position = UDim2.new(0.42, 30, 0.5, -12)
	box.BackgroundColor3 = COLOR_BG
	box.Font = Enum.Font.GothamBold
	box.TextSize = 14
	box.TextColor3 = COLOR_ACCENT
	box.Text = tostring(defaultValue)
	box.ClearTextOnFocus = false
	box.Parent = row
	corner(box, 6)

	local plusBtn = Instance.new("TextButton")
	plusBtn.Size = UDim2.fromOffset(24, 24)
	plusBtn.Position = UDim2.new(0.42, 88, 0.5, -12)
	plusBtn.BackgroundColor3 = COLOR_BG
	plusBtn.Font = Enum.Font.GothamBold
	plusBtn.TextSize = 16
	plusBtn.TextColor3 = COLOR_TEXT
	plusBtn.Text = "+"
	plusBtn.Parent = row
	corner(plusBtn, 6)

	local currentValue = defaultValue

	local function commit(newVal)
		newVal = math.clamp(tonumber(newVal) or currentValue, min, max)
		currentValue = newVal
		box.Text = tostring(newVal)
		onChange(newVal)
	end

	minusBtn.MouseButton1Click:Connect(function()
		commit(currentValue - (max > 100 and 10 or 4))
	end)
	plusBtn.MouseButton1Click:Connect(function()
		commit(currentValue + (max > 100 and 10 or 4))
	end)
	box.FocusLost:Connect(function(enterPressed)
		commit(box.Text)
	end)

	return row
end

