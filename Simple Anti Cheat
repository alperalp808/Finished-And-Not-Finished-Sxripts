--[[
	Sword - Script (SERVER)
	Tüm hasar hesaplaması ve doğrulaması burada yapılır.
	İstemci (LocalScript) sadece "saldırdım" bilgisini gönderir;
	gerçek hasar, dokunma kontrolü ve zamanlama tamamen sunucu otoritesindedir.
]]

local Tool = script.Parent
local Handle = Tool:WaitForChild("Handle")

local Players = game:GetService("Players")
local Debris = game:GetService("Debris")

--// RemoteEvent: istemci "saldırdım" (Slash/Lunge) bilgisini buraya gönderir
local AttackRemote = Tool:FindFirstChild("AttackRemote")
if not AttackRemote then
	AttackRemote = Instance.new("RemoteEvent")
	AttackRemote.Name = "AttackRemote"
	AttackRemote.Parent = Tool
end

local DamageValues = {
	Slash = 10,
	Lunge = 30,
}

-- Sunucu tarafı cooldown: istemci ne gönderirse göndersin, bu limitlerin altına inemez
local Cooldowns = {
	Slash = 0.5, -- iki slash arası minimum süre
	Lunge = 1.0, -- iki lunge arası minimum süre
}

local Grips = {
	Up = CFrame.new(0, 0, -1.70000005, 0, 0, 1, 1, 0, 0, 0, 1, 0),
	Out = CFrame.new(0, 0, -1.70000005, 0, 1, 0, 1, -0, 0, 0, 0, -1),
}

local ToolEquipped = false
local Character, Player, Humanoid, Torso

local LastAttackType = nil
local LastAttackTime = {
	Slash = 0,
	Lunge = 0,
}

-- Aktif saldırı penceresi: sadece bu süre içindeki dokunuşlar hasar verir.
-- Bu, "aktive ol, animasyon bitince de vurmaya devam et" hilesini engeller.
local CurrentDamage = 0
local AttackWindowEndsAt = 0

local function IsTeamMate(Player1, Player2)
	return Player1
		and Player2
		and not Player1.Neutral
		and not Player2.Neutral
		and Player1.TeamColor == Player2.TeamColor
end

local function TagHumanoid(humanoid, player)
	local CreatorTag = Instance.new("ObjectValue")
	CreatorTag.Name = "creator"
	CreatorTag.Value = player
	Debris:AddItem(CreatorTag, 2)
	CreatorTag.Parent = humanoid
end

local function UntagHumanoid(humanoid)
	for _, v in ipairs(humanoid:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "creator" then
			v:Destroy()
		end
	end
end

local function CheckIfAlive()
	return Player
		and Player.Parent
		and Character
		and Character.Parent
		and Humanoid
		and Humanoid.Parent
		and Humanoid.Health > 0
		and Torso
		and Torso.Parent
end

--// Handle bir şeye değdiğinde çalışır — GERÇEK hasar burada verilir
local function OnTouched(Hit)
	if not Hit or not Hit.Parent or not CheckIfAlive() or not ToolEquipped then
		return
	end

	-- Saldırı penceresi dışındaysa (yani oyuncu aktive etmeden Handle bir şeye değdiyse) hasar yok
	if os.clock() > AttackWindowEndsAt or CurrentDamage <= 0 then
		return
	end

	local RightArm = Character:FindFirstChild("Right Arm")
	if not RightArm then
		return
	end
	local RightGrip = RightArm:FindFirstChild("RightGrip")
	if not RightGrip or (RightGrip.Part0 ~= Handle and RightGrip.Part1 ~= Handle) then
		return
	end

	local hitCharacter = Hit.Parent
	if hitCharacter == Character then
		return
	end

	local hitHumanoid = hitCharacter:FindFirstChildOfClass("Humanoid")
	if not hitHumanoid or hitHumanoid.Health == 0 then
		return
	end

	local hitPlayer = Players:GetPlayerFromCharacter(hitCharacter)
	if hitPlayer and (hitPlayer == Player or IsTeamMate(Player, hitPlayer)) then
		return
	end

	UntagHumanoid(hitHumanoid)
	TagHumanoid(hitHumanoid, Player)
	hitHumanoid:TakeDamage(CurrentDamage)

	-- Bir vuruş yeterli: aynı saldırıyla iki kez dokunup çift hasar vermeyi engelle
	CurrentDamage = 0
end

--// İstemciden "saldırdım" sinyali geldiğinde çalışır
-- Burada asıl iş: istemcinin dediğini KÖRÜ KÖRÜNE onaylamamak.
-- Cooldown, canlılık ve ekipli olma durumu sunucuda tekrar kontrol edilir.
local function OnAttackRequested(player, attackType)
	if player ~= Player then
		return -- bu tool'un sahibi değilse yok say
	end
	if not CheckIfAlive() or not ToolEquipped then
		return
	end
	if attackType ~= "Slash" and attackType ~= "Lunge" then
		return
	end

	local now = os.clock()
	local cooldown = Cooldowns[attackType]
	if (now - LastAttackTime[attackType]) < cooldown then
		-- İstemci cooldown'u aşmaya çalışıyor (hile veya gecikme) — reddet
		return
	end
	LastAttackTime[attackType] = now

	if attackType == "Slash" then
		CurrentDamage = DamageValues.Slash
		AttackWindowEndsAt = now + 0.4 -- slash animasyonunun etkili vuruş penceresi
	elseif attackType == "Lunge" then
		CurrentDamage = DamageValues.Lunge
		AttackWindowEndsAt = now + 0.6 -- lunge biraz daha uzun sürer

		task.delay(0.2, function()
			if CheckIfAlive() and ToolEquipped then
				Tool.Grip = Grips.Out
			end
		end)
		task.delay(0.8, function()
			if CheckIfAlive() and ToolEquipped then
				Tool.Grip = Grips.Up
			end
		end)
	end
end

local function Equipped()
	Character = Tool.Parent
	Player = Players:GetPlayerFromCharacter(Character)
	Humanoid = Character:FindFirstChildOfClass("Humanoid")
	Torso = Character:FindFirstChild("Torso")

	if not CheckIfAlive() then
		return
	end

	ToolEquipped = true
end

local function Unequipped()
	Tool.Grip = Grips.Up
	ToolEquipped = false
	CurrentDamage = 0
end

Tool.Equipped:Connect(Equipped)
Tool.Unequipped:Connect(Unequipped)
Handle.Touched:Connect(OnTouched)
AttackRemote.OnServerEvent:Connect(OnAttackRequested)

Tool.Grip = Grips.Up
