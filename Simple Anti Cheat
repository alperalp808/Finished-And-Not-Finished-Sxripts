local panelOpen = false

local function setPanelOpen(open, instant)
	panelOpen = open
	if open then
		mainFrame.Visible = true
	end

	local goalSize = open and UDim2.fromOffset(760, 300) or UDim2.fromOffset(0, 0)
	local goalTransparency = open and 0.12 or 1

	if instant then
		mainFrame.Size = goalSize
		mainFrame.BackgroundTransparency = goalTransparency
		mainFrame.Visible = open
	else
		local tween = TweenService:Create(
			mainFrame,
			TweenInfo.new(0.32, Enum.EasingStyle.Back, open and Enum.EasingDirection.Out or Enum.EasingDirection.In),
			{Size = goalSize, BackgroundTransparency = goalTransparency}
		)
		tween:Play()
		if not open then
			tween.Completed:Connect(function()
				if not panelOpen then
					mainFrame.Visible = false
				end
			end)
		end
	end

	TweenService:Create(toggleIcon, TweenInfo.new(0.25), {
		Rotation = open and 45 or 0
	}):Play()
end

