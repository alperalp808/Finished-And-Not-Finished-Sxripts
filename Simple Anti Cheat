--// YARDIMCI FONKSİYONLAR //--

-- R15 karakterin Avatar Joint Upgrade (yeni sistem) mi yoksa klasik Motor6D mi kullandığını tespit eder.
local function usesAvatarJointUpgrade(character)
	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant:IsA("AnimationConstraint") then
			return true
		end
	end
	return false
end

-- Aksesuarların (saç, şapka, sırt çantası, vb.) ragdoll sırasında vücuttan ayrılıp
-- düşmemesi için Handle'larını sağlam bir WeldConstraint ile en yakın vücut parçasına bağlar.
-- ÖNEMLİ: Mevcut weld'in sınıfına veya konumuna güvenmiyoruz (Weld, Motor6D, WeldConstraint,
-- AccessoryWeld gibi farklı isim/sınıflarda gelebiliyor) — bunun yerine Handle'ın o anki
-- dünya konumuna bakıp fiziksel olarak en yakın ana vücut parçasını buluyoruz.
local function securizeAccessories(character)
	local candidateParts = {}
	local candidateNames = {"Head", "UpperTorso", "LowerTorso", "Torso"}
	for _, name in ipairs(candidateNames) do
		local part = character:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			table.insert(candidateParts, part)
		end
	end

	if #candidateParts == 0 then
		return -- karakterin gövde parçaları bulunamadıysa yapacak bir şey yok
	end

	-- GetDescendants kullanıyoruz ki bir alt klasörde saklı aksesuarları da yakalayalım.
	for _, accessory in ipairs(character:GetDescendants()) do
		if accessory:IsA("Accessory") then
			local handle = accessory:FindFirstChild("Handle")
			if not handle or not handle:IsA("BasePart") then
				continue
			end

			-- Handle'ın altındaki TÜM eski bağlantı türlerini temizle (sınıf ne olursa olsun).
			for _, oldJoint in ipairs(handle:GetChildren()) do
				if oldJoint:IsA("Weld")
					or oldJoint:IsA("Motor6D")
					or oldJoint:IsA("WeldConstraint")
					or oldJoint:IsA("RigidConstraint") then
					oldJoint:Destroy()
				end
			end

			-- Gövde parçalarının içinde bu Handle'a referans veren weld'ler de olabilir
			-- (örneğin Head'in içinde duran bir "HeadWeld"). Onları da bulup temizle.
			for _, otherPart in ipairs(candidateParts) do
				for _, maybeJoint in ipairs(otherPart:GetChildren()) do
					if maybeJoint:IsA("Weld") or maybeJoint:IsA("WeldConstraint") or maybeJoint:IsA("Motor6D") then
						local part0 = maybeJoint.Part0
						local part1 = maybeJoint.Part1
						if part0 == handle or part1 == handle then
							maybeJoint:Destroy()
						end
					end
				end
			end

			-- Handle'ın o anki dünya konumuna en yakın gövde parçasını bul (mesafe hesabıyla).
			local closestPart = nil
			local closestDistance = math.huge
			for _, part in ipairs(candidateParts) do
				local distance = (part.Position - handle.Position).Magnitude
				if distance < closestDistance then
					closestDistance = distance
					closestPart = part
				end
			end

			if not closestPart then
				continue
			end

			-- Yeni, sağlam bir WeldConstraint kur. C0/C1 gerektirmez, iki parçanın
			-- o anki göreceli konumunu otomatik kilitler.
			local secureWeld = Instance.new("WeldConstraint")
			secureWeld.Name = "RagdollAccessoryWeld"
			secureWeld.Part0 = handle
			secureWeld.Part1 = closestPart
			secureWeld.Parent = handle

			-- Handle karakterin geri kalanıyla birlikte çarpışabilir kalsın, ama artık
			-- WeldConstraint pozisyonunu tamamen sabitlediği için ayrı bir cisim gibi
			-- fırlayıp uçamaz.
			handle.CanCollide = false
		end
	end
end

-- R15 - YENİ SİSTEM (AJU): Zaten var olan AnimationConstraint'leri devre dışı bırakıp
-- BallSocketConstraint'lerin fizik kontrolünü almasını sağlar.
local function ragdollR15ViaAJU(character)
	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant:IsA("AnimationConstraint") then
			descendant.Enabled = false
		elseif descendant:IsA("BallSocketConstraint") then
			descendant.Enabled = true
		elseif descendant:IsA("Motor6D") then
			descendant.Enabled = false
		end
	end
end

-- R15 - ESKİ SİSTEM (klasik): Motor6D'leri yok edip yerine BallSocketConstraint kurar.
local function ragdollR15ViaMotor6D(character)
	for _, jointInfo in ipairs(R15_JOINTS) do
		local part0Name, part1Name, att0Name, att1Name = jointInfo[1], jointInfo[2], jointInfo[3], jointInfo[4]

		local part0 = character:FindFirstChild(part0Name)
		local part1 = character:FindFirstChild(part1Name)
		if not (part0 and part1) then
			continue
		end

		local motor = part1:FindFirstChildOfClass("Motor6D")
		if motor and (motor.Part0 == part0 or motor.Part1 == part0) then
			motor:Destroy()
		end

		local att0 = part0:FindFirstChild(att0Name)
		local att1 = part1:FindFirstChild(att1Name)
		if not (att0 and att1) then
			continue
		end

		local socket = Instance.new("BallSocketConstraint")
		socket.Name = "RagdollSocket_" .. part0Name .. "_" .. part1Name
		socket.Attachment0 = att0
		socket.Attachment1 = att1
		socket.LimitsEnabled = true
		socket.TwistLimitsEnabled = true
		socket.Restitution = 0
		socket.Parent = part0
	end
end

-- R6: Attachment'lar karakterde hazır gelmediği için, her Motor6D'nin C0/C1 CFrame'lerinden
-- kendimiz Attachment oluşturup BallSocketConstraint kuruyoruz.
local function ragdollR6(character)
	for _, jointInfo in ipairs(R6_JOINTS) do
		local part0 = character:FindFirstChild(jointInfo.part0)
		local part1 = character:FindFirstChild(jointInfo.part1)
		if not (part0 and part1) then
			continue
		end

		local motor = part1:FindFirstChild(jointInfo.motorName)
			or part0:FindFirstChild(jointInfo.motorName)

		if motor and motor:IsA("Motor6D") then
			motor.Enabled = false
		end

		local att0 = Instance.new("Attachment")
		att0.Name = "RagdollAttachment_" .. jointInfo.motorName .. "_0"
		att0.CFrame = jointInfo.c0
		att0.Parent = part0

		local att1 = Instance.new("Attachment")
		att1.Name = "RagdollAttachment_" .. jointInfo.motorName .. "_1"
		att1.CFrame = jointInfo.c1
		att1.Parent = part1

		local socket = Instance.new("BallSocketConstraint")
		socket.Name = "RagdollSocket_" .. jointInfo.motorName
		socket.Attachment0 = att0
		socket.Attachment1 = att1
		socket.LimitsEnabled = true
		socket.TwistLimitsEnabled = true
		socket.Restitution = 0
		socket.Parent = part0
	end
end

-- Karakteri ragdoll durumuna geçirir: RigType'a bakıp doğru yolu seçer.
local function ragdollCharacter(character, humanoid)
	humanoid.BreakJointsOnDeath = false -- Roblox'un varsayılan "parçala" davranışını engelle
	humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	humanoid.PlatformStand = true
	humanoid.RequiresNeck = false -- R6'da baş kopup gitmesin

	-- Aksesuarları vücuda sağlam şekilde weld'le. Bu, eklemler kırılmadan/devre dışı kalmadan
	-- ÖNCE yapılmalı ki saç/şapka gibi parçalar o an bir "boşluk" yaşamasın.
	securizeAccessories(character)

	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		ragdollR6(character)
	else
		if usesAvatarJointUpgrade(character) then
			ragdollR15ViaAJU(character)
		else
			ragdollR15ViaMotor6D(character)
		end
	end

	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = true
		end
	end
end

-- Karakterin fiziksel olarak "durduğunu" (yere yığılıp sakinleştiğini) tespit eder.
local function waitUntilSettled(character, timeoutSeconds)
	local startTime = os.clock()

	while os.clock() - startTime < timeoutSeconds do
		local maxSpeed = 0

		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				local speed = part.AssemblyLinearVelocity.Magnitude
				if speed > maxSpeed then
					maxSpeed = speed
				end
			end
		end

		if maxSpeed < SETTLE_VELOCITY_THRESHOLD then
			return true
		end

		task.wait(SETTLE_CHECK_INTERVAL)
	end

	return false
end

-- Ragdoll halindeki karakteri klonlar, Dead klasörüne koyar, sabitler ve zamanlayıcıya bağlar.
local function cloneToDeadFolder(character, player)
	if not deadFolder then
		return
	end

	local clone = character:Clone()
	clone.Name = (player and player.Name or character.Name) .. "_Dead"

	-- Önce silinecekleri bir listede topluyoruz, döngü bittikten SONRA yok ediyoruz.
	-- GetDescendants() çağrıldığı andaki sabit bir liste döner; döngü içinde :Destroy() çağırırsak
	-- zincirleme yok etme yüzünden listede sırada bekleyen eleman "nil" haline gelip hataya yol açabilir.
	local toDestroy = {}

	for _, part in ipairs(clone:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
		elseif part:IsA("Constraint") or part:IsA("Motor6D") or part:IsA("Attachment") or part:IsA("Weld") then
			table.insert(toDestroy, part)
		end
	end

	for _, part in ipairs(toDestroy) do
		if part and part.Parent then
			part:Destroy()
		end
	end

	local cloneHumanoid = clone:FindFirstChildOfClass("Humanoid")
	if cloneHumanoid then
		cloneHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		cloneHumanoid.Health = 0
		cloneHumanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	end

	clone.Parent = deadFolder
	Debris:AddItem(clone, DEAD_BODY_LIFETIME)

	return clone
end

--// ÖLÜM İŞLEME AKIŞI //--

local function onCharacterDied(player, character, humanoid)
	if character:GetAttribute("DeathHandled") then
		return
	end
	character:SetAttribute("DeathHandled", true)

	ragdollCharacter(character, humanoid)

	task.spawn(function()
		waitUntilSettled(character, SETTLE_TIMEOUT)

		if not character.Parent then
			return
		end

		cloneToDeadFolder(character, player)
		character:Destroy()

		if player and player.Parent then
			player:LoadCharacter()
		end
	end)
end

local function setupHumanoidTracking(player, character)
	local humanoid = character:WaitForChild("Humanoid", 5)
	if not humanoid then
		return
	end

	character:SetAttribute("DeathHandled", false)

	humanoid.Died:Connect(function()
		onCharacterDied(player, character, humanoid)
	end)
end

--// TÜM OYUNCULARA UYGULAMA (herkes için geçerli, rig tipi ve admin ayrımı yok) //--

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(character)
		setupHumanoidTracking(player, character)
	end)

	if player.Character then
		setupHumanoidTracking(player, player.Character)
	end
end)

for _, player in ipairs(Players:GetPlayers()) do
	if player.Character then
		setupHumanoidTracking(player, player.Character)
	end
	player.CharacterAdded:Connect(function(character)
		setupHumanoidTracking(player, character)
	end)
end