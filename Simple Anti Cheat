local function resetProductCard()
	ProductCard.Visible = false
	PurchaseButton.Visible = false
	PreviewButton.Visible = false
	PreviewStatusLabel.Visible = false
	PreviewStatusLabel.Text = ""
	ProductDescLabel.Visible = false
	ProductThumbnail.Image = ""
	ThumbnailLoadingLabel.Visible = true
	currentProductId = nil
	currentAssetTypeName = nil
end

local function clearPreview()
	if previewInstance then
		previewInstance:Destroy()
		previewInstance = nil
	end
end

local function changeTab(tabName)
	currentTab = tabName
	clearPreview()
	resetProductCard()
	StatusLabel.Visible = false
	IdTextBox.Text = ""

	if tabName == "Home" then
		TitleLabel.Text = "Satın Alma Merkezi"
		BackButton.Visible = false
		HomePage.Visible = true
		PurchasePage.Visible = false
		return
	end

	local config = TAB_CONFIG[tabName]
	if not config then return end

	TitleLabel.Text = config.title
	BackButton.Visible = true
	HomePage.Visible = false
	PurchasePage.Visible = true
	IdTextBox.PlaceholderText = config.placeholder
	PurchaseButton.Text = config.buttonText
end

local function checkTab()
	return currentTab
end

----------------------------------------------------------------
-- ÜRÜN BİLGİSİ GETİRME
----------------------------------------------------------------

local function showStatus(label, message, isError)
	label.Visible = true
	label.Text = message
	label.TextColor3 = isError and COLOR_ERROR or COLOR_SUCCESS
end

local function loadThumbnail(assetId)
	-- Asset thumbnail'i içerik URL formatıyla çekilir
	ProductThumbnail.Image = "rbxthumb://type=Asset&id=" .. tostring(assetId) .. "&w=150&h=150"
	ThumbnailLoadingLabel.Visible = false
end

local function fetchProductInfo()
	local rawId = IdTextBox.Text
	local id = tonumber(rawId)

	StatusLabel.Visible = false
	resetProductCard()
	clearPreview()

	if not id then
		showStatus(StatusLabel, "Lütfen geçerli bir ID girin.", true)
		return
	end

	local config = TAB_CONFIG[currentTab]
	if not config then return end

	FetchButton.Text = "..."
	FetchButton.Active = false

	local ok, info = pcall(function()
		return MarketplaceService:GetProductInfo(id, config.infoType)
	end)

	FetchButton.Text = "Getir"
	FetchButton.Active = true

	if not ok or not info then
		showStatus(StatusLabel, "Ürün bulunamadı. ID'yi kontrol edin.", true)
		return
	end

	currentProductId = id
	currentAssetTypeName = info.AssetTypeName

	-- Kart doldurma
	ProductNameLabel.Text = info.Name or "İsimsiz Ürün"
	ProductCreatorLabel.Text = "👤 " .. (info.Creator and info.Creator.Name or "Bilinmiyor")

	local typeText = info.AssetTypeName or (currentTab == "Gamepass" and "Gamepass") or (currentTab == "Bundle" and "Bundle") or "Ürün"
	ProductTypeLabel.Text = "🏷️ Tip: " .. typeText

	if info.IsForSale == false and info.PriceInRobux == nil then
		ProductPriceLabel.Text = "🚫 Satışta değil"
	elseif info.PriceInRobux and info.PriceInRobux > 0 then
		ProductPriceLabel.Text = "💰 " .. formatNumber(info.PriceInRobux) .. " Robux"
	elseif info.PriceInRobux == 0 then
		ProductPriceLabel.Text = "🎁 Ücretsiz"
	else
		ProductPriceLabel.Text = "💰 Fiyat bilgisi yok"
	end

	if info.Description and info.Description ~= "" then
		ProductDescLabel.Text = info.Description
		ProductDescLabel.Visible = true
	end

	loadThumbnail(id)

	ProductCard.Visible = true
	PurchaseButton.Visible = true

	-- Giyilebilir mi kontrolü (sadece Catalog sekmesinde anlamlı)
	if currentTab == "Catalog" and typeText and WEARABLE_TYPES[typeText] then
		PreviewButton.Visible = true
	end
end

FetchButton.MouseButton1Click:Connect(fetchProductInfo)

IdTextBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		fetchProductInfo()
	end
end)

----------------------------------------------------------------
-- CANLI ÖNİZLEME (Karakterimde Dene)
----------------------------------------------------------------

local function tryPreviewOnCharacter()
	if not currentProductId then return end

	local character = LocalPlayer.Character
	if not character then
		showStatus(PreviewStatusLabel, "Karakter bulunamadı.", true)
		PreviewStatusLabel.Visible = true
		return
	end

	clearPreview()
	PreviewButton.Text = "⏳ Yükleniyor..."
	PreviewButton.Active = false

	local ok, result = pcall(function()
		return InsertService:LoadAsset(currentProductId)
	end)

	PreviewButton.Text = "👗 Karakterimde Dene"
	PreviewButton.Active = true

	if not ok or not result then
		showStatus(PreviewStatusLabel, "Önizleme yüklenemedi. Bu ürün için canlı deneme desteklenmiyor olabilir.", true)
		PreviewStatusLabel.Visible = true
		return
	end

	-- LoadAsset bir Model döndürür, içinde genelde bir Accessory bulunur
	local accessory = result:FindFirstChildWhichIsA("Accessory", true)

	if not accessory then
		result:Destroy()
		showStatus(PreviewStatusLabel, "Bu ürün doğrudan önizlenemiyor (aksesuar bulunamadı).", true)
		PreviewStatusLabel.Visible = true
		return
	end

	accessory.Parent = character
	previewInstance = accessory
	result:Destroy() -- sarmalayıcı modele artık gerek yok

	showStatus(PreviewStatusLabel, "✅ Önizleme takıldı! Beğenmezsen aşağıdan kaldırabilirsin.", false)
	PreviewStatusLabel.Visible = true
	PreviewButton.Text = "🗑️ Önizlemeyi Kaldır"
end

local previewIsOn = false

PreviewButton.MouseButton1Click:Connect(function()
	if previewIsOn then
		clearPreview()
		PreviewButton.Text = "👗 Karakterimde Dene"
		PreviewStatusLabel.Text = "Önizleme kaldırıldı."
		previewIsOn = false
	else
		tryPreviewOnCharacter()
		previewIsOn = (previewInstance ~= nil)
	end
end)

