		{
			BackgroundColor3 =
				Color3.fromRGB(
					235,
					236,
					239
				)
		}

	):Play()

	task.delay(
		0.26,
		function()

			Animating = false

		end
	)
end

local function CloseMenu()

	if not Open or Animating then
		return
	end

	Animating = true
	Open = false

	TweenService:Create(

		Window,

		TweenInfo.new(
			0.18,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.In
		),

		{
			Size =
				UDim2.new(
					Window.Size.X.Scale,
					Window.Size.X.Offset,
					0,
					0
				)
		}

	):Play()

	TweenService:Create(

		SettingsButton,

		TweenInfo.new(
			0.15
		),

		{
			BackgroundColor3 =
				WHITE
		}

	):Play()

	task.delay(
		0.19,
		function()

			if not Open then

				Window.Visible =
					false

			end

			Animating = false

		end
	)
end

SettingsButton.Activated:Connect(function()

	if Open then

		CloseMenu()

	else

		OpenMenu()

	end

end)

--========================================================
-- RESPONSIVE MOBILE
--========================================================

local function UpdateResponsive()

	local Camera =
		workspace.CurrentCamera

	if not Camera then
		return
	end

	local Viewport =
		Camera.ViewportSize

	-- Small Android devices
	if Viewport.X <= 500 then

		local Width =
			math.min(
				Viewport.X - 20,
				390
			)

		local Height =
			math.min(
				Viewport.Y - 80,
				520
			)

		Window.Size =
			UDim2.fromOffset(
				Width,
				Height
			)

	else

		Window.Size =
			UDim2.fromOffset(
				355,
				470
			)

	end
end

--========================================================
-- CAMERA RESIZE
--========================================================

local function ConnectCamera(Camera)

	if not Camera then
		return
	end

	Camera:GetPropertyChangedSignal(
		"ViewportSize"
	):Connect(function()

		UpdateResponsive()

	end)
end

if workspace.CurrentCamera then

	ConnectCamera(
		workspace.CurrentCamera
	)

end

workspace:GetPropertyChangedSignal(
	"CurrentCamera"
):Connect(function()

	if workspace.CurrentCamera then

		ConnectCamera(
			workspace.CurrentCamera
		)

	end
end)

--========================================================
-- INITIALIZE
--========================================================

task.defer(function()

	task.wait(0.3)

	UpdateResponsive()

end)

