-- SATIN ALMA İŞLEMİ
----------------------------------------------------------------

PurchaseButton.MouseButton1Click:Connect(function()
	if not currentProductId then
		showStatus(StatusLabel, "Önce 'Getir' ile ürün bilgisini yükleyin.", true)
		return
	end

	local tab = checkTab()

	local ok, err = pcall(function()
		if tab == "Gamepass" then
			MarketplaceService:PromptGamePassPurchase(LocalPlayer, currentProductId)
		elseif tab == "Bundle" then
			MarketplaceService:PromptBundlePurchase(LocalPlayer, currentProductId)
		elseif tab == "Catalog" then
			MarketplaceService:PromptPurchase(LocalPlayer, currentProductId)
		end
	end)

	if ok then
		showStatus(StatusLabel, "Satın alma penceresi açıldı.", false)
	else
		showStatus(StatusLabel, "Hata: pencere açılamadı.", true)
		warn("[PurchasePanel] PromptPurchase hatası:", err)
	end
end)

