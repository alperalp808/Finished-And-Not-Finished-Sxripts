-- SEKME (TAB) MANTIĞI
----------------------------------------------------------------

-- Şu an hangi kategoridesin ("Home", "Gamepass", "Bundle", "Catalog")
local currentTab = "Home"

local TAB_CONFIG = {
	Gamepass = {
		title = "Gamepass Satın Al",
		icon = "🎫",
		desc = "Gamepass ID'sini aşağıya girin",
		placeholder = "Örn: 12345678",
	},
	Bundle = {
		title = "Bundle Satın Al",
		icon = "📦",
		desc = "Bundle ID'sini aşağıya girin",
		placeholder = "Örn: 96",
	},
	Catalog = {
		title = "Catalog Ürünü Satın Al",
		icon = "👕",
		desc = "Ürün (Asset) ID'sini aşağıya girin",
		placeholder = "Örn: 192557913",
	},
}

local function changeTab(tabName)
	currentTab = tabName

	if tabName == "Home" then
		TitleLabel.Text = "Satın Alma Merkezi"
		BackButton.Visible = false
		HomePage.Visible = true
		PurchasePage.Visible = false
		return
	end

	local config = TAB_CONFIG[tabName]
	if not config then
		return
	end

	TitleLabel.Text = config.title
	BackButton.Visible = true
	HomePage.Visible = false
	PurchasePage.Visible = true

	CategoryIconLabel.Text = config.icon
	CategoryDescLabel.Text = config.desc
	IdTextBox.PlaceholderText = config.placeholder
	IdTextBox.Text = ""
	StatusLabel.Text = ""
end

local function checkTab()
	return currentTab
end

