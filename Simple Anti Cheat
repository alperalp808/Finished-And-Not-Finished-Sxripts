--========================================================
-- FIND CHAT BUTTON
--========================================================

local function FindChatButton()

	local possibleNames = {

		"ChatButton",
		"Chat",
		"ChatWindow",
		"BubbleChat",
		"TextChatService"

	}

	for _, name in ipairs(
		possibleNames
	) do

		local object

		pcall(function()

			object =
				CoreGui:FindFirstChild(
					name,
					true
				)

		end)

		if object
			and object:IsA("GuiButton")
		then

			return object

		end
	end

	-- Genel arama

	local descendants

	pcall(function()

		descendants =
			CoreGui:GetDescendants()

	end)

	if descendants then

		for _, object in ipairs(
			descendants
		) do

			if object:IsA("GuiButton") then

				local name =
					object.Name:lower()

				if
					name:find("chat")
					or
					name:find("textchat")
				then

					return object

				end
			end
		end
	end

	return nil
end

