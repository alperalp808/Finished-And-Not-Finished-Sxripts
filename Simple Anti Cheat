--[[
	Sword - LocalScript (CLIENT)
	R6. Sadece görsel/işitsel taraf: animasyon, ses, grip, sunucuya saldırı sinyali.
	Gerçek hasar ve gerçek cooldown sunucuda (Script) uygulanır — burası sadece
	spam'i ve animasyon çakışmasını önlemek için "gösterge" amaçlı bir kilit tutar.
]]

local Tool = script.Parent
local Handle = Tool:WaitForChild("Handle")
local AttackRemote = Tool:WaitForChild("AttackRemote")

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local Sounds = {
	Slash = Handle:WaitForChild("SwordSlash"),
	-- Unsheath artık burada YOK: sunucudan (Script) çalınıyor ki diğer
	-- oyuncular da duysun. Burada kalsaydı sadece bu oyuncunun ekranında
	-- duyulur, iki kez de çalınmış olurdu.
}

local Grips = {
	Up = CFrame.new(0, 0, -1.70000005, 0, 0, 1, 1, 0, 0, 0, 1, 0),
}

local AnimationIds = {
	Idle = "rbxassetid://127108219798248",
	Slash1 = "rbxassetid://117818478506546",
	Slash2 = "rbxassetid://109267907771703",
	Slash3 = "rbxassetid://79130740691867",
}

-- İstemci tarafı kilit süresi SUNUCUDAKİ ile birebir aynı olmalı.
-- Bu sadece "erken tıklamayı UI/animasyon seviyesinde engellemek" için;
-- gerçek güvenlik sunucudaki ATTACK_COOLDOWN'dan gelir.
local ATTACK_COOLDOWN = 0.6

-- SUNUCUDAKİ COMBO_RESET_TIME ile birebir aynı olmalı. Sadece görsel sırayı
-- (hangi animasyonun oynayacağını) sunucudaki gerçek hasar sırasıyla eşleşik
-- tutmak için; gerçek yetki yine sunucudadır.
local COMBO_RESET_TIME = 2

local Character, Humanoid, Animator
local ToolEquipped = false

local IdleTrack = nil
local CurrentActionTrack = nil -- aynı anda tek bir action track olabilir

-- Her PlaySlashAnim çağrısında bir artan sayı. Track'in "hâlâ güncel" olup
-- olmadığını Stopped event'ine güvenmeden, bu sayıyı karşılaştırarak anlıyoruz.
-- Stopped hiç ateşlenmese, birden fazla ateşlense ya da geç gelse bile
-- bu yöntem etkilenmez.
local ActionGeneration = 0

local SlashIndex = 0
local IsAttacking = false -- kilit: cooldown bitmeden Activated hiçbir şey yapmaz
local LastAttackTick = 0

local function GetOrCreateAnimation(name, id)
	local anim = Tool:FindFirstChild(name)
	if not anim then
		anim = Instance.new("Animation")
		anim.Name = name
		anim.AnimationId = id
		anim.Parent = Tool
	else
		anim.AnimationId = id
	end
	return anim
end

local IdleAnim = GetOrCreateAnimation("IdleAnim", AnimationIds.Idle)
local Slash1Anim = GetOrCreateAnimation("Slash1Anim", AnimationIds.Slash1)
local Slash2Anim = GetOrCreateAnimation("Slash2Anim", AnimationIds.Slash2)
local Slash3Anim = GetOrCreateAnimation("Slash3Anim", AnimationIds.Slash3)

local SlashAnims = { Slash1Anim, Slash2Anim, Slash3Anim }

local function CheckIfAlive()
	return Character
		and Character.Parent
		and Humanoid
		and Humanoid.Parent
		and Humanoid.Health > 0
end

local function PlayIdle()
	if not Animator or not IdleAnim then
		return
	end
	if IdleTrack then
		IdleTrack:Stop()
		IdleTrack:Destroy()
	end
	IdleTrack = Animator:LoadAnimation(IdleAnim)
	IdleTrack.Looped = true
	IdleTrack.Priority = Enum.AnimationPriority.Idle
	IdleTrack:Play(0.2)
end

local function StopIdle()
	if IdleTrack then
		IdleTrack:Stop(0.2)
	end
end

--// Bir slash animasyonunu oynatır. Önceki action track varsa (bitmemiş olsa bile)
-- SIFIR fade ile anında durdurulur — takılma/çakışma buradan geliyordu.
--
-- ÖNEMLİ: Stopped event'ine artık güvenmiyoruz. Bazı durumlarda (animasyon
-- yüklenemedi, R6'da priority çakışması, vs.) Stopped hiç ateşlenmeyebilir ya
-- da beklenmedik anda ateşlenebilir; eski kod bu event'e göre CurrentActionTrack'i
-- temizlediği için, event gelmeyince eski bağlantılar birikip yeniden
-- tetikleniyor, "aynı animasyon tekrar tekrar oynuyor" görüntüsü veriyordu.
-- Bunun yerine her çağrıda bir "nesil" sayısı artırılır; track'i durdurma/temizleme
-- işlemi SADECE bu sayı üzerinden, event beklemeden yapılır.
local function PlaySlashAnim(anim)
	if not Animator then
		return
	end

	-- Bu çağrı yeni bir nesil başlatır. Önceki nesile ait her şey artık geçersiz.
	ActionGeneration += 1
	local myGeneration = ActionGeneration

	if CurrentActionTrack then
		CurrentActionTrack:Stop(0) -- fade yok: eski animasyon anında biter
		CurrentActionTrack:Destroy()
		CurrentActionTrack = nil
	end

	local track = Animator:LoadAnimation(anim)
	track.Priority = Enum.AnimationPriority.Action

	-- KRİTİK: Looped'u açıkça false yapıyoruz. Bir animasyon Studio'da
	-- "Loop" işaretli kaydedilmişse, bu bilgi asset'in içine gömülür ve
	-- AnimationTrack.Looped varsayılan olarak o gömülü değeri kullanır —
	-- kod hiçbir şey söylemezse track sonsuza dek kendini tekrar oynatabilir.
	-- Slash2/Slash3'ün "sürekli tekrar oynaması" tam olarak buydu: o iki
	-- asset loop kaydedilmiş, Slash1 kaydedilmemiş. Bunu burada, Play'den
	-- ÖNCE açıkça kapatarak asset'in kendi ayarından tamamen bağımsız hale
	-- getiriyoruz; Studio tarafında ayrıca düzeltilse de düzeltilmese de
	-- davranış artık garanti.
	track.Looped = false

	track:Play(0) -- fade yok: yeni animasyon anında başlar, gecikme/çakışma olmaz
	CurrentActionTrack = track

	-- Bağlantıyı elde tutup Stopped geldiğinde KENDİMİZ disconnect ediyoruz.
	-- Böylece art arda 3 slash oynatılsa bile en fazla 1 aktif bağlantı kalır,
	-- eskiler hiç birikmez.
	local connection
	connection = track.Stopped:Connect(function()
		connection:Disconnect()
		-- Bu event hâlâ en güncel nesle mi ait, yoksa daha yeni bir slash
		-- zaten başladı mı, sayı ile kontrol ediyoruz — event'in kendisine
		-- güvenmiyoruz, sadece "temizlik zamanı geldi mi" sinyali olarak kullanıyoruz.
		if myGeneration == ActionGeneration and CurrentActionTrack == track then
			CurrentActionTrack = nil
			-- Slash bitti ve üzerine daha yeni bir saldırı binmedi: idle'a dön.
			-- ToolEquipped kontrolü, Unequip sırasında Stopped geç gelirse
			-- idle'ın gereksiz yere yeniden başlamasını engeller.
			if ToolEquipped and CheckIfAlive() then
				PlayIdle()
			end
		end
	end)
end

local function GetNextSlashAnim()
	SlashIndex = (SlashIndex % #SlashAnims) + 1
	return SlashAnims[SlashIndex]
end

--// Görsel saldırı: animasyon + ses + sunucuya sinyal.
local function Attack()
	Sounds.Slash:Play()
	PlaySlashAnim(GetNextSlashAnim())
	AttackRemote:FireServer()
end

--// Tool.Activated her tetiklendiğinde çağrılır.
-- IsAttacking kilidi + zaman kontrolü ile 0.6 saniyeden sık tetiklenemez.
-- Bu, üst üste tıklamada animasyonun spamlanmasını burada, kaynağında keser.
local function Activated()
	if not ToolEquipped or not CheckIfAlive() then
		return
	end

	if IsAttacking then
		return -- önceki saldırı hâlâ "cooldown"da, bu tıklama tamamen yok sayılır
	end

	local now = os.clock()
	local elapsed = now - LastAttackTick

	if elapsed < ATTACK_COOLDOWN then
		return
	end

	-- Son saldırının üzerinden 2 saniyeden fazla geçtiyse combo sıfırlanır:
	-- bir sonraki GetNextSlashAnim() çağrısı Slash1'i döndürür. LastAttackTick
	-- güncellenmeden ÖNCE kontrol ediliyor, aksi halde elapsed hep ~0 olurdu.
	if elapsed >= COMBO_RESET_TIME then
		SlashIndex = 0
	end

	IsAttacking = true
	LastAttackTick = now

	Attack()

	-- Bu saldırıya ait "kimlik". Cooldown bittiğinde, o an CurrentActionTrack'in
	-- hâlâ BU saldırıya ait olup olmadığını (attackGeneration ile) kontrol ediyoruz.
	local attackGeneration = ActionGeneration

	task.delay(ATTACK_COOLDOWN, function()
		IsAttacking = false

		-- Güvenlik ağı: cooldown süresi dolduğunda bu saldırıya ait track'i
		-- KAYITSIZ ŞARTSIZ kapatıyoruz — IsPlaying'e bakmadan. Sebep: "animasyon
		-- 1 kere oynayacak ve bu kadar" kuralı, animasyonun kendi süresi
		-- cooldown'dan uzun olsa bile geçerli olmalı. Sadece bu track hâlâ
		-- BİZİM başlattığımız saldırıya aitse (attackGeneration eşleşiyorsa)
		-- dokunuyoruz — aksi halde araya yeni bir saldırı girmiş demektir,
		-- o zaten kendi cooldown'unda kendi işini yapacak.
		if attackGeneration == ActionGeneration and CurrentActionTrack then
			CurrentActionTrack:Stop(0)
			CurrentActionTrack:Destroy()
			CurrentActionTrack = nil

			if ToolEquipped and CheckIfAlive() and (not IdleTrack or not IdleTrack.IsPlaying) then
				PlayIdle()
			end
		end
	end)
end

local function Equipped()
	Character = Tool.Parent
	Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

	if not Humanoid then
		return
	end

	Animator = Humanoid:FindFirstChildOfClass("Animator")
	if not Animator then
		Animator = Instance.new("Animator")
		Animator.Parent = Humanoid
	end

	if not CheckIfAlive() then
		return
	end

	ToolEquipped = true
	SlashIndex = 0
	IsAttacking = false
	-- Unsheath sesi artık burada çalınmıyor: sunucudaki Equipped() fonksiyonu
	-- çalıyor, böylece diğer oyuncular da duyuyor.
	PlayIdle()
end

local function Unequipped()
	ToolEquipped = false
	IsAttacking = false
	Tool.Grip = Grips.Up
	StopIdle()

	if CurrentActionTrack then
		CurrentActionTrack:Stop(0.1)
		CurrentActionTrack = nil
	end
end

Tool.Activated:Connect(Activated)
Tool.Equipped:Connect(Equipped)
Tool.Unequipped:Connect(Unequipped)

Tool.Grip = Grips.Up
