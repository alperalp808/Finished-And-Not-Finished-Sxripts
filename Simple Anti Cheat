local function ConnectCamera()

	local camera =
		workspace.CurrentCamera

	if not camera then
		return
	end

	camera:GetPropertyChangedSignal(
		"ViewportSize"
	):Connect(function()

		task.defer(function()

			PositionSettingsButton()
			UpdateMenuPosition()

		end)
	end)
end

