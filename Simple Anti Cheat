--========================================================
-- ACCURATE PERFORMANCE (FPS & PING)
--========================================================

local FrameCount = 0
local LastFPSUpdate = os.clock()

RunService.RenderStepped:Connect(function()
	FrameCount += 1
	local now = os.clock()

	if now - LastFPSUpdate >= 0.5 then
		local FPS = FrameCount / (now - LastFPSUpdate)
		FrameCount = 0
		LastFPSUpdate = now

		local ping = 0

		local success, result = pcall(function()
			return math.floor(LocalPlayer:GetNetworkPing() * 2000)
		end)

		if success and result then
			ping = result
		else
			pcall(function()
				local Network = Stats:FindFirstChild("Network")
				if Network then
					local ServerStats = Network:FindFirstChild("ServerStatsItem")
					if ServerStats then
						local DataPing = ServerStats:FindFirstChild("Data Ping")
						if DataPing then
							ping = math.floor(DataPing:GetValue())
						end
					end
				end
			end)
		end

		Performance.Text = string.format("FPS %d   •   %d ms", math.floor(FPS + 0.5), ping)
	end
end)

--========================================================
-- OPEN / CLOSE ANIMS
--========================================================

local Open = false
local Animating = false

local function OpenMenu()
	if Open or Animating then return end
	Animating = true
	Open = true

	Window.Visible = true
	Window.Size = UDim2.new(Window.Size.X.Scale, Window.Size.X.Offset, 0, 0)

	TweenService:Create(
		Window,
		TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{ Size = UDim2.fromOffset(355, 470) }
	):Play()

	TweenService:Create(
		SettingsButton,
		TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ BackgroundColor3 = CARD_HOVER }
	):Play()

	task.delay(0.26, function() Animating = false end)
end

local function CloseMenu()
	if not Open or Animating then return end
	Animating = true
	Open = false

	TweenService:Create(
		Window,
		TweenInfo.new(0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
		{ Size = UDim2.new(Window.Size.X.Scale, Window.Size.X.Offset, 0, 0) }
	):Play()

	TweenService:Create(
		SettingsButton,
		TweenInfo.new(0.15),
		{ BackgroundColor3 = BACKGROUND_DARK }
	):Play()

	task.delay(0.19, function()
		if not Open then Window.Visible = false end
		Animating = false
	end)
end

SettingsButton.Activated:Connect(function()
	if Open then CloseMenu() else OpenMenu() end
end)

--========================================================
-- RESPONSIVE MOBILE
--========================================================

local function UpdateResponsive()
	local Camera = workspace.CurrentCamera
	if not Camera then return end

	local Viewport = Camera.ViewportSize

	if Viewport.X <= 500 then
		local Width = math.min(Viewport.X - 20, 390)
		local Height = math.min(Viewport.Y - 80, 520)
		Window.Size = UDim2.fromOffset(Width, Height)
	else
		Window.Size = UDim2.fromOffset(355, 470)
	end
end

local function ConnectCamera(Camera)
	if not Camera then return end
	Camera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateResponsive)
end

if workspace.CurrentCamera then ConnectCamera(workspace.CurrentCamera) end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	if workspace.CurrentCamera then ConnectCamera(workspace.CurrentCamera) end
end)

--========================================================
-- INITIALIZE & REFRESH
--========================================================

task.defer(function()
	task.wait(0.3)
	UpdateResponsive()
end)

LocalPlayer.CharacterAdded:Connect(function(character)
	Character = character
	Humanoid = character:WaitForChild("Humanoid")
	task.wait(0.2)
	UpdateRigInfo()
end)

