	addStroke(btn, COLOR_STROKE, 1)

	local iconLabel = create("TextLabel", {
		Parent = btn,
		Size = UDim2.fromOffset(40, 40),
		Position = UDim2.new(0, 14, 0.5, -20),
		BackgroundColor3 = COLOR_BG,
		Text = icon,
		TextSize = 20,
		Font = FONT_BODY,
		TextColor3 = COLOR_ACCENT,
	})
	addCorner(iconLabel, 10)

	create("TextLabel", {
		Parent = btn,
		Size = UDim2.new(1, -140, 0, 22),
		Position = UDim2.new(0, 66, 0, 12),
		BackgroundTransparency = 1,
		Text = name,
		TextSize = 16,
		Font = FONT_TITLE,
		TextColor3 = COLOR_TEXT,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	create("TextLabel", {
		Parent = btn,
		Size = UDim2.new(1, -140, 0, 18),
		Position = UDim2.new(0, 66, 0, 34),
		BackgroundTransparency = 1,
		Text = subtitle,
		TextSize = 12,
		Font = FONT_BODY,
		TextColor3 = COLOR_SUBTEXT,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	create("TextLabel", {
		Parent = btn,
		Size = UDim2.fromOffset(20, 40),
		Position = UDim2.new(1, -34, 0.5, -20),
		BackgroundTransparency = 1,
		Text = "›",
		TextSize = 20,
		Font = FONT_TITLE,
		TextColor3 = COLOR_SUBTEXT,
	})

	-- Hover efekti
	btn.MouseEnter:Connect(function()
		tweenTo(btn, {BackgroundColor3 = COLOR_ACCENT}, 0.15)
	end)
	btn.MouseLeave:Connect(function()
		tweenTo(btn, {BackgroundColor3 = COLOR_PANEL}, 0.15)
	end)

	return btn
end

