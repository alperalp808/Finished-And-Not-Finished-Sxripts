--//==================================================
--// FIND ROBLOX CHAT BUTTON
--//==================================================

local function FindChatButton()

	-- Öncelikli isimler
	local possibleNames = {

		"ChatButton",
		"Chat",
		"ChatWindow",
		"BubbleChat",
		"TextChatService"

	}

	for _, name in ipairs(possibleNames) do

		local object

		pcall(function()

			object =
				CoreGui:FindFirstChild(
					name,
					true
				)
		end)

		if object
			and object:IsA("GuiButton")
		then

			return object
		end
	end


	-- İsim üzerinden genel arama
	local descendants

	pcall(function()

		descendants =
			CoreGui:GetDescendants()

	end)

	if descendants then

		for _, object in ipairs(descendants) do

			if object:IsA("GuiButton") then

				local name =
					object.Name:lower()

				if
					name:find("chat")
					or
					name:find("textchat")
				then

					return object
				end
			end
		end
	end

	return nil
end

--//==================================================
--// POSITION BUTTON BESIDE CHAT
--//==================================================

local function PositionSettingsButton()

	local chatButton =
		FindChatButton()

	if chatButton then

		local position =
			chatButton.AbsolutePosition

		local size =
			chatButton.AbsoluteSize

		local x =
			position.X
			+
			size.X
			+
			6

		local y =
			position.Y

		OpenButton.Position =
			UDim2.fromOffset(
				x,
				y
			)

	else

		-- Chat bulunamazsa
		-- güvenli varsayılan konum

		if UserInputService.TouchEnabled then

			OpenButton.Position =
				UDim2.fromOffset(
					145,
					6
				)

		else

			OpenButton.Position =
				UDim2.fromOffset(
					150,
					6
				)
		end
	end
end

--//==================================================
--// MENU POSITION
--//==================================================

local function UpdateMenuPosition()

	local camera =
		workspace.CurrentCamera

	if not camera then
		return
	end

	local viewport =
		camera.ViewportSize


	if viewport.X < 500 then

		Main.Size =
			UDim2.new(
				1,
				-20,
				0,
				420
			)

		Main.Position =
			UDim2.fromOffset(
				10,
				55
			)

	else

		Main.Size =
			UDim2.fromOffset(
				340,
				430
			)

		local buttonPosition =
			OpenButton.AbsolutePosition

		local buttonSize =
			OpenButton.AbsoluteSize

		Main.Position =
			UDim2.fromOffset(
				buttonPosition.X,
				buttonPosition.Y
					+
					buttonSize.Y
					+
					8
			)
	end
end

--//==================================================
--// OPEN / CLOSE
--//==================================================

local Opened = false

local function OpenMenu()

	Opened = true

	Main.Visible = true

	Main.Size =
		UDim2.fromOffset(
			320,
			400
		)

	UpdateMenuPosition()

	TweenService:Create(
		Main,

		TweenInfo.new(
			0.18,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),

		{
			Size =
				UserInputService.TouchEnabled
				and UDim2.new(
					1,
					-20,
					0,
					420
				)
				or UDim2.fromOffset(
					340,
					430
				)
		}

	):Play()


	TweenService:Create(
		OpenButton,

		TweenInfo.new(0.15),

		{
			BackgroundColor3 =
				ACCENT_DARK
		}

	):Play()
end


local function CloseMenu()

	Opened = false

	local tween =
		TweenService:Create(

			Main,

			TweenInfo.new(
				0.14,
				Enum.EasingStyle.Quint,
				Enum.EasingDirection.In
			),

			{
				Size =
					UDim2.fromOffset(
						320,
						400
					)
			}
		)

	tween:Play()

	tween.Completed:Connect(function()

		if not Opened then
			Main.Visible = false
		end
	end)


	TweenService:Create(

		OpenButton,

		TweenInfo.new(0.15),

		{
			BackgroundColor3 = BG2
		}

	):Play()
end


OpenButton.Activated:Connect(function()

	if Opened then

		CloseMenu()

	else

		OpenMenu()

	end
end)

