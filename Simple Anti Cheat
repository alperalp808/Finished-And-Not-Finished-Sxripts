local function CreateSkeletonSmoke(character)
	task.spawn(function()
		local effects = {}

		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				local attachment = Instance.new("Attachment")
				attachment.Parent = part

				local smoke = Instance.new("ParticleEmitter")
				smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
				smoke.Rate = 150
				smoke.Lifetime = NumberRange.new(0.25, 0.5)
				smoke.Speed = NumberRange.new(0.5, 2.5)
				smoke.SpreadAngle = Vector2.new(180, 180)
				smoke.Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1.5),
					NumberSequenceKeypoint.new(0.5, 2.5),
					NumberSequenceKeypoint.new(1, 3)
				})
				smoke.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.15),
					NumberSequenceKeypoint.new(0.7, 0.35),
					NumberSequenceKeypoint.new(1, 1)
				})
				smoke.Parent = attachment
				table.insert(effects, attachment)
			end
		end

		task.wait(0.35)

		for _, attachment in ipairs(effects) do
			local smoke = attachment:FindFirstChildOfClass("ParticleEmitter")
			if smoke then
				smoke.Enabled = false
			end
		end

		task.wait(0.35)

		for _, attachment in ipairs(effects) do
			if attachment.Parent then
				attachment:Destroy()
			end
		end
	end)
end

