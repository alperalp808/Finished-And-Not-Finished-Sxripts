local function CreateSpinLayer(model, core, originCF, config, trails)
	local spinner = Instance.new("Part")
	spinner.Name = "AccretionSpinner"
	spinner.Size = Vector3.new(0.2, 0.2, 0.2)
	spinner.Transparency = 1
	spinner.Anchored = false
	spinner.CanCollide = false
	spinner.CanQuery = false
	spinner.CanTouch = false
	spinner.CastShadow = false
	spinner.CFrame = originCF
	spinner.Parent = model

	local coreAttachment = Instance.new("Attachment")
	coreAttachment.Name = "SpinAxis"
	coreAttachment.CFrame = CFrame.Angles(0, 0, math.rad(90))
	coreAttachment.Parent = core

	local spinAttachment = Instance.new("Attachment")
	spinAttachment.Name = "SpinAxis"
	spinAttachment.CFrame = CFrame.Angles(0, 0, math.rad(90))
	spinAttachment.Parent = spinner

	local hinge = Instance.new("HingeConstraint")
	hinge.Name = "SpinMotor"
	hinge.Attachment0 = coreAttachment
	hinge.Attachment1 = spinAttachment
	hinge.ActuatorType = Enum.ActuatorType.Motor
	hinge.AngularVelocity = config.speed
	hinge.MotorMaxTorque = 100000
	hinge.MotorMaxAcceleration = 200
	hinge.Parent = spinner

	for i = 1, config.count do
		local angle = (i / config.count) * math.pi * 2 + math.random() * 0.6
		local radius = config.minRadius + math.random() * (config.maxRadius - config.minRadius)

		local carrier = Instance.new("Part")
		carrier.Name = "AccretionMatter"
		carrier.Size = Vector3.new(0.2, 0.2, 0.2)
		carrier.Transparency = 1
		carrier.Anchored = false
		carrier.CanCollide = false
		carrier.CanQuery = false
		carrier.CanTouch = false
		carrier.CastShadow = false
		carrier.Massless = true
		carrier.CFrame = originCF * CFrame.Angles(0, angle, 0) * CFrame.new(radius, 0, 0)
		carrier.Parent = model

		local weld = Instance.new("WeldConstraint")
		weld.Part0 = spinner
		weld.Part1 = carrier
		weld.Parent = carrier

		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, config.width / 2, 0)
		a0.Parent = carrier

		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -config.width / 2, 0)
		a1.Parent = carrier

		local trail = Instance.new("Trail")
		trail.Name = "AccretionTrail"
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Color = config.color
		trail.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.1),
			NumberSequenceKeypoint.new(1, 1),
		})
		trail.WidthScale = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, 0.15),
		})
		trail.Lifetime = config.lifetime
		trail.MinLength = 0.05
		trail.LightEmission = 1
		trail.LightInfluence = 0
		trail.FaceCamera = true
		trail.Enabled = false
		trail.Parent = carrier
		table.insert(trails, trail)
	end

	pcall(function()
		if spinner:CanSetNetworkOwnership() then
			spinner:SetNetworkOwner(nil)
		end
	end)

	return spinner
end

local function CreateBlackHole(position)
	local TINY = 0.05
	local yaw = math.random() * math.pi * 2

	local originCF = CFrame.new(position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(0, 0, math.rad(BLACKHOLE_TILT_DEGREES))
	local diskCF = originCF * CFrame.Angles(0, 0, math.rad(90))

	local horizonDiameter = BLACKHOLE_HORIZON_RADIUS * 2
	local glowSize = BLACKHOLE_DISK_RADIUS * 2.1

	local model = Instance.new("Model")
	model.Name = "SingularityBlackHole"
	model.Parent = workspace

	local function NewPart(name, shape, size, cframe, color, material, transparency)
		local part = Instance.new("Part")
		part.Name = name
		part.Shape = shape
		part.Size = size
		part.CFrame = cframe
		part.Color = color
		part.Material = material
		part.Transparency = transparency
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Parent = model
		return part
	end

	local core = NewPart(
		"Core", Enum.PartType.Block, Vector3.new(0.4, 0.4, 0.4),
		originCF, Color3.new(0, 0, 0), Enum.Material.SmoothPlastic, 1
	)

	local horizon = NewPart(
		"EventHorizon", Enum.PartType.Ball, Vector3.new(TINY, TINY, TINY),
		originCF, Color3.new(0, 0, 0), Enum.Material.Neon, 0
	)

	local infallDiameter = BLACKHOLE_DISK_RADIUS * 1.85
