	billboard.LightInfluence = 0
	billboard.MaxDistance = 300
	billboard.Active = false
	billboard.ClipsDescendants = false
	billboard.Parent = core

	for index, layer in ipairs(BLACKHOLE_GLOW_LAYERS) do
		local frame = Instance.new("Frame")
		frame.Name = "GlowLayer" .. index
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.Position = UDim2.fromScale(0.5, 0.5)
		frame.Size = UDim2.fromScale(layer.scale, layer.scale)
		frame.BackgroundColor3 = layer.color
		frame.BackgroundTransparency = layer.transparency
