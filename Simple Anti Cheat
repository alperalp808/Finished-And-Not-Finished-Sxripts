local function ReplaceHeadWithSkeletonHead(targetCharacter)
	local oldHead = targetCharacter:FindFirstChild("Head")
	if not oldHead then return end

	local morphsFolder = ReplicatedStorage:FindFirstChild("Morphs") or ReplicatedStorage:FindFirstChild("Morpths")
	local skeletonHeadPrefab = morphsFolder and morphsFolder:FindFirstChild("SkeletonHead")
	if not skeletonHeadPrefab then
		warn("ReplicatedStorage.Morphs.SkeletonHead Part'ı bulunamadı!")
		return
	end

	local newHead = skeletonHeadPrefab:Clone()
	newHead.Name = "Head"
	newHead.Size = oldHead.Size
	newHead.CFrame = oldHead.CFrame
	newHead.CanCollide = false
	newHead.Anchored = false

	local specialMesh = newHead:FindFirstChildOfClass("SpecialMesh")
	if specialMesh then
		specialMesh.Scale = Vector3.new(1, 1, 1)
	end

	local torso = targetCharacter:FindFirstChild("Torso") or targetCharacter:FindFirstChild("UpperTorso")
	local oldNeck = oldHead:FindFirstChild("Neck") or (torso and torso:FindFirstChild("Neck"))
	local neckC0 = oldNeck and oldNeck.C0 or CFrame.new(0, 1, 0) * CFrame.Angles(-math.pi/2, 0, math.pi)
	local neckC1 = oldNeck and oldNeck.C1 or CFrame.new(0, -0.5, 0) * CFrame.Angles(-math.pi/2, 0, math.pi)

	oldHead:Destroy()
	newHead.Parent = targetCharacter

	if torso then
		local newNeck = Instance.new("Motor6D")
		newNeck.Name = "Neck"
		newNeck.Part0 = torso
		newNeck.Part1 = newHead
		newNeck.C0 = neckC0
		newNeck.C1 = neckC1
		newNeck.Parent = torso
	end
end

