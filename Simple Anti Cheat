local function EnsureRootAttached(character)
	local hrp = character:FindFirstChild("HumanoidRootPart")
	local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
	if not hrp or not torso or hrp == torso then return end
	if hrp:FindFirstChild("RootReattach") then return end

	local weld = Instance.new("WeldConstraint")
	weld.Name = "RootReattach"
	weld.Part0 = hrp
	weld.Part1 = torso
	weld.Parent = hrp
end

local function ReattachAccessories(character)
	local bodyParts = {}
	for _, name in ipairs({"Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"}) do
		local part = character:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			table.insert(bodyParts, part)
		end
	end
	if #bodyParts == 0 then return end

	for _, accessory in ipairs(character:GetChildren()) do
		if accessory:IsA("Accessory") or accessory:IsA("Tool") then
			local handle = accessory:FindFirstChild("Handle")
			if handle and handle:IsA("BasePart") and not handle:FindFirstChild("AccessoryReattach") then
				local nearest, nearestDistance = nil, math.huge
				for _, part in ipairs(bodyParts) do
					local distance = (handle.Position - part.Position).Magnitude
					if distance < nearestDistance then
						nearest = part
						nearestDistance = distance
					end
				end
				local weld = Instance.new("WeldConstraint")
				weld.Name = "AccessoryReattach"
				weld.Part0 = nearest
				weld.Part1 = handle
				weld.Parent = handle
			end
		end
	end
end

local function WeldPartsToRoot(character, root)
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") and part ~= root and #part:GetJoints() == 0 then
			local weld = Instance.new("WeldConstraint")
			weld.Name = "FallbackWeld"
			weld.Part0 = root
			weld.Part1 = part
			weld.Parent = part
		end
	end
end

local function BuildR6Ragdoll(character)
	local torso = character:FindFirstChild("Torso")
	if not torso or not torso:IsA("BasePart") then return false end

	local bodyParts = {torso}
	for _, info in ipairs(RAGDOLL_JOINTS) do
		local limb = character:FindFirstChild(info.limb)
		if limb and limb:IsA("BasePart") then
			table.insert(bodyParts, limb)
			local motor = torso:FindFirstChild(info.motorName) or limb:FindFirstChild(info.motorName)
			if motor and motor:IsA("Motor6D") then
				motor.Enabled = false
			end
			local worldPivot = torso.CFrame * info.pivot
			local att0 = Instance.new("Attachment")
			att0.Name = "Ragdoll_" .. info.limb .. "_Torso"
			att0.CFrame = info.pivot
			att0.Parent = torso

			local att1 = Instance.new("Attachment")
			att1.Name = "Ragdoll_" .. info.limb .. "_Limb"
			att1.CFrame = limb.CFrame:ToObjectSpace(worldPivot)
			att1.Parent = limb

			local socket = Instance.new("BallSocketConstraint")
			socket.Name = "Ragdoll_" .. info.limb
			socket.Attachment0 = att0
			socket.Attachment1 = att1
			socket.LimitsEnabled = true
			socket.UpperAngle = info.cone
			socket.TwistLimitsEnabled = true
			socket.TwistLowerAngle = -info.twist
			socket.TwistUpperAngle = info.twist
			socket.Restitution = 0
			socket.Parent = torso
		end
	end

	for i = 1, #bodyParts - 1 do
		for j = i + 1, #bodyParts do
			local noCollision = Instance.new("NoCollisionConstraint")
			noCollision.Name = "RagdollNoCollision"
			noCollision.Part0 = bodyParts[i]
			noCollision.Part1 = bodyParts[j]
			noCollision.Parent = torso
		end
	end

	return true
end

local function TakeServerPhysicsOwnership(character)
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") and not part.Anchored then
			pcall(function()
				if part:CanSetNetworkOwnership() then
					part:SetNetworkOwner(nil)
				end
			end)
		end
	end
end

local function PlayServerSound(soundId, parentPart, customVolume)
	if not parentPart or not parentPart.Parent then return end

	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://" .. tostring(soundId)
	sound.Volume = customVolume or 1.54
	sound.RollOffMaxDistance = 300
	sound.RollOffMinDistance = 15
	sound.EmitterSize = 25
	sound.Parent = parentPart
	sound:Play()
	Debris:AddItem(sound, 6)
	return sound
end

