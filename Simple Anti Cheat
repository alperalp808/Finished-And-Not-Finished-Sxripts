----------------------------------------------------------------
-- SATIN ALMA İŞLEMİ
----------------------------------------------------------------

local function showStatus(message, isError)
	StatusLabel.Text = message
	StatusLabel.TextColor3 = isError and COLOR_ERROR or COLOR_SUCCESS
end

PurchaseButton.MouseButton1Click:Connect(function()
	local rawId = IdTextBox.Text
	local id = tonumber(rawId)

	if not id then
		showStatus("Geçerli bir ID girin.", true)
		return
	end

	local tab = checkTab()

	local ok, err = pcall(function()
		if tab == "Gamepass" then
			MarketplaceService:PromptGamePassPurchase(LocalPlayer, id)
		elseif tab == "Bundle" then
			MarketplaceService:PromptBundlePurchase(LocalPlayer, id)
		elseif tab == "Catalog" then
			MarketplaceService:PromptPurchase(LocalPlayer, id)
		end
	end)

	if ok then
		showStatus("Satın alma penceresi açıldı.", false)
	else
		showStatus("Hata: pencere açılamadı.", true)
		warn("[PurchasePanel] PromptPurchase hatası:", err)
	end
end)

-- Enter tuşuyla da satın alma tetiklensin
IdTextBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		PurchaseButton:Activate()
	end
end)
