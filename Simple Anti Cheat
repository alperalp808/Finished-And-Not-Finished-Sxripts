--[[
	Sword - LocalScript (CLIENT)
	R6 için. Sadece görsel/işitsel taraf: animasyon, ses, grip.
	Hasar hesaplamaz — sadece "saldırdım" sinyalini sunucuya gönderir.
	Gerçek hasar doğrulaması Script (server) tarafında yapılır.
]]

local Tool = script.Parent
local Handle = Tool:WaitForChild("Handle")
local AttackRemote = Tool:WaitForChild("AttackRemote")

local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer

--// Ses efektleri
local Sounds = {
	Slash = Handle:WaitForChild("SwordSlash"),
	Lunge = Handle:WaitForChild("SwordLunge"),
	Unsheath = Handle:WaitForChild("Unsheath"),
}

--// Grip pozisyonları (görsel: sunucu da kendi tarafında aynısını uygular)
local Grips = {
	Up = CFrame.new(0, 0, -1.70000005, 0, 0, 1, 1, 0, 0, 0, 1, 0),
	Out = CFrame.new(0, 0, -1.70000005, 0, 1, 0, 1, -0, 0, 0, 0, -1),
}

--// R6 animasyon ID'leri (verdiğin ID'ler)
local AnimationIds = {
	Idle = "rbxassetid://127108219798248",
	Slash1 = "rbxassetid://117818478506546",
	Slash2 = "rbxassetid://109267907771703",
	Slash3 = "rbxassetid://79130740691867",
}

local Character, Humanoid, Animator
local ToolEquipped = false
local LastAttackTick = 0
local SlashIndex = 0

local IdleTrack = nil
local ActiveTracks = {}

local function GetOrCreateAnimation(name, id)
	local anim = Tool:FindFirstChild(name)
	if not anim then
		anim = Instance.new("Animation")
		anim.Name = name
		anim.AnimationId = id
		anim.Parent = Tool
	else
		anim.AnimationId = id
	end
	return anim
end

local IdleAnim = GetOrCreateAnimation("IdleAnim", AnimationIds.Idle)
local Slash1Anim = GetOrCreateAnimation("Slash1Anim", AnimationIds.Slash1)
local Slash2Anim = GetOrCreateAnimation("Slash2Anim", AnimationIds.Slash2)
local Slash3Anim = GetOrCreateAnimation("Slash3Anim", AnimationIds.Slash3)

local SlashAnims = { Slash1Anim, Slash2Anim, Slash3Anim }

local function CheckIfAlive()
	return Character
		and Character.Parent
		and Humanoid
		and Humanoid.Parent
		and Humanoid.Health > 0
end

local function StopAllActionTracks()
	for _, track in ipairs(ActiveTracks) do
		if track.IsPlaying then
			track:Stop(0.1)
		end
	end
	table.clear(ActiveTracks)
end

local function PlayIdle()
	if not Animator or not IdleAnim then
		return
	end
	if IdleTrack then
		IdleTrack:Stop()
		IdleTrack:Destroy()
	end
	IdleTrack = Animator:LoadAnimation(IdleAnim)
	IdleTrack.Looped = true
	IdleTrack.Priority = Enum.AnimationPriority.Idle
	IdleTrack:Play(0.2)
end

local function StopIdle()
	if IdleTrack then
		IdleTrack:Stop(0.2)
	end
end

local function GetNextSlashAnim()
	SlashIndex = (SlashIndex % #SlashAnims) + 1
	return SlashAnims[SlashIndex]
end

local function PlayActionTrack(anim)
	if not Humanoid or not Animator then
		return
	end
	local track = Animator:LoadAnimation(anim)
	track.Priority = Enum.AnimationPriority.Action
	track:Play(0)
	table.insert(ActiveTracks, track)

	track.Stopped:Connect(function()
		for i, t in ipairs(ActiveTracks) do
			if t == track then
				table.remove(ActiveTracks, i)
				break
			end
		end
	end)
end

--// Görsel slash: animasyon + ses. Hasar isteği ayrıca sunucuya gönderilir.
local function Attack()
	Sounds.Slash:Play()
	PlayActionTrack(GetNextSlashAnim())
	AttackRemote:FireServer("Slash")
end

--// Görsel lunge: animasyon + ses + grip. Hasar isteği sunucuya gönderilir.
local function Lunge()
	Sounds.Lunge:Play()
	-- Ayrı bir Lunge animasyon ID'n yoksa Slash1 kullanılıyor.
	-- Ayrı ID varsa AnimationIds tablosuna ekleyip burada onu çağır.
	PlayActionTrack(Slash1Anim)
	AttackRemote:FireServer("Lunge")

	task.wait(0.2)
	Tool.Grip = Grips.Out
	task.wait(0.6)
	Tool.Grip = Grips.Up
end

local function Activated()
	if not Tool.Enabled or not ToolEquipped or not CheckIfAlive() then
		return
	end

	Tool.Enabled = false

	local now = os.clock()
	if (now - LastAttackTick) < 0.2 then
		Lunge()
	else
		Attack()
	end
	LastAttackTick = now

	Tool.Enabled = true
end

local function Equipped()
	Character = Tool.Parent
	Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

	if not Humanoid then
		return
	end

	Animator = Humanoid:FindFirstChildOfClass("Animator")
	if not Animator then
		Animator = Instance.new("Animator")
		Animator.Parent = Humanoid
	end

	if not CheckIfAlive() then
		return
	end

	ToolEquipped = true
	Sounds.Unsheath:Play()
	PlayIdle()
end

local function Unequipped()
	ToolEquipped = false
	Tool.Grip = Grips.Up
	StopIdle()
	StopAllActionTracks()
end

Tool.Activated:Connect(Activated)
Tool.Equipped:Connect(Equipped)
Tool.Unequipped:Connect(Unequipped)

Tool.Grip = Grips.Up
Tool.Enabled = true
