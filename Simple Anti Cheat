--[[
	Sword - Script (SERVER)
	3 sıralı slash (Slash1 → Slash2 → Slash3 → tekrar Slash1).
	Hasar: 15 / 20 / 40. Saldırılar arası minimum 0.6 saniye — bu limit
	SADECE sunucuda uygulanır, istemci ne gönderirse göndersin bu değişmez.
	Oyuncu 2 saniye saldırmazsa combo sıfırlanır, bir sonraki vuruş Slash1/15 olur.
]]

local Tool = script.Parent
local Handle = Tool:WaitForChild("Handle")

local Players = game:GetService("Players")
local Debris = game:GetService("Debris")

local AttackRemote = Tool:FindFirstChild("AttackRemote")
if not AttackRemote then
	AttackRemote = Instance.new("RemoteEvent")
	AttackRemote.Name = "AttackRemote"
	AttackRemote.Parent = Tool
end

--// Sunucudan çalınan sesler: Sound sunucu tarafında :Play() edilirse
-- Roblox onu otomatik olarak o alanı gören TÜM istemcilere yayınlar.
-- Bu yüzden equip/hit/kill sesleri LocalScript'te değil burada duruyor —
-- LocalScript'te çalınsalar sadece o oyuncunun ekranında duyulurdu.
local UnsheathSound = Handle:WaitForChild("Unsheath") -- mevcut Sound objesi, olduğu gibi kullanılıyor

local function CreateServerSound(name, id, parent)
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = id
	sound.Parent = parent
	return sound
end

-- Bu üçü Handle altında kalıcı olarak durur; Sound objeleri :Play() edilene
-- kadar sessizdir, bu yüzden burada durmaları sorun yaratmaz.
local MissSound = Handle:FindFirstChild("AttackMissSound") or CreateServerSound("AttackMissSound", "rbxassetid://85747054814531", Handle)
local HitSound = Handle:FindFirstChild("AttackHitSound") or CreateServerSound("AttackHitSound", "rbxassetid://94066777013169", Handle)
local KillSound = Handle:FindFirstChild("AttackKillSound") or CreateServerSound("AttackKillSound", "rbxassetid://102321459646153", Handle)

-- Sıralı slash hasarları: 1. vuruş 15, 2. vuruş 20, 3. vuruş 40, sonra 1'e döner
local SlashDamage = { 15, 20, 40 }

-- Sunucu tarafı ZORUNLU cooldown. İstemci bunu istediği kadar delmeye çalışsın,
-- burada geçen süre kontrol edilmeden hiçbir saldırı kabul edilmez.
local ATTACK_COOLDOWN = 0.6

-- Bir saldırı animasyonunun "etkili vuruş" penceresi: bu süre içindeki
-- Touched olayları hasar verir, dışındakiler verilmez.
local ATTACK_WINDOW = 0.4

-- Oyuncu bu süre boyunca hiç saldırmazsa, bir sonraki saldırı 1. animasyondan
-- (ve 1. hasardan) tekrar başlar. Süre, son saldırının ÜZERİNDEN geçen zamana
-- göre ölçülür, sıradaki saldırının başlangıcına göre değil.
local COMBO_RESET_TIME = 2

local Grips = {
	Up = CFrame.new(0, 0, -1.70000005, 0, 0, 1, 1, 0, 0, 0, 1, 0),
}

local ToolEquipped = false
local Character, Player, Humanoid, Torso

local LastAttackTime = 0
local SlashIndex = 0 -- sunucu kendi sırasını kendi tutar, istemciye güvenmez

local CurrentDamage = 0
local AttackWindowEndsAt = 0
local AttackLanded = false -- bu saldırı sırasında herhangi bir hedefe değindi mi
local AttackGeneration = 0 -- her saldırının kimliği; Miss kontrolünün doğru saldırıya ait olduğunu garantiler

local function IsTeamMate(Player1, Player2)
	return Player1
		and Player2
		and not Player1.Neutral
		and not Player2.Neutral
		and Player1.TeamColor == Player2.TeamColor
end

local function TagHumanoid(humanoid, player)
	local CreatorTag = Instance.new("ObjectValue")
	CreatorTag.Name = "creator"
	CreatorTag.Value = player
	Debris:AddItem(CreatorTag, 2)
	CreatorTag.Parent = humanoid
end

local function UntagHumanoid(humanoid)
	for _, v in ipairs(humanoid:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "creator" then
			v:Destroy()
		end
	end
end

local function CheckIfAlive()
	return Player
		and Player.Parent
		and Character
		and Character.Parent
		and Humanoid
		and Humanoid.Parent
		and Humanoid.Health > 0
		and Torso
		and Torso.Parent
end

local function OnTouched(Hit)
	if not Hit or not Hit.Parent or not CheckIfAlive() or not ToolEquipped then
		return
	end

	if os.clock() > AttackWindowEndsAt or CurrentDamage <= 0 then
		return
	end

	local RightArm = Character:FindFirstChild("Right Arm")
	if not RightArm then
		return
	end
	local RightGrip = RightArm:FindFirstChild("RightGrip")
	if not RightGrip or (RightGrip.Part0 ~= Handle and RightGrip.Part1 ~= Handle) then
		return
	end

	local hitCharacter = Hit.Parent
	if hitCharacter == Character then
		return
	end

	local hitHumanoid = hitCharacter:FindFirstChildOfClass("Humanoid")
	if not hitHumanoid or hitHumanoid.Health == 0 then
		return
	end

	local hitPlayer = Players:GetPlayerFromCharacter(hitCharacter)
	if hitPlayer and (hitPlayer == Player or IsTeamMate(Player, hitPlayer)) then
		return
	end

	UntagHumanoid(hitHumanoid)
	TagHumanoid(hitHumanoid, Player)

	local healthBeforeDamage = hitHumanoid.Health
	hitHumanoid:TakeDamage(CurrentDamage)

	-- Hasar sonrası can 0 veya altındaysa (ya da zaten TakeDamage tarafından
	-- öldürüldüyse) Kill sesi, aksi halde Hit sesi çalınır. healthBeforeDamage > 0
	-- kontrolü, zaten ölü birine tekrar dokunup yanlışlıkla Kill sesi çalmasını önler
	-- (bu durum zaten yukarıda "hitHumanoid.Health == 0" kontrolüyle elenmiş olsa da
	-- ekstra güvenlik için burada da duruyor).
	if healthBeforeDamage > 0 and hitHumanoid.Health <= 0 then
		KillSound:Play()
	else
		HitSound:Play()
	end

	-- Bu saldırı hedefine ulaştı: "boşa vurma" sesi çalınmaması için işaretliyoruz.
	AttackLanded = true

	-- Bir vuruş yeter, aynı saldırı ile ikinci kez dokunup çift hasar verilmesin
	CurrentDamage = 0
end

--// İstemci "saldırdım" dediğinde çalışır.
-- Burada TEK yetki sunucudadır: cooldown geçmediyse istek tamamen yok sayılır,
-- istemcinin gönderdiği hiçbir zamanlama/tip bilgisine güvenilmez.
local function OnAttackRequested(player)
	if player ~= Player then
		return
	end
	if not CheckIfAlive() or not ToolEquipped then
		return
	end

	local now = os.clock()
	local elapsed = now - LastAttackTime

	if elapsed < ATTACK_COOLDOWN then
		-- Cooldown dolmadı: istemci ne kadar spam gönderirse göndersin reddedilir
		return
	end

	-- Son saldırının üzerinden 2 saniyeden fazla geçtiyse, combo sıfırlanır:
	-- bir sonraki vuruş her zaman 1. animasyon/1. hasar olur. Bu kontrol
	-- SlashIndex'i artırmadan ÖNCE yapılıyor, aksi halde bir tur geç kalırdı.
	if elapsed >= COMBO_RESET_TIME then
		SlashIndex = 0
	end

	LastAttackTime = now

	SlashIndex = (SlashIndex % 3) + 1
	CurrentDamage = SlashDamage[SlashIndex]
	AttackWindowEndsAt = now + ATTACK_WINDOW
	AttackLanded = false

	-- Bu saldırının kimliği. Pencere kapandığında, o an AttackGeneration hâlâ
	-- BU saldırıya mı ait diye kontrol ediyoruz — art arda hızlı saldırılarda
	-- bir önceki saldırının "boşa vurdu mu" kontrolünün, araya girmiş yeni bir
	-- saldırıyı yanlışlıkla Miss sesi çaldırmasını önlemek için.
	AttackGeneration += 1
	local myAttackGeneration = AttackGeneration

	task.delay(ATTACK_WINDOW, function()
		-- Bu hâlâ en güncel saldırıysa, pencere boyunca hiçbir hedefe
		-- değmediyse VE oyuncu hâlâ kılıcı kuşanmışsa boşa vurma sesi çalınır.
		-- ToolEquipped kontrolü, oyuncu saldırdıktan hemen sonra kılıcı
		-- bıraksa bile sesin "boşta" çalmasını önler.
		if myAttackGeneration == AttackGeneration and not AttackLanded and ToolEquipped then
			MissSound:Play()
		end
	end)
end

local function Equipped()
	Character = Tool.Parent
	Player = Players:GetPlayerFromCharacter(Character)
	Humanoid = Character:FindFirstChildOfClass("Humanoid")
	Torso = Character:FindFirstChild("Torso")

	if not CheckIfAlive() then
		return
	end

	ToolEquipped = true
	SlashIndex = 0

	-- Sunucudan çalınıyor ki diğer oyuncular da duysun (LocalScript'te
	-- çalınsaydı sadece bu oyuncunun ekranında duyulurdu).
	UnsheathSound:Play()
end

local function Unequipped()
	Tool.Grip = Grips.Up
	ToolEquipped = false
	CurrentDamage = 0
end

Tool.Equipped:Connect(Equipped)
Tool.Unequipped:Connect(Unequipped)
Handle.Touched:Connect(OnTouched)
AttackRemote.OnServerEvent:Connect(OnAttackRequested)

Tool.Grip = Grips.Up
