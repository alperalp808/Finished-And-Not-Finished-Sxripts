local Players = game:GetService("Players")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local itemBuyer = playerGui:WaitForChild("ItemBuyer")

--// GUI
local gui = Instance.new("ScreenGui")
gui.Name = "ItemBuyerToggle"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = playerGui

--// Buton
local button = Instance.new("TextButton")
button.Name = "ToggleButton"
button.Size = UDim2.fromOffset(55, 55)
button.Position = UDim2.new(0, 12, 0.5, -27)
button.AnchorPoint = Vector2.new(0, 0)
button.BackgroundColor3 = Color3.fromRGB(35, 130, 255)
button.Text = "🔧"
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.TextSize = 25
button.Font = Enum.Font.GothamBold
button.AutoButtonColor = true
button.Active = true
button.Draggable = false
button.Parent = gui

--// Yuvarlatma
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = button

--// Kenarlık
local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(255, 255, 255)
stroke.Thickness = 2
stroke.Transparency = 0.15
stroke.Parent = button

--// Tıklama
button.Activated:Connect(function()
	itemBuyer.Enabled = not itemBuyer.Enabled
end)