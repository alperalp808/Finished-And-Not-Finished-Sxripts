-- 10. EXPLODE
EffectHandlers["Explode"] = function(victimCharacter, killerPlayer)
	if not victimCharacter or victimCharacter:GetAttribute("IsExplodeTransformed") then
		return
	end
	victimCharacter:SetAttribute("IsExplodeTransformed", true)

	local hrp = victimCharacter:FindFirstChild("HumanoidRootPart") or victimCharacter:FindFirstChild("Torso") or victimCharacter:FindFirstChild("UpperTorso")
	local position = hrp and hrp.Position or victimCharacter:GetPivot().Position

	-- İKİ PATLAMA SESİ AYNI ANDA
	local soundPart = hrp or victimCharacter:FindFirstChildOfClass("BasePart")
	if soundPart then
		PlayServerSound(
			EXPLODE_SOUND_ID_1,
			soundPart,
			1.5
		)
		PlayServerSound(
			EXPLODE_SOUND_ID_2,
			soundPart,
			1.5
		)
	end

	local explosion = Instance.new("Explosion")
	explosion.Position = position
	explosion.BlastRadius = 0
	explosion.BlastPressure = 0
	explosion.DestroyJointRadiusPercent = 0
	explosion.Parent = workspace

	-- Mevcut patlama hız ölçeği
	local speedScale = math.sqrt(EXPLODE_SCALE)

	for _, part in ipairs(victimCharacter:GetDescendants()) do
		if part:IsA("BasePart") and not part.Anchored then
			-- Eklemeleri kır
			for _, joint in ipairs(part:GetJoints()) do
				joint:Destroy()
			end

			local offset = part.Position - position
			local direction

			if offset.Magnitude > 0.001 then
				direction = offset.Unit
			else
				direction = Vector3.new(
					math.random() - 0.5,
					0,
					math.random() - 0.5
				)
				if direction.Magnitude < 0.001 then
					direction = Vector3.new(0, 0, 1)
				else
					direction = direction.Unit
				end
			end

			-- Hafif dışa doğru savrulma
			local horizontalVelocity = direction * (20 * speedScale)
			-- Ana yukarı savurma
			local upwardVelocity = Vector3.new(
				0,
				EXPLODE_UPWARD_VELOCITY * speedScale,
				0
			)

			-- Hem dışa hem yukarı
			part.AssemblyLinearVelocity = horizontalVelocity + upwardVelocity

			-- Rastgele dönme
			part.AssemblyAngularVelocity = Vector3.new(
				math.random(-12, 12),
				math.random(-12, 12),
				math.random(-12, 12)
			)
		end
	end

	Debris:AddItem(victimCharacter, 5)
end

-- OYUNCU ÖLÜM TAKİBİ VE EFEKT TETİKLEME

local function GetKillerEffectName(killer)
	if not killer then return nil end

	local equippedVal = killer:FindFirstChild("EquippedKillEffect")
	if equippedVal and equippedVal.Value ~= "" then
		return equippedVal.Value
	end

	local attrEffect = killer:GetAttribute("KillEffect") or killer:GetAttribute("EquippedKillEffect")
	if attrEffect and attrEffect ~= "" then
		return attrEffect
	end

	local leaderstats = killer:FindFirstChild("leaderstats")
	local lsEffect = leaderstats and leaderstats:FindFirstChild("KillEffect")
	if lsEffect and lsEffect.Value ~= "" then
		return lsEffect.Value
	end

	return nil
end

local EffectLockedCharacters = setmetatable({}, {__mode = "k"})
local HookedCharacters = setmetatable({}, {__mode = "k"})

local function OnCharacterAdded(character, player)
	if HookedCharacters[character] then
		return
	end
	HookedCharacters[character] = true

	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid then return end

	humanoid.Died:Connect(function()
		if EffectLockedCharacters[character] then return end
		EffectLockedCharacters[character] = true

		-- 1. Doğrudan Silah Attribute'ları
		if character:GetAttribute("KilledByLaser") then
			local killerPlayer = nil
			local killerId = character:GetAttribute("LaserKiller")
			if killerId then
				killerPlayer = Players:GetPlayerByUserId(killerId)
			end
			EffectHandlers["Laser"](character, killerPlayer)
			return

		elseif character:GetAttribute("KilledByGolden") then
			local killerPlayer = nil
			local killerId = character:GetAttribute("GoldenKiller")
			if killerId then
				killerPlayer = Players:GetPlayerByUserId(killerId)
			end
			EffectHandlers["Golden"](character, killerPlayer)
			return

		elseif character:GetAttribute("KilledByDivineAxe") then
			local killerPlayer = nil
			local lastAttackerName = character:GetAttribute("LastAttacker")
			if lastAttackerName then
				killerPlayer = Players:FindFirstChild(lastAttackerName)
			end
			if not killerPlayer then
				local creatorTag = humanoid:FindFirstChild("creator")
				if creatorTag and creatorTag.Value and creatorTag.Value:IsA("Player") then
					killerPlayer = creatorTag.Value
				end
			end
			EffectHandlers["HellFire"](character, killerPlayer)
			return

		elseif character:GetAttribute("KilledByBlackHole") then
			local killerPlayer = nil
			local creatorTag = humanoid:FindFirstChild("creator")
			if creatorTag and creatorTag.Value and creatorTag.Value:IsA("Player") then
				killerPlayer = creatorTag.Value
			end
			EffectHandlers["BlackHole"](character, killerPlayer)
			return

		elseif character:GetAttribute("KilledByBurning") then
			local killerPlayer = nil
			local creatorTag = humanoid:FindFirstChild("creator")
			if creatorTag and creatorTag.Value and creatorTag.Value:IsA("Player") then
				killerPlayer = creatorTag.Value
			end
			EffectHandlers["Burning"](character, killerPlayer)
			return

		elseif character:GetAttribute("KilledByExplode") then
			local killerPlayer = nil
			local creatorTag = humanoid:FindFirstChild("creator")
			if creatorTag and creatorTag.Value and creatorTag.Value:IsA("Player") then
				killerPlayer = creatorTag.Value
			end
			EffectHandlers["Explode"](character, killerPlayer)
			return
		end

		-- 2. Katilin kuşanılmış Kill Effect'i
		local creatorTag = humanoid:FindFirstChild("creator")
		if creatorTag and creatorTag.Value and creatorTag.Value:IsA("Player") then
			local killer = creatorTag.Value
			if killer ~= player then
				local effectName = GetKillerEffectName(killer)
				if effectName and EffectHandlers[effectName] then
					EffectHandlers[effectName](character, killer)
				end
			end
		end
	end)
end

local function OnPlayerAdded(player)
	player.CharacterAdded:Connect(function(character)
		OnCharacterAdded(character, player)
	end)

	if player.Character then
		OnCharacterAdded(player.Character, player)
	end
end

Players.PlayerAdded:Connect(OnPlayerAdded)

for _, player in ipairs(Players:GetPlayers()) do
	OnPlayerAdded(player)
end
