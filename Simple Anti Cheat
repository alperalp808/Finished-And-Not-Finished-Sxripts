-- ServerScriptService > Script (isim: RagdollDeathSystem)

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")

--// AYARLAR //--
local DEAD_BODY_LIFETIME = 20 -- saniye, klon Dead klasöründe ne kadar kalacak
local SETTLE_TIMEOUT = 5 -- saniye, ragdoll'un yere düşüp sakinleşmesi için maksimum bekleme
local SETTLE_CHECK_INTERVAL = 0.1
local SETTLE_VELOCITY_THRESHOLD = 0.6 -- bu hızın altına inince "durdu" sayılır
local DEAD_BODY_BASE_NAME = "Raggy" -- her klonun temel adı, sonuna sayı eklenir

-- Kullanıcı "Dead" klasörünü Workspace'e kendisi ekleyecek; burada sadece bekliyoruz.
local deadFolder = Workspace:WaitForChild("Dead", 30)
if not deadFolder then
	warn("[RagdollDeathSystem] Workspace içinde 'Dead' adında bir Folder bulunamadı. Script devam edecek ama klonlar konulamayacak; lütfen Workspace'e 'Dead' isimli bir Folder ekleyin.")
end

-- Sunucu genelinde paylaşılan, her ölümde artan bir sayaç. Bu sayede iki oyuncu aynı anda
-- ölse bile isimler asla çakışmaz: Raggy_1, Raggy_2, Raggy_3... şeklinde devam eder.
local deadBodyCounter = 0

--// R6 EKLEM HARİTASI: R6'da hazır Attachment yok, bu yüzden Motor6D'nin C0/C1 CFrame'lerini
--// kendimiz Attachment olarak kuruyoruz. Değerler R6 rigi için standart, doğrulanmış CFrame'lerdir.
local R6_JOINTS = {
	{
		part0 = "Torso", part1 = "Head", motorName = "Neck",
		c0 = CFrame.new(0, 1, 0, 0, -1, 0, 1, 0, 0, 0, 0, 1),
		c1 = CFrame.new(0, -0.5, 0, 0, -1, 0, 1, 0, 0, 0, 0, 1),
	},
	{
		part0 = "Torso", part1 = "Left Arm", motorName = "Left Shoulder",
		c0 = CFrame.new(-1.3, 0.75, 0, -1, 0, 0, 0, -1, 0, 0, 0, 1),
		c1 = CFrame.new(0.2, 0.75, 0, -1, 0, 0, 0, -1, 0, 0, 0, 1),
	},
	{
		part0 = "Torso", part1 = "Right Arm", motorName = "Right Shoulder",
		c0 = CFrame.new(1.3, 0.75, 0, 1, 0, 0, 0, -1, 0, 0, 0, -1),
		c1 = CFrame.new(-0.2, 0.75, 0, 1, 0, 0, 0, -1, 0, 0, 0, -1),
	},
	{
		part0 = "Torso", part1 = "Left Leg", motorName = "Left Hip",
		c0 = CFrame.new(-0.5, -1, 0, -1, 0, 0, 0, 0, 1, 0, 1, 0),
		c1 = CFrame.new(0, 1, 0, -1, 0, 0, 0, 0, 1, 0, 1, 0),
	},
	{
		part0 = "Torso", part1 = "Right Leg", motorName = "Right Hip",
		c0 = CFrame.new(0.5, -1, 0, 1, 0, 0, 0, 0, -1, 0, 1, 0),
		c1 = CFrame.new(0, 1, 0, 1, 0, 0, 0, 0, -1, 0, 1, 0),
	},
}

--// YARDIMCI FONKSİYONLAR //--

-- Aksesuarların (saç, şapka, kulaklık, sırt çantası, vb.) ragdoll sırasında vücuttan
-- ayrılıp düşmemesi için Handle'larını sağlam bir WeldConstraint ile en yakın vücut
-- parçasına bağlar. Karakterin gövde parçalarının İÇİNE dokunmuyoruz — sadece Handle'ın
-- kendi eski joint'lerini temizliyoruz, böylece karakterin kendi iskeletini bozma riski yok.
local function securizeAccessories(character)
	local candidateParts = {}
	local candidateNames = {"Head", "Torso"} -- R6'ya özgü, sadece bu iki parça var
	for _, name in ipairs(candidateNames) do
		local part = character:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			table.insert(candidateParts, part)
		end
	end

	if #candidateParts == 0 then
		return
	end

	for _, accessory in ipairs(character:GetDescendants()) do
		if accessory:IsA("Accessory") then
			local handle = accessory:FindFirstChild("Handle")
			if not handle or not handle:IsA("BasePart") then
				continue
			end

			if handle:FindFirstChild("RagdollAccessoryWeld") then
				continue
			end

			for _, oldJoint in ipairs(handle:GetChildren()) do
				if oldJoint:IsA("Weld")
					or oldJoint:IsA("Motor6D")
					or oldJoint:IsA("WeldConstraint")
					or oldJoint:IsA("RigidConstraint") then
					oldJoint:Destroy()
				end
			end

			local closestPart = nil
			local closestDistance = math.huge
			for _, part in ipairs(candidateParts) do
				local distance = (part.Position - handle.Position).Magnitude
				if distance < closestDistance then
					closestDistance = distance
					closestPart = part
				end
			end

			if not closestPart then
				continue
			end

			local secureWeld = Instance.new("WeldConstraint")
			secureWeld.Name = "RagdollAccessoryWeld"
			secureWeld.Part0 = handle
			secureWeld.Part1 = closestPart
			secureWeld.Parent = handle

			handle.CanCollide = false
		end
	end
end

-- R6: Attachment'lar karakterde hazır gelmediği için, her Motor6D'nin C0/C1 CFrame'lerinden
-- kendimiz Attachment oluşturup BallSocketConstraint kuruyoruz.
local function ragdollR6(character)
	for _, jointInfo in ipairs(R6_JOINTS) do
		local part0 = character:FindFirstChild(jointInfo.part0)
		local part1 = character:FindFirstChild(jointInfo.part1)
		if not (part0 and part1) then
			continue
		end

		local motor = part1:FindFirstChild(jointInfo.motorName)
			or part0:FindFirstChild(jointInfo.motorName)

		if motor and motor:IsA("Motor6D") then
			motor.Enabled = false
		end

		local att0 = Instance.new("Attachment")
		att0.Name = "RagdollAttachment_" .. jointInfo.motorName .. "_0"
		att0.CFrame = jointInfo.c0
		att0.Parent = part0

		local att1 = Instance.new("Attachment")
		att1.Name = "RagdollAttachment_" .. jointInfo.motorName .. "_1"
		att1.CFrame = jointInfo.c1
		att1.Parent = part1

		local socket = Instance.new("BallSocketConstraint")
		socket.Name = "RagdollSocket_" .. jointInfo.motorName
		socket.Attachment0 = att0
		socket.Attachment1 = att1
		socket.LimitsEnabled = true
		socket.TwistLimitsEnabled = true
		socket.Restitution = 0
		socket.Parent = part0
	end
end

-- Karakteri ragdoll durumuna geçirir. SADECE R6 için çalışır — RigType R6 değilse
-- (yani R15 ise) hiçbir şey yapmadan false döner, çağıran taraf bunu görüp
-- klonlama/respawn akışına hiç girmez; karakter Roblox'un varsayılan ölüm
-- davranışına bırakılır.
local function ragdollCharacter(character, humanoid)
	if humanoid.RigType ~= Enum.HumanoidRigType.R6 then
		return false
	end

	humanoid.BreakJointsOnDeath = false -- Roblox'un varsayılan "parçala" davranışını engelle
	humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	humanoid.PlatformStand = true
	humanoid.RequiresNeck = false -- baş kopup gitmesin

	securizeAccessories(character)
	ragdollR6(character)

	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = true
		end
	end

	return true
end

-- Karakterin fiziksel olarak "durduğunu" (yere yığılıp sakinleştiğini) tespit eder.
local function waitUntilSettled(character, timeoutSeconds)
	local startTime = os.clock()

	while os.clock() - startTime < timeoutSeconds do
		local maxSpeed = 0

		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				local speed = part.AssemblyLinearVelocity.Magnitude
				if speed > maxSpeed then
					maxSpeed = speed
				end
			end
		end

		if maxSpeed < SETTLE_VELOCITY_THRESHOLD then
			return true
		end

		task.wait(SETTLE_CHECK_INTERVAL)
	end

	return false
end

-- Karakteri ve TÜM alt nesnelerini klonlanabilir hale getirir. Roblox'ta, bir Model'in
-- kendisi veya alt nesnelerinden HERHANGİ BİRİ Archivable = false ise, :Clone() sessizce
-- nil döner (hata fırlatmaz). Bu, "attempt to index nil with 'Name'" hatasının kök nedeniydi:
-- clone değişkeni zaten nil geliyordu, clone.Name satırı sadece bunu ortaya çıkarıyordu.
local function forceArchivable(character)
	character.Archivable = true
	for _, descendant in ipairs(character:GetDescendants()) do
		-- Archivable özelliği olmayan nesne sınıfları da var (ör. bazı Attachment'lar);
		-- pcall ile güvenli şekilde deniyoruz, olmayan bir özelliğe yazmak hataya yol açmasın.
		pcall(function()
			descendant.Archivable = true
		end)
	end
end

-- Ragdoll halindeki karakteri TEK BİR MODEL olarak klonlar, Dead klasörüne koyar,
-- sabitler ve zamanlayıcıya bağlar. Her klon benzersiz bir isim alır: Raggy_1, Raggy_2, ...
local function cloneToDeadFolder(character, player)
	if not deadFolder then
		return
	end

	-- Klonlamadan önce mutlaka çağrılmalı, yoksa Clone() nil dönebilir.
	forceArchivable(character)

	local clone = character:Clone()

	-- Clone() yine de nil dönerse (çok nadir ama teorik olarak mümkün, örneğin karakter
	-- klonlama anında Destroy edilmişse), burada güvenli şekilde çıkıyoruz; script çökmüyor,
	-- sadece bu ölüm için klon oluşturulamamış oluyor.
	if not clone then
		warn("[RagdollDeathSystem] Karakter klonlanamadı (Clone() nil döndü), Dead klasörüne kopya eklenemedi: "
			.. (player and player.Name or character.Name))
		return
	end

	deadBodyCounter += 1
	clone.Name = DEAD_BODY_BASE_NAME .. "_" .. tostring(deadBodyCounter)
	clone:SetAttribute("OriginalPlayerName", player and player.Name or character.Name)

	local toDestroy = {}

	for _, part in ipairs(clone:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
		elseif part:IsA("Constraint") or part:IsA("Motor6D") or part:IsA("Attachment") or part:IsA("Weld") then
			table.insert(toDestroy, part)
		end
	end

	for _, part in ipairs(toDestroy) do
		local stillValid = pcall(function()
			return part.Parent ~= nil
		end)
		if stillValid and part.Parent then
			part:Destroy()
		end
	end

	local cloneHumanoid = clone:FindFirstChildOfClass("Humanoid")
	if cloneHumanoid then
		cloneHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		cloneHumanoid.Health = 0
		cloneHumanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	end

	clone.Parent = deadFolder
	Debris:AddItem(clone, DEAD_BODY_LIFETIME)

	return clone
end

--// ÖLÜM İŞLEME AKIŞI //--

local function onCharacterDied(player, character, humanoid)
	if character:GetAttribute("DeathHandled") then
		return
	end
	character:SetAttribute("DeathHandled", true)

	local wasRagdolled = ragdollCharacter(character, humanoid)

	-- R6 değilse (R15), ragdoll/klonlama akışına hiç girmiyoruz.
	-- Karakter Roblox'un varsayılan ölüm davranışına bırakılır.
	if not wasRagdolled then
		return
	end

	task.spawn(function()
		waitUntilSettled(character, SETTLE_TIMEOUT)

		if not character.Parent then
			return
		end

		cloneToDeadFolder(character, player)
		character:Destroy()

		if player and player.Parent then
			player:LoadCharacter()
		end
	end)
end

local function setupHumanoidTracking(player, character)
	local humanoid = character:WaitForChild("Humanoid", 5)
	if not humanoid then
		return
	end

	character:SetAttribute("DeathHandled", false)

	humanoid.Died:Connect(function()
		onCharacterDied(player, character, humanoid)
	end)
end

--// TÜM OYUNCULARA UYGULAMA (herkes için geçerli, admin ayrımı yok; rig kontrolü ölüm anında yapılır) //--

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(character)
		setupHumanoidTracking(player, character)
	end)

	if player.Character then
		setupHumanoidTracking(player, player.Character)
	end
end)

for _, player in ipairs(Players:GetPlayers()) do
	if player.Character then
		setupHumanoidTracking(player, player.Character)
	end
	player.CharacterAdded:Connect(function(character)
		setupHumanoidTracking(player, character)
	end)
end