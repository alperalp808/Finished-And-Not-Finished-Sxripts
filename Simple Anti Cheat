--========================================================
-- FPS COUNTER
--========================================================

local Frames = 0
local LastFPS = os.clock()

RunService.RenderStepped:Connect(function()

	Frames += 1

	local now = os.clock()

	if now - LastFPS >= 1 then

		local fps =
			Frames
			/
			(now - LastFPS)

		Frames = 0
		LastFPS = now

		FPSValue.Text =
			string.format(
				"%d FPS",
				math.floor(
					fps + 0.5
				)
			)
	end
end)

--========================================================
-- LATENCY
--========================================================

task.spawn(function()

	while ScreenGui.Parent do

		task.wait(1)

		local ping

		pcall(function()

			local network =
				Stats:FindFirstChild(
					"Network"
				)

			if network then

				local serverStats =
					network:FindFirstChild(
						"ServerStatsItem"
					)

				if serverStats then

					local dataPing =
						serverStats:FindFirstChild(
							"Data Ping"
						)

					if dataPing then

						ping =
							dataPing:GetValue()

					end
				end
			end
		end)

		if ping and ping > 0 then

			PingValue.Text =
				string.format(
					"%d ms",
					math.floor(
						ping
					)
				)

		else

			PingValue.Text = "--"

		end
	end
end)

