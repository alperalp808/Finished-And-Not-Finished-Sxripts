	local function Shockwave(maxDiameter, duration, color, thickness)
		local anchor = NewPart(
			"SingularityShockwave", Enum.PartType.Block, Vector3.new(0.2, 0.2, 0.2),
			CFrame.new(position), color, Enum.Material.SmoothPlastic, 1
		)

		local gui = Instance.new("BillboardGui")
		gui.Adornee = anchor
		gui.Size = UDim2.fromScale(0.5, 0.5)
		gui.AlwaysOnTop = false
		gui.LightInfluence = 0
		gui.MaxDistance = 300
		gui.Parent = anchor

		local ring = Instance.new("Frame")
		ring.AnchorPoint = Vector2.new(0.5, 0.5)
		ring.Position = UDim2.fromScale(0.5, 0.5)
		ring.Size = UDim2.fromScale(1, 1)
		ring.BackgroundTransparency = 1
		ring.BorderSizePixel = 0
		ring.Parent = gui

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = ring

		local stroke = Instance.new("UIStroke")
		stroke.Color = color
		stroke.Thickness = thickness
		stroke.Transparency = 0.1
		stroke.Parent = ring

		local info = TweenInfo.new(
			duration,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		)

		TweenService:Create(
			gui, info,
			{Size = UDim2.fromScale(maxDiameter, maxDiameter)}
		):Play()

		TweenService:Create(
			stroke, info,
			{Transparency = 1, Thickness = 1}
		):Play()

		Debris:AddItem(anchor, duration + 0.1)
	end

	local function Flash(maxDiameter, duration)
		local flash = NewPart(
			"SingularityFlash", Enum.PartType.Ball, Vector3.new(0.5, 0.5, 0.5),
			CFrame.new(position), Color3.fromRGB(255, 235, 200), Enum.Material.Neon, 0.1
		)

		TweenService:Create(
			flash,
			TweenInfo.new(
				duration,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),
			{
				Size = Vector3.new(maxDiameter, maxDiameter, maxDiameter),
				Transparency = 1
			}
		):Play()

		Debris:AddItem(flash, duration + 0.1)
	end

	local hole = {Core = core}

	function hole.Grow(duration)
		if not model.Parent then return end

		TweenService:Create(
			horizon,
			TweenInfo.new(duration, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{
				Size = Vector3.new(
					horizonDiameter,
					horizonDiameter,
					horizonDiameter
				)
			}
		):Play()

		for _, entry in ipairs(discs) do
			TweenService:Create(
				entry.part,
				TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
				{
					Size = entry.size
				}
			):Play()
		end

		TweenService:Create(
			billboard,
			TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
			{
				Size = UDim2.fromScale(glowSize, glowSize)
			}
		):Play()

		TweenService:Create(
			light,
			TweenInfo.new(duration),
			{Brightness = 3}
		):Play()

		TweenService:Create(
			hum,
			TweenInfo.new(duration * 1.6),
			{Volume = 1.4}
		):Play()

		Flash(BLACKHOLE_DISK_RADIUS * 1.6, 0.5)
		Shockwave(
			BLACKHOLE_DISK_RADIUS * 3.2,
			0.9,
			Color3.fromRGB(255, 190, 110),
			5
		)

		task.delay(duration * 0.4, function()
			if not model.Parent then return end
			for _, trail in ipairs(trails) do
				trail.Enabled = true
			end
			for _, emitter in ipairs(emitters) do
				emitter.Enabled = true
			end
		end)
	end

	function hole.Intensify(duration)
		if not model.Parent then return end

		TweenService:Create(
			hum,
			TweenInfo.new(duration),
			{PlaybackSpeed = 1.1}
		):Play()

		TweenService:Create(
			light,
			TweenInfo.new(duration),
			{Brightness = 5}
		):Play()

		TweenService:Create(
			infall,
			TweenInfo.new(duration),
			{Rate = 170}
		):Play()
	end

	function hole.Pulse()
		if not model.Parent then return end

		TweenService:Create(
			light,
			TweenInfo.new(
				0.12,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),
			{Brightness = 9}
		):Play()

		task.delay(0.12, function()
			if light.Parent then
				TweenService:Create(
					light,
					TweenInfo.new(0.4),
					{Brightness = 4}
				):Play()
			end
		end)

		Shockwave(
			BLACKHOLE_DISK_RADIUS * 2.2,
			0.55,
			Color3.fromRGB(255, 220, 170),
			4
		)
	end

	function hole.Collapse(duration)
		if not model.Parent then return end

		for _, trail in ipairs(trails) do
			trail.Enabled = false
		end
		for _, emitter in ipairs(emitters) do
			emitter.Enabled = false
		end

		local info = TweenInfo.new(
			duration,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.In
		)

		TweenService:Create(
			horizon,
			info,
			{
				Size = Vector3.new(TINY, TINY, TINY)
			}
		):Play()

		for _, entry in ipairs(discs) do
			TweenService:Create(
				entry.part,
				info,
				{
					Size = Vector3.new(entry.size.X, TINY, TINY)
				}
			):Play()
		end

		TweenService:Create(
			billboard,
			info,
			{
				Size = UDim2.fromScale(TINY, TINY)
			}
		):Play()

		TweenService:Create(
			light,
			TweenInfo.new(duration),
			{Brightness = 0}
		):Play()

		TweenService:Create(
			hum,
			TweenInfo.new(duration),
			{Volume = 0}
		):Play()

		task.delay(duration, function()
			if not model.Parent then return end

			Flash(
				BLACKHOLE_DISK_RADIUS * 1.2,
				0.35
			)

			Shockwave(
				BLACKHOLE_DISK_RADIUS * 2.6,
				0.6,
				Color3.fromRGB(190, 140, 255),
				4
			)
		end)

		Debris:AddItem(model, duration + 1.2)
	end

	Debris:AddItem(
		model,
		BLACKHOLE_GROW_TIME + BLACKHOLE_PULL_DELAY + BLACKHOLE_PULL_DURATION + BLACKHOLE_COLLAPSE_TIME + 6
	)

	return hole
end

